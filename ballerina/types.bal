public type CreateProjectRequest record {
    # Enable GitLab Duo Secret Detection false positive detection for this project
    @jsondata:Name {value: "duo_secret_detection_fp_enabled"}
    boolean? duoSecretDetectionFpEnabled?;
    # Only allow to merge if all threads are resolved
    @jsondata:Name {value: "only_allow_merge_if_all_discussions_are_resolved"}
    boolean? onlyAllowMergeIfAllDiscussionsAreResolved?;
    # The process mode of the resource group
    @jsondata:Name {value: "resource_group_default_process_mode"}
    "unordered"|"oldest_first"|"newest_first"|"newest_ready_first"? resourceGroupDefaultProcessMode?;
    # Allow users to request member access
    @jsondata:Name {value: "request_access_enabled"}
    boolean? requestAccessEnabled?;
    # Enforce auth check on uploads
    @jsondata:Name {value: "enforce_auth_checks_on_uploads"}
    boolean? enforceAuthChecksOnUploads?;
    # Security and compliance access level. One of `disabled`, `private` or `enabled`
    @jsondata:Name {value: "security_and_compliance_access_level"}
    "disabled"|"private"|"enabled"? securityAndComplianceAccessLevel?;
    # Build timeout
    @jsondata:Name {value: "build_timeout"}
    int? buildTimeout?;
    # The description for the regex the Merge Request must adhere to
    @jsondata:Name {value: "merge_request_title_regex_description"}
    string? mergeRequestTitleRegexDescription?;
    # Infrastructure access level. One of `disabled`, `private` or `enabled`
    @jsondata:Name {value: "infrastructure_access_level"}
    "disabled"|"private"|"enabled"? infrastructureAccessLevel?;
    # Project ID of template from which to create project. Mutually exclusive with `import_url`, `template_name`
    @jsondata:Name {value: "template_project_id"}
    int? templateProjectId?;
    # The path of the repository
    string? path?;
    # [Deprecated] Pull mirroring triggers builds
    @jsondata:Name {value: "mirror_trigger_builds"}
    boolean? mirrorTriggerBuilds?;
    # Monitor access level. One of `disabled`, `private` or `enabled`
    @jsondata:Name {value: "monitor_access_level"}
    "disabled"|"private"|"enabled"? monitorAccessLevel?;
    # Repository access level. One of `disabled`, `private` or `enabled`
    @jsondata:Name {value: "repository_access_level"}
    "disabled"|"private"|"enabled"? repositoryAccessLevel?;
    # Wiki access level. One of `disabled`, `private` or `enabled`
    @jsondata:Name {value: "wiki_access_level"}
    "disabled"|"private"|"enabled"? wikiAccessLevel?;
    # Enable email notifications
    @jsondata:Name {value: "emails_enabled"}
    boolean? emailsEnabled?;
    # Flag indication if shared runners are enabled for that project
    @jsondata:Name {value: "shared_runners_enabled"}
    boolean? sharedRunnersEnabled?;
    # Feature flags access level. One of `disabled`, `private` or `enabled`
    @jsondata:Name {value: "feature_flags_access_level"}
    "disabled"|"private"|"enabled"? featureFlagsAccessLevel?;
    # Merge requests access level. One of `disabled`, `private` or `enabled`
    @jsondata:Name {value: "merge_requests_access_level"}
    "disabled"|"private"|"enabled"? mergeRequestsAccessLevel?;
    # Flag indication if group runners are enabled for that project
    @jsondata:Name {value: "group_runners_enabled"}
    boolean? groupRunnersEnabled?;
    # Allow to merge if pipeline is skipped
    @jsondata:Name {value: "allow_merge_on_skipped_pipeline"}
    boolean? allowMergeOnSkippedPipeline?;
    # Flag indication if Git LFS is enabled for that project
    @jsondata:Name {value: "lfs_enabled"}
    boolean? lfsEnabled?;
    # Enable GitLab Duo SAST vulnerability resolution workflow for this project
    @jsondata:Name {value: "duo_sast_vr_workflow_enabled"}
    boolean? duoSastVrWorkflowEnabled?;
    # The visibility of the project
    "private"|"internal"|"public"? visibility?;
    # Deprecated: Use public_jobs instead
    @jsondata:Name {value: "public_builds"}
    boolean? publicBuilds?;
    # Show default award emojis
    @jsondata:Name {value: "show_default_award_emojis"}
    boolean? showDefaultAwardEmojis?;
    # Requirements feature access level. One of `disabled`, `private` or `enabled`
    @jsondata:Name {value: "requirements_access_level"}
    "disabled"|"private"|"enabled"? requirementsAccessLevel?;
    # Builds access level. One of `disabled`, `private` or `enabled`
    @jsondata:Name {value: "builds_access_level"}
    "disabled"|"private"|"enabled"? buildsAccessLevel?;
    # Automatically resolve merge request diff threads on lines changed with a push
    @jsondata:Name {value: "resolve_outdated_diff_discussions"}
    boolean? resolveOutdatedDiffDiscussions?;
    # Flag indication if merge requests are enabled
    @jsondata:Name {value: "merge_requests_enabled"}
    boolean? mergeRequestsEnabled?;
    # Forks access level. One of `disabled`, `private` or `enabled`
    @jsondata:Name {value: "forking_access_level"}
    "disabled"|"private"|"enabled"? forkingAccessLevel?;
    # Include the code diff preview in merge request notification emails
    @jsondata:Name {value: "show_diff_preview_in_email"}
    boolean? showDiffPreviewInEmail?;
    # Controls visibility of the package registry. One of `disabled`, `private`, `enabled` or `public`. `private` will make the package registry accessible only to project members (reporter role and above). `enabled` will make the package registry accessible to everyone who has access to the project. `public` will make the package registry accessible to everyone. `disabled` will disable the package registry
    @jsondata:Name {value: "package_registry_access_level"}
    "disabled"|"private"|"enabled"|"public"? packageRegistryAccessLevel?;
    # Enable GitLab Duo SAST false positive detection for this project
    @jsondata:Name {value: "duo_sast_fp_detection_enabled"}
    boolean? duoSastFpDetectionEnabled?;
    # Template used to create merge commit message
    @jsondata:Name {value: "merge_commit_template"}
    string? mergeCommitTemplate?;
    # The commit message used to apply merge request suggestions
    @jsondata:Name {value: "suggestion_commit_message"}
    string? suggestionCommitMessage?;
    # Merge requests of this forked project targets itself by default
    @jsondata:Name {value: "mr_default_target_self"}
    boolean? mrDefaultTargetSelf?;
    # Pages access level. One of `disabled`, `private`, `enabled` or `public`
    @jsondata:Name {value: "pages_access_level"}
    "disabled"|"private"|"enabled"|"public"? pagesAccessLevel?;
    # Controls visibility of the container registry. One of `disabled`, `private` or `enabled`. `private` will make the container registry accessible only to project members (reporter role and above). `enabled` will make the container registry accessible to everyone who has access to the project. `disabled` will disable the container registry
    @jsondata:Name {value: "container_registry_access_level"}
    "disabled"|"private"|"enabled"? containerRegistryAccessLevel?;
    # Flag indication if Auto DevOps is enabled
    @jsondata:Name {value: "auto_devops_enabled"}
    boolean? autoDevopsEnabled?;
    # Enable GitLab Duo remote flows for this project
    @jsondata:Name {value: "duo_remote_flows_enabled"}
    boolean? duoRemoteFlowsEnabled?;
    # Namespace ID for the new project. Default to the user namespace
    @jsondata:Name {value: "namespace_id"}
    int? namespaceId?;
    # Disable or enable the service desk
    @jsondata:Name {value: "service_desk_enabled"}
    boolean? serviceDeskEnabled?;
    # The name of the project
    string? name?;
    # The classification label for the project
    @jsondata:Name {value: "external_authorization_classification_label"}
    string? externalAuthorizationClassificationLabel?;
    # The default branch of the project
    @jsondata:Name {value: "default_branch"}
    string? defaultBranch?;
    # Auto Deploy strategy
    @jsondata:Name {value: "auto_devops_deploy_strategy"}
    "continuous"|"manual"|"timed_incremental"? autoDevopsDeployStrategy?;
    # How many approvers should approve merge request by default
    @jsondata:Name {value: "approvals_before_merge"}
    int? approvalsBeforeMerge?;
    # Model registry access level. One of `disabled`, `private` or `enabled`
    @jsondata:Name {value: "model_registry_access_level"}
    "disabled"|"private"|"enabled"? modelRegistryAccessLevel?;
    # Enable automatic reviews by GitLab Duo on merge requests
    @jsondata:Name {value: "auto_duo_code_review_enabled"}
    boolean? autoDuoCodeReviewEnabled?;
    # Flag indication if referenced issues auto-closing is enabled
    @jsondata:Name {value: "autoclose_referenced_issues"}
    boolean? autocloseReferencedIssues?;
    # Flag indication if the issue tracker is enabled
    @jsondata:Name {value: "issues_enabled"}
    boolean? issuesEnabled?;
    # [Deprecated] Enables pull mirroring in a project
    boolean? mirror?;
    # Which storage shard the repository is on. Available only to admins
    @jsondata:Name {value: "repository_storage"}
    string? repositoryStorage?;
    # Container expiration policy attributes for the project
    @jsondata:Name {value: "container_expiration_policy_attributes"}
    CreateProjectContainerExpirationPolicyAttributes? containerExpirationPolicyAttributes?;
    # Auto-cancel pending pipelines
    @jsondata:Name {value: "auto_cancel_pending_pipelines"}
    "disabled"|"enabled"? autoCancelPendingPipelines?;
    # Require an associated issue from Jira
    @jsondata:Name {value: "prevent_merge_without_jira_issue"}
    boolean? preventMergeWithoutJiraIssue?;
    # Flag indication if snippets are enabled
    @jsondata:Name {value: "snippets_enabled"}
    boolean? snippetsEnabled?;
    # Deprecated: Use :package_registry_access_level instead. Enable project packages feature
    @jsondata:Name {value: "packages_enabled"}
    boolean? packagesEnabled?;
    # Set whether the project is a CI/CD catalog project
    @jsondata:Name {value: "cicd_catalog_enabled"}
    boolean? cicdCatalogEnabled?;
    # The description of the project
    string? description?;
    # Turn on Agentic Breaking Change Resolution for this project
    @jsondata:Name {value: "duo_dependency_bump_breaking_changes_enabled"}
    boolean? duoDependencyBumpBreakingChangesEnabled?;
    # Group ID that serves as the template source
    @jsondata:Name {value: "group_with_project_templates_id"}
    int? groupWithProjectTemplatesId?;
    # Initialize a project with a README.md
    @jsondata:Name {value: "initialize_with_readme"}
    boolean? initializeWithReadme?;
    # Model experiments access level. One of `disabled`, `private` or `enabled`
    @jsondata:Name {value: "model_experiments_access_level"}
    "disabled"|"private"|"enabled"? modelExperimentsAccessLevel?;
    # The path to CI config file. Defaults to `.gitlab-ci.yml`
    @jsondata:Name {value: "ci_config_path"}
    string? ciConfigPath?;
    # Blocks merge requests from merging unless all status checks have passed
    @jsondata:Name {value: "only_allow_merge_if_all_status_checks_passed"}
    boolean? onlyAllowMergeIfAllStatusChecksPassed?;
    # The Git strategy. Defaults to `fetch`
    @jsondata:Name {value: "build_git_strategy"}
    "fetch"|"clone"? buildGitStrategy?;
    # Deprecated: Use :topics instead
    @jsondata:Name {value: "tag_list"}
    string[]? tagList?;
    # Deprecated: Use :container_registry_access_level instead. Flag indication if the container registry is enabled for that project
    @jsondata:Name {value: "container_registry_enabled"}
    boolean? containerRegistryEnabled?;
    # The regex the Merge Request must adhere to
    @jsondata:Name {value: "merge_request_title_regex"}
    string? mergeRequestTitleRegex?;
    # Issues access level. One of `disabled`, `private` or `enabled`
    @jsondata:Name {value: "issues_access_level"}
    "disabled"|"private"|"enabled"? issuesAccessLevel?;
    # Template used to create a branch from an issue
    @jsondata:Name {value: "issue_branch_template"}
    string? issueBranchTemplate?;
    # Deprecated: Use emails_enabled instead
    @jsondata:Name {value: "emails_disabled"}
    boolean? emailsDisabled?;
    # Warn about potentially unwanted characters
    @jsondata:Name {value: "warn_about_potentially_unwanted_characters"}
    boolean? warnAboutPotentiallyUnwantedCharacters?;
    # Show link to create/view merge request when pushing from the command line
    @jsondata:Name {value: "printing_merge_request_link_enabled"}
    boolean? printingMergeRequestLinkEnabled?;
    # The list of topics for a project
    string[]? topics?;
    # Squash default for project. One of `never`, `always`, `default_on`, or `default_off`
    @jsondata:Name {value: "squash_option"}
    "never"|"always"|"default_on"|"default_off"? squashOption?;
    # URL from which the project is imported. Mutually exclusive with `template_name`, `template_project_id`
    @jsondata:Name {value: "import_url"}
    string? importUrl?;
    # Releases access level. One of `disabled`, `private` or `enabled`
    @jsondata:Name {value: "releases_access_level"}
    "disabled"|"private"|"enabled"? releasesAccessLevel?;
    # Flag indication if jobs are enabled
    @jsondata:Name {value: "jobs_enabled"}
    boolean? jobsEnabled?;
    # Snippets access level. One of `disabled`, `private` or `enabled`
    @jsondata:Name {value: "snippets_access_level"}
    "disabled"|"private"|"enabled"? snippetsAccessLevel?;
    # Avatar image for project
    record {byte[] fileContent; string fileName;}? avatar?;
    # Environments access level. One of `disabled`, `private` or `enabled`
    @jsondata:Name {value: "environments_access_level"}
    "disabled"|"private"|"enabled"? environmentsAccessLevel?;
    # Template used to create squash commit message
    @jsondata:Name {value: "squash_commit_template"}
    string? squashCommitTemplate?;
    # Only allow to merge if builds succeed
    @jsondata:Name {value: "only_allow_merge_if_pipeline_succeeds"}
    boolean? onlyAllowMergeIfPipelineSucceeds?;
    # Analytics access level. One of `disabled`, `private` or `enabled`
    @jsondata:Name {value: "analytics_access_level"}
    "disabled"|"private"|"enabled"? analyticsAccessLevel?;
    # The merge method used when merging merge requests
    @jsondata:Name {value: "merge_method"}
    "ff"|"rebase_merge"|"merge"? mergeMethod?;
    # Template used to generate the default merge request title. Maximum 100 characters
    @jsondata:Name {value: "mr_default_title_template"}
    string? mrDefaultTitleTemplate?;
    # The object format of the project repository
    @jsondata:Name {value: "repository_object_format"}
    "sha1"|"sha256"? repositoryObjectFormat?;
    # Grant read-only access to security policy configurations for enforcement in linked CI/CD projects
    @jsondata:Name {value: "spp_repository_pipeline_access"}
    boolean? sppRepositoryPipelineAccess?;
    # Name of template from which to create project. Mutually exclusive with `import_url`, `template_project_id`
    @jsondata:Name {value: "template_name"}
    string? templateName?;
    # Flag indication if the wiki is enabled
    @jsondata:Name {value: "wiki_enabled"}
    boolean? wikiEnabled?;
    # Perform public builds
    @jsondata:Name {value: "public_jobs"}
    boolean? publicJobs?;
    # Remove the source branch by default after merge
    @jsondata:Name {value: "remove_source_branch_after_merge"}
    boolean? removeSourceBranchAfterMerge?;
    # Use custom template
    @jsondata:Name {value: "use_custom_template"}
    boolean? useCustomTemplate?;
};

# Represents a deployments approval summary
public type DeploymentsApprovalSummary record {
    # List of rules
    ProtectedEnvironmentsApprovalRuleForSummary[] rules?;
};

# Represents the Queries record for the operation: listOfflineTransferExports
public type ListOfflineTransferExportsQueries record {
    # Number of items per page
    @http:Query {name: "per_page"}
    int perPage = 20;
    # Current page number
    int page = 1;
    # Return offline transfer exports sorted in created by `asc` or `desc` order
    "asc"|"desc" sort = "desc";
    # Return offline transfer exports with specified status
    "created"|"started"|"finished"|"failed"? status?;
};

# Represents the Queries record for the operation: downloadRepositorySnapshot
public type DownloadRepositorySnapshotQueries record {
    # Set to true to receive the wiki repository
    boolean? wiki?;
};

# Represents a related issue
public type RelatedIssue record {
    # Discussion locked flag of the related issue
    @jsondata:Name {value: "discussion_locked"}
    boolean discussionLocked?;
    # Upvotes of the related issue
    int upvotes?;
    # Represents issuable references
    IssuableReferences references?;
    # Internal ID of the related issue, unique within its project or group
    int iid?;
    # Number of merge requests
    @jsondata:Name {value: "merge_requests_count"}
    int mergeRequestsCount?;
    # Links of the related issue
    @jsondata:Name {value: "_links"}
    EpicIssueLinks links?;
    # Description of the related issue
    string description?;
    # Time the related issue was created
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    # List of assignees
    UserBasic[] assignees?;
    # Time the link was updated
    @jsondata:Name {value: "link_updated_at"}
    string linkUpdatedAt?;
    # Title of the related issue
    string title?;
    # The type of the issue
    "ISSUE"|"INCIDENT"|"TEST_CASE"|"REQUIREMENT"|"TASK"|"TICKET" 'type?;
    # Closed by of the related issue
    @jsondata:Name {value: "closed_by"}
    UserBasic closedBy?;
    # Whether the related issue has tasks
    @jsondata:Name {value: "has_tasks"}
    boolean hasTasks?;
    # Whether the related issue is subscribed
    boolean subscribed?;
    # Service desk reply to of the related issue
    @jsondata:Name {value: "service_desk_reply_to"}
    string serviceDeskReplyTo?;
    # Time the related issue was last updated
    @jsondata:Name {value: "updated_at"}
    string updatedAt?;
    # ID of the project
    @jsondata:Name {value: "project_id"}
    int projectId?;
    # Whether the related issue is imported
    boolean imported?;
    # Epic IID of the related issue
    @jsondata:Name {value: "epic_iid"}
    string epicIid?;
    # Time stats of the related issue
    @jsondata:Name {value: "time_stats"}
    IssuableTimeStats timeStats?;
    # Time the link was created
    @jsondata:Name {value: "link_created_at"}
    string linkCreatedAt?;
    # Represents an iteration
    Iteration iteration?;
    # ID of the related issue
    int id?;
    # State of the related issue
    string state?;
    # Health status of the related issue
    @jsondata:Name {value: "health_status"}
    string healthStatus?;
    # Start date of the related issue
    @jsondata:Name {value: "start_date"}
    string startDate?;
    # Confidential flag of the related issue
    boolean confidential?;
    # The severity of the issue
    "UNKNOWN"|"LOW"|"MEDIUM"|"HIGH"|"CRITICAL" severity?;
    # Task status of the related issue
    @jsondata:Name {value: "task_status"}
    string taskStatus?;
    # Time the related issue was closed
    @jsondata:Name {value: "closed_at"}
    string closedAt?;
    # Represents an user basic
    UserBasic author?;
    # Due date of the related issue
    @jsondata:Name {value: "due_date"}
    string dueDate?;
    # Issue type of the related issue
    @jsondata:Name {value: "issue_type"}
    string issueType?;
    # Imported from of the related issue
    @jsondata:Name {value: "imported_from"}
    string importedFrom?;
    # Weight of the related issue
    int weight?;
    # Represents an epic base
    EpicBase epic?;
    # Downvotes of the related issue
    int downvotes?;
    # Number of blocking issues
    @jsondata:Name {value: "blocking_issues_count"}
    int blockingIssuesCount?;
    # List of labels
    string[] labels?;
    # ID of the moved to
    @jsondata:Name {value: "moved_to_id"}
    int movedToId?;
    # ID of the issue link
    @jsondata:Name {value: "issue_link_id"}
    int issueLinkId?;
    # Link type of the related issue
    @jsondata:Name {value: "link_type"}
    string linkType?;
    # Represents a milestone
    Milestone milestone?;
    # URL of the related issue in the GitLab web interface
    @jsondata:Name {value: "web_url"}
    string webUrl?;
    # Number of user notes
    @jsondata:Name {value: "user_notes_count"}
    int userNotesCount?;
    # Represents an user basic
    UserBasic assignee?;
    # Task completion status of the related issue
    @jsondata:Name {value: "task_completion_status"}
    TaskCompletionStatus taskCompletionStatus?;
};

# Request payload for the CI pipeline merge
public type CiPipelineMergeRequest record {
    # URL of the CI pipeline merge in the GitLab web interface
    @jsondata:Name {value: "web_url"}
    string webUrl?;
    # Internal ID of the CI pipeline merge, unique within its project or group
    int iid?;
    # Title of the CI pipeline merge
    string title?;
};

# Request payload for the job token allowlist project
public type AddJobTokenAllowlistProjectRequest record {
    # ID of target project
    @jsondata:Name {value: "target_project_id"}
    int? targetProjectId;
};

# Represents a CI catalog resources version
public type CiCatalogResourcesVersion record {
    # Catalog URL for the CI catalog resources version
    @jsondata:Name {value: "catalog_url"}
    string catalogUrl?;
};

# Represents the Queries record for the operation: getOrgLifecycleState
public type GetOrgLifecycleStateQueries record {
    # The ID of the organization
    @http:Query {name: "organization_id"}
    int? organizationId;
};

# Request payload for the merge request approval rule
public type CreateMergeRequestApprovalRuleRequest record {
    # The number of required approvals for this rule
    @jsondata:Name {value: "approvals_required"}
    int? approvalsRequired;
    # The user ids for this rule
    @jsondata:Name {value: "user_ids"}
    int[]? userIds?;
    # The name of the approval rule
    string? name;
    # The group ids for this rule
    @jsondata:Name {value: "group_ids"}
    int[]? groupIds?;
    # The usernames for this rule
    string[]? usernames?;
    # The ID of a project-level approval rule
    @jsondata:Name {value: "approval_project_rule_id"}
    int? approvalProjectRuleId?;
};

# Represents the Queries record for the operation: listIssueLabelEvents
public type ListIssueLabelEventsQueries record {
    # Number of items per page
    @http:Query {name: "per_page"}
    int perPage = 20;
    # Current page number
    int page = 1;
};

# Request payload for the feature flag
public type CreateFeatureFlagRequest record {
    # Array of feature flag strategies
    CreateFeatureFlagStrategies[]? strategies?;
    # The name of the feature flag
    string? name;
    # The description of the feature flag
    string? description?;
    # The active state of the flag. Supported in GitLab 13.3 and later
    boolean active = true;
};

# Request payload for the Jira integration
public type JiraIntegrationRequest record {
    # Enable viewing Jira issues in GitLab
    @jsondata:Name {value: "issues_enabled"}
    string? issuesEnabled?;
    # Indicates whether to inherit the default settings. Defaults to `false`
    @jsondata:Name {value: "use_inherited_settings"}
    boolean? useInheritedSettings?;
    # Regular expression to match Jira issue keys
    @jsondata:Name {value: "jira_issue_regex"}
    string? jiraIssueRegex?;
    # The base URL to the Jira instance API. Web URL value is used if not set (for example, `https://jira-api.example.com`)
    @jsondata:Name {value: "api_url"}
    string? apiUrl?;
    # Comma-separated list of allowed Jira issue statuses
    @jsondata:Name {value: "jira_allowed_statuses_as_string"}
    string? jiraAllowedStatusesAsString?;
    # Keys of Jira projects to display. When `issues_enabled` is `true`, this setting filters which Jira projects are shown in GitLab. It does not restrict the API token's access
    @jsondata:Name {value: "project_keys"}
    string[]? projectKeys?;
    # Key of the project to use when creating issues from vulnerabilities.This parameter is required if using the integration to create Jira issues from vulnerabilities
    @jsondata:Name {value: "project_key"}
    string? projectKey?;
    # The ID of one or more transitions for [custom issue transitions](../integration/jira/issues.md#custom-issue-transitions).Ignored when `jira_issue_transition_automatic` is enabled. Defaults to a blank string,which disables custom transitions
    @jsondata:Name {value: "jira_issue_transition_id"}
    string? jiraIssueTransitionId?;
    # Verify the status of Jira issues referenced in commit messages
    @jsondata:Name {value: "jira_status_check_enabled"}
    boolean? jiraStatusCheckEnabled?;
    # Prefix to match Jira issue keys
    @jsondata:Name {value: "jira_issue_prefix"}
    string? jiraIssuePrefix?;
    # Trigger event when a commit is created or updated
    @jsondata:Name {value: "commit_events"}
    boolean? commitEvents?;
    # Trigger event when a merge request is created, updated, or merged
    @jsondata:Name {value: "merge_requests_events"}
    boolean? mergeRequestsEvents?;
    # The authentication method to use with Jira. Use `0` for basic authentication, `1` for Jira personal access token, and `2` for Jira Cloud service accounts. Defaults to `0`
    @jsondata:Name {value: "jira_auth_type"}
    int? jiraAuthType?;
    # Jira issue type to use when creating issues from vulnerabilities
    @jsondata:Name {value: "vulnerabilities_issuetype"}
    string? vulnerabilitiesIssuetype?;
    # The URL to the Jira project which is being linked to this GitLab project (for example, `https://jira.example.com`)
    string? url;
    # Enable comments inside Jira issues on each GitLab event (commit / merge request)
    @jsondata:Name {value: "comment_on_event_enabled"}
    boolean? commentOnEventEnabled?;
    # The Jira API token, password, or personal access token to use with Jira. When using Basic Authentication (`jira_auth_type` is `0`), use an API token for Jira Cloud, and a password for Jira Data Center or Jira Server. For a Jira personal access token (`jira_auth_type` is `1`), use the personal access token
    string? password;
    # Verify Jira issues referenced in commit messages exist before allowing the push
    @jsondata:Name {value: "jira_check_enabled"}
    boolean? jiraCheckEnabled?;
    # Verify the committer is the assignee of the Jira issues referenced in commit messages
    @jsondata:Name {value: "jira_assignee_check_enabled"}
