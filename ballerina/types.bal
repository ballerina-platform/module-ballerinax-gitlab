# Request payload for the repository branch
public type CreateRepositoryBranchRequest record {
    # Create branch from commit sha or existing branch
    string? ref;
    # The name of the branch
    string? branch;
};

# Represents the Queries record for the operation: listLdapGroups
public type ListLdapGroupsQueries record {
    # Search for a specific LDAP group
    string search = "";
};

# Request payload for the Terraform state protection rule
public type CreateTerraformStateProtectionRuleRequest record {
    # Minimum GitLab access level required to write to the Terraform state. Valid values: developer, maintainer, owner, admin
    @jsondata:Name {value: "minimum_access_level_for_write"}
    "developer"|"maintainer"|"owner"|"admin" minimumAccessLevelForWrite;
    # Source restriction for write requests. Valid values: anywhere, ci_only, ci_on_protected_branch_only
    @jsondata:Name {value: "allowed_from"}
    "anywhere"|"ci_only"|"ci_on_protected_branch_only" allowedFrom = "anywhere";
    # Terraform state name to protect. Maximum 255 characters. Must be unique per project
    @jsondata:Name {value: "state_name"}
    string? stateName;
};

# Represents a vulnerability archive export
public type VulnerabilityArchiveExport record {
    # Time the vulnerability archive export was finished
    @jsondata:Name {value: "finished_at"}
    string finishedAt?;
    # ID of the project
    @jsondata:Name {value: "project_id"}
    int projectId?;
    # Links of the vulnerability archive export
    @jsondata:Name {value: "_links"}
    VulnerabilityExportLinks links?;
    # Format of the vulnerability archive export
    string format?;
    # Time the vulnerability archive export was created
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    # Time the vulnerability archive export was started
    @jsondata:Name {value: "started_at"}
    string startedAt?;
    # ID of the vulnerability archive export
    int id?;
    # Status of the vulnerability archive export
    string status?;
};

# Represents the Queries record for the operation: listPagesDomains
public type ListPagesDomainsQueries record {
    # Number of items per page
    @http:Query {name: "per_page"}
    int perPage = 20;
    # The domain of the GitLab Pages site to filter on
    string? domain?;
    # Current page number
    int page = 1;
};

# Request payload for the namespace subscription
public type UpdateNamespaceSubscriptionRequest record {
    # End date of subscription
    @jsondata:Name {value: "end_date"}
    string? endDate?;
    # Highest number of active users in the last month
    @jsondata:Name {value: "max_seats_used"}
    int? maxSeatsUsed?;
    # Whether subscription will auto renew on end date
    @jsondata:Name {value: "auto_renew"}
    boolean? autoRenew?;
    # End date of trial
    @jsondata:Name {value: "trial_ends_on"}
    string? trialEndsOn?;
    # Whether the trial was extended or reactivated
    @jsondata:Name {value: "trial_extension_type"}
    int? trialExtensionType?;
    # Subscription tier code
    @jsondata:Name {value: "plan_code"}
    string? planCode?;
    # Start date of trial
    @jsondata:Name {value: "trial_starts_on"}
    string? trialStartsOn?;
    # Number of seats in subscription
    int? seats?;
    # Whether the subscription is a trial
    boolean? trial?;
    # Start date of subscription
    @jsondata:Name {value: "start_date"}
    string? startDate?;
};

