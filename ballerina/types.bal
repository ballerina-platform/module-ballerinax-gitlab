# Request payload for the pull mirror
public type UpdateProjectPullMirrorRequest record {
    # Pull mirroring triggers builds
    @jsondata:Name {value: "mirror_trigger_builds"}
    boolean? mirrorTriggerBuilds?;
    # The username used for authentication of a project to pull mirror
    @jsondata:Name {value: "auth_user"}
    string? authUser?;
    # Only mirror protected branches. Mutually exclusive with `mirror_branch_regex`
    @jsondata:Name {value: "only_mirror_protected_branches"}
    boolean? onlyMirrorProtectedBranches?;
    # Pull mirror overwrites diverged branches
    @jsondata:Name {value: "mirror_overwrites_diverged_branches"}
    boolean? mirrorOverwritesDivergedBranches?;
    # The password used for authentication of a project to pull mirror or a personal access token with the api scope enabled
    @jsondata:Name {value: "auth_password"}
    string? authPassword?;
    # Enables pull mirroring in a project
    boolean? enabled?;
    # URL of the project to pull mirror
