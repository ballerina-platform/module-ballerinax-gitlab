# Represents the Queries record for the operation: listGroups
public type ListGroupsQueries record {
    # Number of items per page
    @http:Query {name: "per_page"}
    int perPage = 20;
    # Limit by visibility
    "private"|"internal"|"public"? visibility?;
    # Array of group ids to exclude from list
    @http:Query {name: "skip_groups"}
    int[]? skipGroups?;
    # Filter by repository storage used by the group
    @http:Query {name: "repository_storage"}
    string? repositoryStorage?;
    # Minimum access level of authenticated user
    @http:Query {name: "min_access_level"}
    10|15|20|25|30|40|50? minAccessLevel?;
    # Limit by groups that are not archived and not marked for deletion
    boolean? active?;
    # Only include top-level groups
    @http:Query {name: "top_level_only"}
    boolean? topLevelOnly?;
    # Sort by asc (ascending) or desc (descending)
    "asc"|"desc" sort = "asc";
    # Include custom attributes in the response
    @http:Query {name: "with_custom_attributes"}
    boolean withCustomAttributes = false;
    # Return groups that are marked for deletion on this date
    @http:Query {name: "marked_for_deletion_on"}
    string? markedForDeletionOn?;
    # Filter with custom attributes
    @http:Query {name: "custom_attributes"}
    record {}? customAttributes?;
    # Limit by archived status
    boolean? archived?;
    # Search for a specific group
    string? search?;
    # Limit by owned by authenticated user
    boolean owned = false;
    # Order by name, path, id or similarity if searching
    @http:Query {name: "order_by"}
    "name"|"path"|"id"|"similarity" orderBy = "name";
    # Current page number
    int page = 1;
    # When `true`, returns all accessible groups. When `false`, returns only groups where the user is a member
    @http:Query {name: "all_available"}
    boolean? allAvailable?;
    # Include project statistics
    boolean statistics = false;
};

