# Represents the Queries record for the operation: listUserProjects
public type ListUserProjectsQueries record {
    # Limit by projects where repository checksum is failed
    @http:Query {name: "repository_checksum_failed"}
    boolean repositoryChecksumFailed = false;
    # Limit by enabled merge requests feature
    @http:Query {name: "with_merge_requests_enabled"}
    boolean withMergeRequestsEnabled = false;
    # Which storage shard the repository is on. Available only to admins
    @http:Query {name: "repository_storage"}
    string? repositoryStorage?;
    # Limit results to projects with last_activity before specified time. Format: ISO 8601 YYYY-MM-DDTHH:MM:SSZ
    @http:Query {name: "last_activity_before"}
    string? lastActivityBefore?;
    # Limit by minimum access level of authenticated user
    @http:Query {name: "min_access_level"}
    10|15|20|25|30|40|50? minAccessLevel?;
    # Return only the ID, URL, name, and path of each project
    boolean simple = false;
    # Limit by projects that the current user is a member of
    boolean membership = false;
    # Date when the project was marked for deletion
    @http:Query {name: "marked_for_deletion_on"}
    string? markedForDeletionOn?;
    # Filter with custom attributes
    @http:Query {name: "custom_attributes"}
    record {}? customAttributes?;
    # Limit by archived status
    boolean? archived?;
    # Include ancestor namespaces when matching search criteria
    @http:Query {name: "search_namespaces"}
    boolean? searchNamespaces?;
    # Return list of projects matching the search criteria
    string? search?;
    # Limit results to projects with IDs less than the specified ID
    @http:Query {name: "id_before"}
    int? idBefore?;
    # Limit results to projects with last_activity after specified time. Format: ISO 8601 YYYY-MM-DDTHH:MM:SSZ
    @http:Query {name: "last_activity_after"}
    string? lastActivityAfter?;
    # Limit by starred status
    boolean starred = false;
    # Limit by projects where wiki checksum is failed
    @http:Query {name: "wiki_checksum_failed"}
    boolean wikiChecksumFailed = false;
    # Limit results to projects with IDs greater than the specified ID
    @http:Query {name: "id_after"}
    int? idAfter?;
    # Include hidden projects. Can only be set by admins
    @http:Query {name: "include_hidden"}
    boolean includeHidden = false;
    # Limit by imported by authenticated user
    boolean imported = false;
    # Limit results to projects with the assigned topic given by the topic ID
    @http:Query {name: "topic_id"}
    int? topicId?;
    # Return projects updated before the specified datetime. Format: ISO 8601 YYYY-MM-DDTHH:MM:SSZ
    @http:Query {name: "updated_before"}
    string? updatedBefore?;
    # Number of items per page
    @http:Query {name: "per_page"}
    int perPage = 20;
    # Limit by visibility
    "private"|"internal"|"public"? visibility?;
    # Limit by projects that are not archived and not marked for deletion
    boolean? active?;
    # Return projects sorted in ascending and descending order
    "asc"|"desc" sort = "desc";
    # Include custom attributes in the response
    @http:Query {name: "with_custom_attributes"}
    boolean withCustomAttributes = false;
    # Include projects in pending delete state. Can only be set by admins
    @http:Query {name: "include_pending_delete"}
    boolean? includePendingDelete?;
    # Limit to repositories which use the given programming language
    @http:Query {name: "with_programming_language"}
    string? withProgrammingLanguage?;
    # Limit by owned by authenticated user
    boolean owned = false;
    # Return projects updated after the specified datetime. Format: ISO 8601 YYYY-MM-DDTHH:MM:SSZ
    @http:Query {name: "updated_after"}
    string? updatedAfter?;
    # Limit by enabled issues feature
    @http:Query {name: "with_issues_enabled"}
    boolean withIssuesEnabled = false;
    # Return projects ordered by field. storage_size, repository_size, wiki_size, packages_size are only available to admins. Similarity is available when searching and is limited to projects the user has access to
    @http:Query {name: "order_by"}
    "id"|"name"|"path"|"created_at"|"updated_at"|"last_activity_at"|"similarity"|"star_count"|"storage_size"|"repository_size"|"wiki_size"|"packages_size" orderBy = "created_at";
    # Comma-separated list of topics. Limit results to projects having all topics
    string[]? topic?;
    # Current page number
    int page = 1;
    # Include project statistics
    boolean statistics = false;
};

