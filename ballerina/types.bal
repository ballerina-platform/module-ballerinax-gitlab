# Represents the Queries record for the operation: listUsers
public type ListUsersQueries record {
    # Filters only non external users
    @http:Query {name: "exclude_external"}
    boolean excludeExternal = false;
    # Return users created after the specified time
    @http:Query {name: "created_after"}
    string? createdAfter?;
    # Filter with custom attributes
    @http:Query {name: "custom_attributes"}
    record {}? customAttributes?;
    # Search for a username
    string? search?;
    # Filters only blocked users
    boolean blocked = false;
    # The external provider
    string? provider?;
    # Filters only non internal users
    @http:Query {name: "exclude_internal"}
    boolean excludeInternal = false;
    # Filters only non active users
    @http:Query {name: "exclude_active"}
    boolean excludeActive = false;
    # Filters only auditor users
    boolean auditors = false;
    # Filters users without project bots
    @http:Query {name: "without_project_bots"}
    boolean withoutProjectBots = false;
    # Get a single user with a specific external authentication provider UID
    @http:Query {name: "extern_uid"}
    string? externUid?;
    # Filter users by Two-factor authentication
    @http:Query {name: "two_factor"}
    string? twoFactor?;
    # Number of items per page
    @http:Query {name: "per_page"}
    int perPage = 20;
    # Filters only non human users
    @http:Query {name: "exclude_humans"}
    boolean excludeHumans = false;
    # Filters only active users
    boolean active = false;
    # Filters only users without projects
    @http:Query {name: "without_projects"}
    boolean withoutProjects = false;
    # Return users sorted in ascending and descending order
    "asc"|"desc"? sort?;
    # Include custom attributes in the response
    @http:Query {name: "with_custom_attributes"}
    boolean withCustomAttributes = false;
    # Skip LDAP users
    @http:Query {name: "skip_ldap"}
    boolean skipLdap = false;
    # Filters only external users
    boolean 'external = false;
    # Return users created before the specified time
    @http:Query {name: "created_before"}
    string? createdBefore?;
    # Return users ordered by a field
    @http:Query {name: "order_by"}
    "id"|"name"|"username"|"created_at"|"updated_at"? orderBy?;
    # Get a single user with a specific public email
    @http:Query {name: "public_email"}
    string? publicEmail?;
    # Current page number
    int page = 1;
    # Filters only human users
    boolean humans = false;
    # Filters only admin users
    boolean admins = false;
    # Get a single user with a specific username
    string? username?;
};

