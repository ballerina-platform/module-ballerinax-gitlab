# Request payload for the environment
public type UpdateEnvironmentRequest record {
    # The auto stop setting for the environment. Allowed values are `always` and `with_action`
    @jsondata:Name {value: "auto_stop_setting"}
    "always"|"with_action"? autoStopSetting?;
    # The Kubernetes namespace to associate with this environment
    @jsondata:Name {value: "kubernetes_namespace"}
    string? kubernetesNamespace?;
    # The new URL on which this deployment is viewable
    @jsondata:Name {value: "external_url"}
    string? externalUrl?;
    # The tier of the new environment. Allowed values are `production`, `staging`, `testing`, `development`, and `other`
    "production"|"staging"|"testing"|"development"|"other"? tier?;
    # The description of the environment
    string? description?;
    # The ID of the Cluster Agent to associate with this environment
    @jsondata:Name {value: "cluster_agent_id"}
    int? clusterAgentId?;
    # The Flux resource path to associate with this environment
    @jsondata:Name {value: "flux_resource_path"}
    string? fluxResourcePath?;
};

# Request payload for the merge request
public type MergeMergeRequestRequest record {
    # Custom squash commit message
    @jsondata:Name {value: "squash_commit_message"}
    string? squashCommitMessage?;
    # If `true`, the commits are squashed into a single commit on merge
    boolean? squash?;
    # Deprecated: Use auto_merge instead
    @jsondata:Name {value: "merge_when_pipeline_succeeds"}
    boolean? mergeWhenPipelineSucceeds?;
    # If `true` skips train restart when merging immediately in a merge train configured project
    @jsondata:Name {value: "skip_merge_train"}
    boolean? skipMergeTrain?;
    # If `true`, the merge request is set to auto merge
    @jsondata:Name {value: "auto_merge"}
    boolean? autoMerge?;
    # Custom merge commit message
    @jsondata:Name {value: "merge_commit_message"}
    string? mergeCommitMessage?;
    # If `true`, removes the source branch
    @jsondata:Name {value: "should_remove_source_branch"}
    boolean? shouldRemoveSourceBranch?;
    # If present, then this SHA must match the HEAD of the source branch, otherwise the merge fails
    string? sha?;
};

# Request payload for the rollout workflow event
public type IngestRolloutWorkflowEventRequest record {
    # The event payload
    IngestRolloutWorkflowEventData? data?;
    # AutoFlow channels opened alongside this event, for posting a value back into them later
    @jsondata:Name {value: "channel_tokens"}
    IngestRolloutWorkflowEventChannelTokens[]? channelTokens?;
    # The event topic
    string? topic?;
    # The event type
    string? 'type?;
    # AutoFlow Value (protojson), decoded into the same topic/type/data shape as `data` above
    record {}? value?;
};

