# Represents the Queries record for the operation: listProjectAccessTokens
public type ListProjectAccessTokensQueries record {
    # Filters tokens by name
    string? search?;
    # Filter tokens which were created before given datetime
    @http:Query {name: "created_before"}
    string? createdBefore?;
    # Filter tokens which were created after given datetime
    @http:Query {name: "created_after"}
    string? createdAfter?;
    # Filter tokens which were used before given datetime
    @http:Query {name: "last_used_before"}
    string? lastUsedBefore?;
    # Filter tokens which expire after given datetime
    @http:Query {name: "expires_after"}
    string? expiresAfter?;
    # Filter tokens which were used after given datetime
    @http:Query {name: "last_used_after"}
    string? lastUsedAfter?;
    # Filter tokens which are either active or not
    "active"|"inactive"? state?;
    # Sort tokens
    string? sort?;
    # Filter tokens where revoked state matches parameter
    boolean? revoked?;
    # Filter tokens which expire before given datetime
    @http:Query {name: "expires_before"}
    string? expiresBefore?;
};

