    # List of host keys
    @jsondata:Name {value: "host_keys"}
    MirrorHostKey[] hostKeys?;
    # Update status of the remote mirror
    @jsondata:Name {value: "update_status"}
    string updateStatus?;
    # Auth method of the remote mirror
    @jsondata:Name {value: "auth_method"}
    string authMethod?;
    # Time for last update (the remote mirror)
    @jsondata:Name {value: "last_update_at"}
