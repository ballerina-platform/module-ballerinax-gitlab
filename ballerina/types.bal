# Request payload for the relation
public type ImportProjectRelationRequest record {
    # Path to locally stored body (generated by Workhorse)
    @jsondata:Name {value: "file.path"}
    string? filePath?;
    # Remote_url of the file (generated by Workhorse)
    @jsondata:Name {value: "file.remote_url"}
    string? fileRemoteUrl?;
    # Real filename as sent in Content-Disposition (generated by Workhorse)
    @jsondata:Name {value: "file.name"}
    string? fileName?;
    # Real size of file (generated by Workhorse)
    @jsondata:Name {value: "file.size"}
    int? fileSize?;
    # The relation to import
    "issues"|"merge_requests"|"milestones"|"ci_pipelines" relation;
    # SHA1 checksum of the file (generated by Workhorse)
    @jsondata:Name {value: "file.sha1"}
    string? fileSha1?;
    # SHA256 checksum of the file (generated by Workhorse)
    @jsondata:Name {value: "file.sha256"}
    string? fileSha256?;
    # Remote_id of the file (generated by Workhorse)
    @jsondata:Name {value: "file.remote_id"}
    string? fileRemoteId?;
    # The project path and name
    string? path;
    # The project export file from which to extract the relation
    record {byte[] fileContent; string fileName;}? file;
    # Real content type as send in Content-Type (generated by Workhorse)
    @jsondata:Name {value: "file.type"}
    string? fileType?;
    # Etag of the file (generated by Workhorse)
    @jsondata:Name {value: "file.etag"}
    string? fileEtag?;
    # MD5 checksum of the file (generated by Workhorse)
    @jsondata:Name {value: "file.md5"}
    string? fileMd5?;
};

