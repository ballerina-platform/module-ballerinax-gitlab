# An object that contains report components mapped to frontend data assets.
# 
# Some report formats support embedding UI components from the
# UI. For example, users can apply certain filters in the web UI, and
# export the component to a PDF. The SVG is provided from
# the frontend in the report data field.
# 
# Unsupported keys are discarded. If the data
# does not fit the component it is keyed to, the
# component is ignored and an error is logged
public type VulnerabilityExportReportData record {
    # Data for rendering the open vulnerabilities over time in PDF reports
    @jsondata:Name {value: "open_vulnerabilities_over_time"}
    record {}? openVulnerabilitiesOverTime?;
    # The type of vulnerability grouping this report is being created for
    @jsondata:Name {value: "dashboard_type"}
    ":project"|":group"|":instance"? dashboardType?;
    # This object should include an SVG asset to be rendered in PDF reports
    @jsondata:Name {value: "project_vulnerabilities_history"}
    record {}? projectVulnerabilitiesHistory?;
    # Data for rendering the total risk score in PDF reports
    @jsondata:Name {value: "total_risk_score"}
    record {}? totalRiskScore?;
    # This object should include an SVG asset to be rendered in PDF reports
    @jsondata:Name {value: "group_vulnerabilities_over_time"}
    record {}? groupVulnerabilitiesOverTime?;
    # Number of vulnerabilities by severity
    @jsondata:Name {value: "vulnerabilities_by_severity_count"}
    VulnerabilitySeverityCount? vulnerabilitiesBySeverityCount?;
    # The full path of the vulnerable
    @jsondata:Name {value: "full_path"}
    string? fullPath?;
    # Data for rendering the vulnerabilities by age in PDF reports
    @jsondata:Name {value: "vulnerabilities_by_age"}
    record {}? vulnerabilitiesByAge?;
    # Data for rendering the project grades summary in PDF reports
    @jsondata:Name {value: "project_security_status"}
    record {}? projectSecurityStatus?;
};

