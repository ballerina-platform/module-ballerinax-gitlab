# Request payload for the mattermost integration
public type MattermostIntegrationRequest record {
    # Indicates whether to inherit the default settings. Defaults to `false`
    @jsondata:Name {value: "use_inherited_settings"}
    boolean? useInheritedSettings?;
    # Mattermost notifications webhook (for example, `http://mattermost.example.com/hooks/...`)
    string? webhook;
    # The name of the channel to receive alert_events notifications
    @jsondata:Name {value: "alert_channel"}
    string? alertChannel?;
    # The name of the channel to receive vulnerability_events notifications
    @jsondata:Name {value: "vulnerability_channel"}
    string? vulnerabilityChannel?;
    # Work item events flag of the mattermost integration
    @jsondata:Name {value: "work_item_events"}
    boolean? workItemEvents?;
    # Default channel to use if no other channel is configured
    string? channel?;
    # Trigger event when a work item is created, updated, or closed
    @jsondata:Name {value: "issues_events"}
    boolean? issuesEvents?;
    # The name of the channel to receive deployment_events notifications
    @jsondata:Name {value: "deployment_channel"}
    string? deploymentChannel?;
    # Labels to be notified for. Valid options are `match_any` and `match_all`. The default value is `match_any`
    @jsondata:Name {value: "labels_to_be_notified_behavior"}
    string? labelsToBeNotifiedBehavior?;
    # The name of the channel to receive merge_requests_events notifications
    @jsondata:Name {value: "merge_request_channel"}
    string? mergeRequestChannel?;
    # Trigger event for pushes to the repository
    @jsondata:Name {value: "push_events"}
    boolean? pushEvents?;
    # Trigger event for new tags pushed to the repository
    @jsondata:Name {value: "tag_push_events"}
    boolean? tagPushEvents?;
    # Branches to send notifications for. Valid options are `all`, `default`, `protected`, and `default_and_protected`. The default value is `default`
    @jsondata:Name {value: "branches_to_be_notified"}
    string? branchesToBeNotified?;
    # The name of the channel to receive pipeline_events notifications
    @jsondata:Name {value: "pipeline_channel"}
    string? pipelineChannel?;
    # Send notifications only when the pipeline status changes
    @jsondata:Name {value: "notify_only_when_pipeline_status_changes"}
    boolean? notifyOnlyWhenPipelineStatusChanges?;
    # The name of the channel to receive note_events notifications
    @jsondata:Name {value: "note_channel"}
    string? noteChannel?;
    # The name of the channel to receive confidential_issues_events notifications
    @jsondata:Name {value: "confidential_issue_channel"}
    string? confidentialIssueChannel?;
    # The name of the channel to receive tag_push_events notifications
    @jsondata:Name {value: "tag_push_channel"}
    string? tagPushChannel?;
    # Trigger event when a wiki page is created or updated
    @jsondata:Name {value: "wiki_page_events"}
    boolean? wikiPageEvents?;
    # The name of the channel to receive wiki_page_events notifications
    @jsondata:Name {value: "wiki_page_channel"}
    string? wikiPageChannel?;
    # The name of the channel to receive confidential_note_events notifications
    @jsondata:Name {value: "confidential_note_channel"}
    string? confidentialNoteChannel?;
    # Send notifications for broken pipelines
    @jsondata:Name {value: "notify_only_broken_pipelines"}
    boolean? notifyOnlyBrokenPipelines?;
    # Confidential work item events flag of the mattermost integration
    @jsondata:Name {value: "confidential_work_item_events"}
    boolean? confidentialWorkItemEvents?;
    # Trigger event when a pipeline status changes
    @jsondata:Name {value: "pipeline_events"}
    boolean? pipelineEvents?;
    # Vulnerability events flag of the mattermost integration
    @jsondata:Name {value: "vulnerability_events"}
    boolean? vulnerabilityEvents?;
    # Trigger event when a merge request is created, updated, or merged
    @jsondata:Name {value: "merge_requests_events"}
    boolean? mergeRequestsEvents?;
    # Trigger event for new comments
    @jsondata:Name {value: "note_events"}
    boolean? noteEvents?;
    # Trigger event when a deployment starts or finishes
    @jsondata:Name {value: "deployment_events"}
    boolean? deploymentEvents?;
    # Trigger event when an incident is created
    @jsondata:Name {value: "incident_events"}
    boolean? incidentEvents?;
    # The name of the channel to receive issues_events notifications
    @jsondata:Name {value: "issue_channel"}
    string? issueChannel?;
    # Trigger event for new comments on confidential work items
    @jsondata:Name {value: "confidential_note_events"}
    boolean? confidentialNoteEvents?;
    # Trigger event when a confidential work item is created, updated, or closed
    @jsondata:Name {value: "confidential_issues_events"}
    boolean? confidentialIssuesEvents?;
    # Labels to send notifications for. Leave blank to receive notifications for all events
    @jsondata:Name {value: "labels_to_be_notified"}
    string? labelsToBeNotified?;
    # The name of the channel to receive push_events notifications
    @jsondata:Name {value: "push_channel"}
    string? pushChannel?;
    # Mattermost notifications username
    string? username?;
    # The name of the channel to receive incident_events notifications
    @jsondata:Name {value: "incident_channel"}
    string? incidentChannel?;
};

