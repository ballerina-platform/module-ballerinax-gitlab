    @jsondata:Name {value: "duo_secret_detection_fp_enabled"}
    boolean? duoSecretDetectionFpEnabled?;
    # Allow users to request member access
    @jsondata:Name {value: "request_access_enabled"}
    boolean? requestAccessEnabled?;
    # [Deprecated] Only mirror protected branches. Mutually exclusive with `mirror_branch_regex`
    @jsondata:Name {value: "only_mirror_protected_branches"}
    boolean? onlyMirrorProtectedBranches?;
    # Build timeout
    @jsondata:Name {value: "build_timeout"}
    int? buildTimeout?;
    # Infrastructure access level. One of `disabled`, `private` or `enabled`
    @jsondata:Name {value: "infrastructure_access_level"}
    "disabled"|"private"|"enabled"? infrastructureAccessLevel?;
    # [Deprecated] Pull mirroring triggers builds
    @jsondata:Name {value: "mirror_trigger_builds"}
    boolean? mirrorTriggerBuilds?;
    # Enable email notifications
    @jsondata:Name {value: "emails_enabled"}
    boolean? emailsEnabled?;
    # Limit the ability to create, update, toggle, and delete feature flags to only users with at least the set minimum role
    @jsondata:Name {value: "feature_flags_minimum_role"}
    "no_one_allowed"|"developer"|"maintainer"|"owner"? featureFlagsMinimumRole?;
    # Enable GitLab Duo SAST vulnerability resolution workflow for this project
    @jsondata:Name {value: "duo_sast_vr_workflow_enabled"}
    boolean? duoSastVrWorkflowEnabled?;
    # The visibility of the project
    "private"|"internal"|"public"? visibility?;
    # Show default award emojis
    @jsondata:Name {value: "show_default_award_emojis"}
    boolean? showDefaultAwardEmojis?;
    # Requirements feature access level. One of `disabled`, `private` or `enabled`
    @jsondata:Name {value: "requirements_access_level"}
    "disabled"|"private"|"enabled"? requirementsAccessLevel?;
    # Flag indication if merge requests are enabled
    @jsondata:Name {value: "merge_requests_enabled"}
    boolean? mergeRequestsEnabled?;
    # Forks access level. One of `disabled`, `private` or `enabled`
    @jsondata:Name {value: "forking_access_level"}
    "disabled"|"private"|"enabled"? forkingAccessLevel?;
    # Template used to create merge commit message
    @jsondata:Name {value: "merge_commit_template"}
    string? mergeCommitTemplate?;
    # The commit message used to apply merge request suggestions
    @jsondata:Name {value: "suggestion_commit_message"}
    string? suggestionCommitMessage?;
    # Merge requests of this forked project targets itself by default
    @jsondata:Name {value: "mr_default_target_self"}
    boolean? mrDefaultTargetSelf?;
    # Controls visibility of the container registry. One of `disabled`, `private` or `enabled`. `private` will make the container registry accessible only to project members (reporter role and above). `enabled` will make the container registry accessible to everyone who has access to the project. `disabled` will disable the container registry
    @jsondata:Name {value: "container_registry_access_level"}
    "disabled"|"private"|"enabled"? containerRegistryAccessLevel?;
    # Flag indication if Auto DevOps is enabled
    @jsondata:Name {value: "auto_devops_enabled"}
    boolean? autoDevopsEnabled?;
    # Pipelines older than the configured time are deleted
    @jsondata:Name {value: "ci_delete_pipelines_in_seconds"}
    int? ciDeletePipelinesInSeconds?;
    # Enable GitLab Duo remote flows for this project
    @jsondata:Name {value: "duo_remote_flows_enabled"}
    boolean? duoRemoteFlowsEnabled?;
    # [Deprecated] User responsible for all the activity surrounding a pull mirror event. Can only be set by admins
    @jsondata:Name {value: "mirror_user_id"}
    int? mirrorUserId?;
    # Claims that will be used to build the sub claim in id tokens
    @jsondata:Name {value: "ci_id_token_sub_claim_components"}
    string[]? ciIdTokenSubClaimComponents?;
    # The name of the project
    string? name?;
    # The classification label for the project
    @jsondata:Name {value: "external_authorization_classification_label"}
    string? externalAuthorizationClassificationLabel?;
    # How many approvers should approve merge request by default
    @jsondata:Name {value: "approvals_before_merge"}
    int? approvalsBeforeMerge?;
    # Strategy used to automatically assign reviewers to merge requests. One of `disabled` or `code_owners`
    @jsondata:Name {value: "reviewer_assignment_strategy"}
    "disabled"|"code_owners"? reviewerAssignmentStrategy?;
    # Skip the branch pipeline when a branch has an open merge request, and run only the merge request pipeline
    @jsondata:Name {value: "ci_skip_branch_pipelines_for_mrs"}
    boolean? ciSkipBranchPipelinesForMrs?;
    # Model registry access level. One of `disabled`, `private` or `enabled`
    @jsondata:Name {value: "model_registry_access_level"}
    "disabled"|"private"|"enabled"? modelRegistryAccessLevel?;
    # Enable automatic reviews by GitLab Duo on merge requests
    @jsondata:Name {value: "auto_duo_code_review_enabled"}
    boolean? autoDuoCodeReviewEnabled?;
    # Flag indication if referenced issues auto-closing is enabled
    @jsondata:Name {value: "autoclose_referenced_issues"}
    boolean? autocloseReferencedIssues?;
    # Flag indication if the issue tracker is enabled
    @jsondata:Name {value: "issues_enabled"}
    boolean? issuesEnabled?;
    # Which storage shard the repository is on. Available only to admins
    @jsondata:Name {value: "repository_storage"}
    string? repositoryStorage?;
    # Container expiration policy attributes for the project
    @jsondata:Name {value: "container_expiration_policy_attributes"}
    CreateProjectContainerExpirationPolicyAttributes? containerExpirationPolicyAttributes?;
    # Require an associated issue from Jira
    @jsondata:Name {value: "prevent_merge_without_jira_issue"}
    boolean? preventMergeWithoutJiraIssue?;
    # Deprecated: Use :package_registry_access_level instead. Enable project packages feature
    @jsondata:Name {value: "packages_enabled"}
    boolean? packagesEnabled?;
    # Indicates if the latest artifact should be kept for this project
    @jsondata:Name {value: "keep_latest_artifact"}
    boolean? keepLatestArtifact?;
    # The description of the project
    string? description?;
    # Enable Agentic Breaking Change Resolution for this project
    @jsondata:Name {value: "duo_dependency_bump_breaking_changes_enabled"}
    boolean? duoDependencyBumpBreakingChangesEnabled?;
    # Display all manually-defined variables in the pipeline details page after running a pipeline manually
    @jsondata:Name {value: "ci_display_pipeline_variables"}
    boolean? ciDisplayPipelineVariables?;
    # The path to CI config file. Defaults to `.gitlab-ci.yml`
    @jsondata:Name {value: "ci_config_path"}
    string? ciConfigPath?;
    # Default description for merge requests. Description is parsed with GitLab Flavored Markdown
    @jsondata:Name {value: "merge_requests_template"}
    string? mergeRequestsTemplate?;
    # Blocks merge requests from merging unless all status checks have passed
    @jsondata:Name {value: "only_allow_merge_if_all_status_checks_passed"}
    boolean? onlyAllowMergeIfAllStatusChecksPassed?;
    # The Git strategy. Defaults to `fetch`
    @jsondata:Name {value: "build_git_strategy"}
    "fetch"|"clone"? buildGitStrategy?;
    # Deprecated: Use :container_registry_access_level instead. Flag indication if the container registry is enabled for that project
    @jsondata:Name {value: "container_registry_enabled"}
    boolean? containerRegistryEnabled?;
    # Default description for Issues. Description is parsed with GitLab Flavored Markdown
    @jsondata:Name {value: "issues_template"}
    string? issuesTemplate?;
    # Allow pipeline triggerer to approve deployments
    @jsondata:Name {value: "allow_pipeline_trigger_approve_deployment"}
    boolean? allowPipelineTriggerApproveDeployment?;
    # Set the maximum file size for each job's artifacts
    @jsondata:Name {value: "max_artifacts_size"}
    int? maxArtifactsSize?;
    # Enable automatic rebase of the source branch before merge
    @jsondata:Name {value: "automatic_rebase_enabled"}
    boolean? automaticRebaseEnabled?;
    # Deprecated: Use emails_enabled instead
    @jsondata:Name {value: "emails_disabled"}
    boolean? emailsDisabled?;
    # Merge train enforcement level. One of `allow_bypass`, `enforce_for_all_users`, or `enforce_with_owner_override`
    @jsondata:Name {value: "merge_train_enforcement"}
    "allow_bypass"|"enforce_for_all_users"|"enforce_with_owner_override"? mergeTrainEnforcement?;
    # Releases access level. One of `disabled`, `private` or `enabled`
    @jsondata:Name {value: "releases_access_level"}
    "disabled"|"private"|"enabled"? releasesAccessLevel?;
    # Snippets access level. One of `disabled`, `private` or `enabled`
    @jsondata:Name {value: "snippets_access_level"}
    "disabled"|"private"|"enabled"? snippetsAccessLevel?;
    # Enable web based commit signing for this project
    @jsondata:Name {value: "web_based_commit_signing_enabled"}
    boolean? webBasedCommitSigningEnabled?;
    # The merge method used when merging merge requests
    @jsondata:Name {value: "merge_method"}
    "ff"|"rebase_merge"|"merge"? mergeMethod?;
    # Template used to generate the default merge request title. Maximum 100 characters
    @jsondata:Name {value: "mr_default_title_template"}
    string? mrDefaultTitleTemplate?;
    # Grant read-only access to security policy configurations for enforcement in linked CI/CD projects
    @jsondata:Name {value: "spp_repository_pipeline_access"}
    boolean? sppRepositoryPipelineAccess?;
    # Perform public builds
    @jsondata:Name {value: "public_jobs"}
    boolean? publicJobs?;
    # Make protected CI/CD variables and runners available in merge request pipelines
    @jsondata:Name {value: "protect_merge_request_pipelines"}
    boolean? protectMergeRequestPipelines?;
};

# Represents a ML MLflow key value
public type MlMlflowKeyValue record {
    # Value of the ML MLflow key value
    string value?;
    # Key of the ML MLflow key value
    string 'key?;
};

# Represents commit status
public type CommitStatus record {
    # Coverage of the commit status
    float coverage?;
    # Time the commit status was finished
    @jsondata:Name {value: "finished_at"}
    string finishedAt?;
    # Represents an user basic
    UserBasic author?;
    # Target URL for the commit status
    @jsondata:Name {value: "target_url"}
    string targetUrl?;
    # Description of the commit status
    string description?;
    # Time the commit status was created
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    # SHA of the commit status
    string sha?;
    # Ref of the commit status
    string ref?;
    # Whether to allow failure
    @jsondata:Name {value: "allow_failure"}
    boolean allowFailure?;
    # Name of the commit status
    string name?;
    # ID of the pipeline
    @jsondata:Name {value: "pipeline_id"}
    int pipelineId?;
    # Time the commit status was started
    @jsondata:Name {value: "started_at"}
    string startedAt?;
    # ID of the commit status
    int id?;
    # Status of the commit status
    string status?;
};

# Represents application statistics
public type ApplicationStatistics record {
    # Approximate number of repo forks
    int forks?;
    # Approximate number of notes
    int notes?;
    # Approximate number of SSH keys
    @jsondata:Name {value: "ssh_keys"}
    int sshKeys?;
    # Approximate number of projects
    int projects?;
    # Number of active users
    @jsondata:Name {value: "active_users"}
    int activeUsers?;
    # Approximate number of merge requests
    @jsondata:Name {value: "merge_requests"}
    int mergeRequests?;
    # Approximate number of snippets
    int snippets?;
    # Approximate number of projects
    int groups?;
    # Approximate number of milestones
    int milestones?;
    # Approximate number of issues
    int issues?;
    # Approximate number of users
    int users?;
};

# Represents the Queries record for the operation: listProjectEvents
public type ListProjectEventsQueries record {
    # Number of items per page
    @http:Query {name: "per_page"}
    int perPage = 20;
    # Include only events created before this date
    string? before?;
    # Event target type to filter on
    @http:Query {name: "target_type"}
    "issue"|"milestone"|"merge_request"|"note"|"project"|"snippet"|"user"|"wiki"|"design"? targetType?;
    # Event action to filter on
    string? action?;
    # Include only events created after this date
    string? after?;
    # Return events sorted in ascending and descending order
    "asc"|"desc" sort = "desc";
    # Current page number
    int page = 1;
};

# Represents a CI bridge
public type CiBridge record {
    # Coverage of the CI bridge
    float coverage?;
    # Time the CI bridge was finished
    @jsondata:Name {value: "finished_at"}
    string finishedAt?;
    # Represents a commit
    Commit 'commit?;
    # Time the CI bridge was created
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    # Time the CI bridge was erased
    @jsondata:Name {value: "erased_at"}
    string erasedAt?;
    # Represents a CI job project
    CiJobProject project?;
    # Downstream pipeline of the CI bridge
    @jsondata:Name {value: "downstream_pipeline"}
    CiPipelineBasic downstreamPipeline?;
    # Failure reason of the CI bridge
    @jsondata:Name {value: "failure_reason"}
    string failureReason?;
    # Time spent enqueued
    @jsondata:Name {value: "queued_duration"}
    float queuedDuration?;
    # Time spent running
    float duration?;
    # Represents a CI pipeline basic
    CiPipelineBasic pipeline?;
    # Ref of the CI bridge
    string ref?;
    # Whether to allow failure
    @jsondata:Name {value: "allow_failure"}
    boolean allowFailure?;
    # Stage of the CI bridge
    string stage?;
    # URL of the CI bridge in the GitLab web interface
    @jsondata:Name {value: "web_url"}
    string webUrl?;
    # Name of the CI bridge
    string name?;
    # Time the CI bridge was started
    @jsondata:Name {value: "started_at"}
    string startedAt?;
    # ID of the CI bridge
    int id?;
    # Tag flag of the CI bridge
    boolean tag?;
    # Represents an user
    User user?;
    # Status of the CI bridge
    string status?;
};

# Represents a CD rollout
public type CdRollout record {
    # Time the CD rollout was finished
    @jsondata:Name {value: "finished_at"}
    string finishedAt?;
