# Object that contains status information
#               and replication metrics for the Geo node
public type ReportGeoNodeStatusData record {
    # Status message
    @jsondata:Name {value: "status_message"}
    string? statusMessage?;
    # Last event date
    @jsondata:Name {value: "last_event_date"}
    string? lastEventDate?;
    # DB replication lag in seconds
    @jsondata:Name {value: "db_replication_lag_seconds"}
    int? dbReplicationLagSeconds?;
    # Cursor last event date
    @jsondata:Name {value: "cursor_last_event_date"}
    string? cursorLastEventDate?;
    # Geo Node ID to look up its status
    @jsondata:Name {value: "geo_node_id"}
    int? geoNodeId;
    # Gitlab version
    string? version?;
    # Cursor last event ID
    @jsondata:Name {value: "cursor_last_event_id"}
    int? cursorLastEventId?;
    # Gitlab revision
    string? revision?;
    # Last successful status check date
    @jsondata:Name {value: "last_successful_status_check_at"}
    string? lastSuccessfulStatusCheckAt?;
    # Replication slots count
    @jsondata:Name {value: "replication_slots_count"}
    int? replicationSlotsCount?;
    # Last event ID
    @jsondata:Name {value: "last_event_id"}
    int? lastEventId?;
    # Replication slots used count
    @jsondata:Name {value: "replication_slots_used_count"}
    int? replicationSlotsUsedCount?;
    # Maximum number of bytes retained in the WAL on the primary
    @jsondata:Name {value: "replication_slots_max_retained_wal_bytes"}
    int? replicationSlotsMaxRetainedWalBytes?;
    # Object that contains information on replication and verification
    #                 status metrics for GitLab resources on Geo nodes
    ReportGeoNodeStatusDataStatus? status?;
};

