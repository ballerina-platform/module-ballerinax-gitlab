    # Avatar image for project
    record {byte[] fileContent; string fileName;}? avatar?;
    # Environments access level. One of `disabled`, `private` or `enabled`
    @jsondata:Name {value: "environments_access_level"}
    "disabled"|"private"|"enabled"? environmentsAccessLevel?;
    # Template used to create squash commit message
    @jsondata:Name {value: "squash_commit_template"}
    string? squashCommitTemplate?;
    # Only allow to merge if builds succeed
    @jsondata:Name {value: "only_allow_merge_if_pipeline_succeeds"}
    boolean? onlyAllowMergeIfPipelineSucceeds?;
    # Analytics access level. One of `disabled`, `private` or `enabled`
    @jsondata:Name {value: "analytics_access_level"}
    "disabled"|"private"|"enabled"? analyticsAccessLevel?;
    # Flag indication if the wiki is enabled
    @jsondata:Name {value: "wiki_enabled"}
    boolean? wikiEnabled?;
    # Remove the source branch by default after merge
    @jsondata:Name {value: "remove_source_branch_after_merge"}
    boolean? removeSourceBranchAfterMerge?;
