# Request payload for the MLflow experiment
public type CreateMlflowExperimentRequest record {
    # This will be ignored
    @jsondata:Name {value: "artifact_location"}
    string? artifactLocation?;
    # Experiment name
    string? name;
    # Tags with information about the experiment
    anydata[]? tags?;
};

# Represents a NuGet packages metadata item
public type NugetPackagesMetadataItem record {
    # Lower of the NuGet packages metadata item
    string lower?;
    # Upper of the NuGet packages metadata item
    string upper?;
    # Number of items
    int count?;
    # @id of the NuGet packages metadata item
    @jsondata:Name {value: "@id"}
    string atId?;
    # List of items
    NugetPackageMetadata[] items?;
};

# Request payload for the GCP workload identity integration
public type GcpWorkloadIdentityIntegrationRequest record {
    # ID of the Workload Identity Pool provider
    @jsondata:Name {value: "workload_identity_pool_provider_id"}
    string? workloadIdentityPoolProviderId;
    # Indicates whether to inherit the default settings. Defaults to `false`
    @jsondata:Name {value: "use_inherited_settings"}
    boolean? useInheritedSettings?;
    # Google Cloud project number for the Workload Identity Federation
    @jsondata:Name {value: "workload_identity_federation_project_number"}
    string? workloadIdentityFederationProjectNumber;
    # Google Cloud project ID for the Workload Identity Federation
    @jsondata:Name {value: "workload_identity_federation_project_id"}
    string? workloadIdentityFederationProjectId;
    # ID of the Workload Identity Pool
    @jsondata:Name {value: "workload_identity_pool_id"}
    string? workloadIdentityPoolId;
};

# Request payload for the import
public type CreateGroupImportRequest record {
    # Group path
    string? path;
    # The group export file to be imported
    record {byte[] fileContent; string fileName;}? file;
    # The ID of the parent group that the group will be imported into. Defaults to the current user's namespace
    @jsondata:Name {value: "parent_id"}
    int? parentId?;
    # The ID of the organization that the group will be part of. 
    @jsondata:Name {value: "organization_id"}
    int organizationId?;
    # Group name
    string? name;
};

# Represents a Jira connect subscription
public type JiraConnectSubscription record {
    # Unlink path for the Jira connect subscription
    @jsondata:Name {value: "unlink_path"}
    string unlinkPath?;
    # Time the Jira connect subscription was created
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    # Represents a Jira connect group
    JiraConnectGroup group?;
};

# Represents the Queries record for the operation: getSwaggerDocByName
public type GetSwaggerDocByNameQueries record {
    # Locale of API documentation
    string? locale?;
};

# Represents a merge request author
public type MergeRequestAuthor record {
    # Avatar URL for the merge request author
    @jsondata:Name {value: "avatar_url"}
    string avatarUrl?;
    # URL of the merge request author in the GitLab web interface
    @jsondata:Name {value: "web_url"}
    string webUrl?;
    # Bot flag of the merge request author
    boolean bot?;
    # Avatar path for the merge request author
    @jsondata:Name {value: "avatar_path"}
    string avatarPath?;
    # Name of the merge request author
    string name?;
    # ID of the merge request author
    int id?;
    # Public email of the merge request author
    @jsondata:Name {value: "public_email"}
    string publicEmail?;
    # State of the merge request author
    string state?;
    # Whether the merge request author is locked
    boolean locked?;
    # Username of the merge request author
    string username?;
    # List of custom attributes
    @jsondata:Name {value: "custom_attributes"}
    CustomAttribute[] customAttributes?;
};

# Request payload for the buildkite integration
public type BuildkiteIntegrationRequest record {
    # Trigger event for pushes to the repository
    @jsondata:Name {value: "push_events"}
    boolean? pushEvents?;
    # Trigger event for new tags pushed to the repository
    @jsondata:Name {value: "tag_push_events"}
    boolean? tagPushEvents?;
    # Indicates whether to inherit the default settings. Defaults to `false`
    @jsondata:Name {value: "use_inherited_settings"}
    boolean? useInheritedSettings?;
    # Pipeline URL (for example, `https://buildkite.com/example/pipeline`)
    @jsondata:Name {value: "project_url"}
    string? projectUrl;
    # Trigger event when a merge request is created, updated, or merged
    @jsondata:Name {value: "merge_requests_events"}
    boolean? mergeRequestsEvents?;
    # DEPRECATED: This parameter has no effect because SSL verification is always enabled
    @jsondata:Name {value: "enable_ssl_verification"}
    boolean? enableSslVerification?;
    # Token you get after you create a Buildkite pipeline with a GitLab repository
    string? token;
};

# Object that contains information about the current file
public type GenerateCodeCompletionsCurrentFile record {
    # The content above cursor
    @jsondata:Name {value: "content_above_cursor"}
    string? contentAboveCursor;
    # The name of the current file
    @jsondata:Name {value: "file_name"}
    string? fileName;
    # The content below cursor
    @jsondata:Name {value: "content_below_cursor"}
    string? contentBelowCursor?;
};

# Represents the Queries record for the operation: listIssueWeightEvents
public type ListIssueWeightEventsQueries record {
    # Number of items per page
    @http:Query {name: "per_page"}
    int perPage = 20;
    # Current page number
    int page = 1;
};

# Represents an internal project with license
public type InternalProjectWithLicense record {
    # Represents a license basic
    LicenseBasic license?;
    # URL of the internal project with license in the GitLab web interface
    @jsondata:Name {value: "web_url"}
    string webUrl?;
    # Visibility of the internal project with license
    string visibility?;
    # Path with namespace of the internal project with license
    @jsondata:Name {value: "path_with_namespace"}
    string pathWithNamespace?;
    # Whether wiki is enabled
    @jsondata:Name {value: "wiki_enabled"}
    boolean wikiEnabled?;
    # Empty repo flag of the internal project with license
    @jsondata:Name {value: "empty_repo"}
    boolean emptyRepo?;
    # ID of the internal project with license
    int id?;
};

# Represents a freeze period
public type FreezePeriod record {
    # Freeze end of the freeze period
    @jsondata:Name {value: "freeze_end"}
    string freezeEnd?;
    # Time the freeze period was last updated
    @jsondata:Name {value: "updated_at"}
    string updatedAt?;
    # Cron timezone of the freeze period
    @jsondata:Name {value: "cron_timezone"}
    string cronTimezone?;
    # Time the freeze period was created
