    # URL of the award emoji
    string url?;
};

# Represents the Queries record for the operation: deleteUser
public type DeleteUserQueries record {
    # Whether to remove a user's contributions
    @http:Query {name: "hard_delete"}
    boolean? hardDelete?;
};

# Request payload for merge request approval settings
public type UpdateMrApprovalSettingsRequest record {
    # Allow committers to approve merge requests
    @jsondata:Name {value: "allow_committer_approval"}
    boolean? allowCommitterApproval?;
    # Allow overrides to approver list per merge request
    @jsondata:Name {value: "allow_overrides_to_approver_list_per_merge_request"}
    boolean? allowOverridesToApproverListPerMergeRequest?;
    # Require approver to authenticate before approving
    @jsondata:Name {value: "require_password_to_approve"}
    boolean? requirePasswordToApprove?;
    # Retain approval count on a new push
    @jsondata:Name {value: "retain_approvals_on_push"}
    boolean? retainApprovalsOnPush?;
    # Reset approvals from Code Owners if their files changed
    @jsondata:Name {value: "selective_code_owner_removals"}
    boolean? selectiveCodeOwnerRemovals?;
    # Allow authors to self-approve merge requests
    @jsondata:Name {value: "allow_author_approval"}
    boolean? allowAuthorApproval?;
    # Require approver to authenticate before approving
    @jsondata:Name {value: "require_reauthentication_to_approve"}
    boolean? requireReauthenticationToApprove?;
};

# Represents CI job request credentials
public type CiJobRequestCredentials record {
    # Password of the CI job request credentials
    string password?;
    # Type of the CI job request credentials
    string 'type?;
    # URL of the CI job request credentials
    string url?;
    # Username of the CI job request credentials
    string username?;
};
