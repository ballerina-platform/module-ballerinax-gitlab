# Request payload for the merge request
public type UpdateMergeRequestRequest record {
    # Flag indicating if the merge request’s discussion is locked. If the discussion is locked only project members can add, edit or resolve comments
    @jsondata:Name {value: "discussion_locked"}
    boolean? discussionLocked?;
    # The global ID of a milestone to assign the merge request to. Mutually exclusive with `milestone`
    @jsondata:Name {value: "milestone_id"}
    int? milestoneId?;
    # The target branch
    @jsondata:Name {value: "target_branch"}
    string? targetBranch?;
    # Description of the merge request. Limited to 1,048,576 characters
    string? description?;
    # The title of the merge request
    string? title?;
    # Allow commits from members who can merge to the target branch
    @jsondata:Name {value: "allow_collaboration"}
    boolean? allowCollaboration?;
    # [deprecated] See allow_collaboration
    @jsondata:Name {value: "allow_maintainer_to_push"}
    boolean? allowMaintainerToPush?;
    # Comma-separated label names for a merge request. Set to an empty string to unassign all labels
    string[]? labels?;
    # Date after which the merge request can be merged
    @jsondata:Name {value: "merge_after"}
    string? mergeAfter?;
    # Comma-separated label names to remove from a merge request
    @jsondata:Name {value: "remove_labels"}
    string[]? removeLabels?;
    # Squash commits into a single commit when merging
    boolean? squash?;
    # The IDs of the users to review the merge request, as a comma-separated list. Set to 0 or provide an empty value to unassign all reviewers
    @jsondata:Name {value: "reviewer_ids"}
    int[]? reviewerIds?;
    # The title of a project or ancestor-group milestone to assign the merge request to. Mutually exclusive with `milestone_id`
    string? milestone?;
    # Comma-separated label names to add to a merge request
    @jsondata:Name {value: "add_labels"}
    string[]? addLabels?;
    # Flag indicating if a merge request should remove the source branch when merging
    @jsondata:Name {value: "remove_source_branch"}
    boolean? removeSourceBranch?;
    # Number of approvals required before this can be merged
    @jsondata:Name {value: "approvals_before_merge"}
    int? approvalsBeforeMerge?;
    # New state (close/reopen)
    @jsondata:Name {value: "state_event"}
    "close"|"reopen"? stateEvent?;
    # Assignee user ID
    @jsondata:Name {value: "assignee_id"}
    int? assigneeId?;
    # The IDs of the users to assign the merge request to, as a comma-separated list. Set to 0 or provide an empty value to unassign all assignees
    @jsondata:Name {value: "assignee_ids"}
    int[]? assigneeIds?;
};

