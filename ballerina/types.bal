    string? ruleType?;
    # The name of the approval rule
    string? name;
    # The group ids for this rule
    @jsondata:Name {value: "group_ids"}
    int[]? groupIds?;
    # The usernames for this rule
    string[]? usernames?;
    # The vulnerability states to be considered by the approval rule
    @jsondata:Name {value: "vulnerability_states"}
    string[]? vulnerabilityStates?;
    # The number of vulnerabilities allowed for this rule
    @jsondata:Name {value: "vulnerabilities_allowed"}
