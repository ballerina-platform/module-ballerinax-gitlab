# Request payload for the from archive
public type ImportProjectFromArchiveRequest record {
    # Path to locally stored body (generated by Workhorse)
    @jsondata:Name {value: "file.path"}
    string? filePath?;
    # Remote_url of the file (generated by Workhorse)
    @jsondata:Name {value: "file.remote_url"}
    string? fileRemoteUrl?;
    # The path of the namespace that the project will be imported into. Defaults to the current user's namespace. Mutually exclusive with `namespace`, `namespace_id`
    @jsondata:Name {value: "namespace_path"}
    string? namespacePath?;
    # Real filename as send in Content-Disposition (generated by Workhorse)
    @jsondata:Name {value: "file.name"}
    string? fileName?;
    # Real size of file (generated by Workhorse)
    @jsondata:Name {value: "file.size"}
    int? fileSize?;
    # SHA1 checksum of the file (generated by Workhorse)
    @jsondata:Name {value: "file.sha1"}
    string? fileSha1?;
    # SHA256 checksum of the file (generated by Workhorse)
    @jsondata:Name {value: "file.sha256"}
    string? fileSha256?;
    # Remote_id of the file (generated by Workhorse)
    @jsondata:Name {value: "file.remote_id"}
    string? fileRemoteId?;
    # The new project path and name
    string? path;
    # The project export file to be imported
    record {byte[] fileContent; string fileName;}? file;
    # The ID of the namespace that the project will be imported into. Defaults to the current user's namespace. Mutually exclusive with `namespace`, `namespace_path`
    @jsondata:Name {value: "namespace_id"}
    int? namespaceId?;
    # Real content type as send in Content-Type (generated by Workhorse)
    @jsondata:Name {value: "file.type"}
    string? fileType?;
    # Override params for the from archive
    @jsondata:Name {value: "override_params"}
    ImportProjectFromArchiveOverrideParams? overrideParams?;
    # Etag of the file (generated by Workhorse)
    @jsondata:Name {value: "file.etag"}
    string? fileEtag?;
    # The name of the project to be imported. Defaults to the path of the project if not provided
    string? name?;
    # (deprecated) The ID or path of the namespace to import the project to. Defaults to the current user's namespace. Mutually exclusive with `namespace_id`, `namespace_path`
    string? namespace?;
    # MD5 checksum of the file (generated by Workhorse)
    @jsondata:Name {value: "file.md5"}
    string? fileMd5?;
    # If there is a project in the same namespace and with the same name overwrite it
    boolean overwrite = false;
};

# Request payload for the MLflow parameter
public type LogMlflowParameterRequest record {
    # UUID of the run
    @jsondata:Name {value: "run_id"}
    string? runId;
    # Value for the parameter
    string? value;
    # Name for the parameter
    string? 'key;
};

# The event payload
public type IngestRolloutWorkflowEventData record {
    # Human-readable prompt, present on approval_requested
    string? reason?;
    # Exact name of the target GitLab environment; resolves the rollout environment to update when a stage deploys to more than one environment
    string? environment?;
    # The step type, present on step_* events
    @jsondata:Name {value: "step_type"}
    string? stepType?;
    # Name of the Cd::Service, present on service_started/service_succeeded/service_failed
    string? 'service?;
    # Name of the enclosing stage (an environment tier); absent for a step outside any stage
    @jsondata:Name {value: "stage_name"}
    string? stageName?;
    # Zero-based path to the stage/step in the flow definition; required for every event except com.gitlab.cd.rollout_succeeded
    int[]? position?;
    # Failure detail, present on step_failed and service_failed
    string? 'error?;
    # Name of the AutoFlow channel to post the approval decision back into, present on approval_requested
    string? reply?;
};

# Represents the Queries record for the operation: searchMlflowRegisteredModels
public type SearchMlflowRegisteredModelsQueries record {
    # Filter to search models. must be in the format `name='value'`. Only filtering by name is supported
    string? filter?;
    # Token for pagination
    @http:Query {name: "page_token"}
    string? pageToken?;
    # Maximum number of models desired. Default is 200. Max threshold is 1000
    @http:Query {name: "max_results"}
    int maxResults = 200;
    # Order criteria. Can be by name or last_updated_timestamp, with optional DESC or ASC (default)Valid examples: `name`, `name DESC`, `last_updated_timestamp DESC`Sorting by model metadata is not supported
    @http:Query {name: "order_by"}
    string orderBy = "name ASC";
};

# Represents bulk imports export batch status
public type BulkImportsExportBatchStatus record {
    # Batch number of the bulk imports export batch status
    @jsondata:Name {value: "batch_number"}
    int batchNumber?;
