    @jsondata:Name {value: "default_ci_config_path"}
    string? defaultCiConfigPath?;
    # Enable migrating GitLab groups and projects by direct transfer
    @jsondata:Name {value: "bulk_import_enabled"}
    boolean? bulkImportEnabled?;
    # Specify an email address regex pattern to identify default internal users
    @jsondata:Name {value: "user_default_internal_regex"}
    string? userDefaultInternalRegex?;
    # Maximum value that is allowed for configuring pipeline retention. Defaults to `1 year`
    @jsondata:Name {value: "ci_delete_pipelines_in_seconds_limit_human_readable"}
    string? ciDeletePipelinesInSecondsLimitHumanReadable?;
    # Users get by ID limit allowlist raw for the application settings
    @jsondata:Name {value: "users_get_by_id_limit_allowlist_raw"}
    string? usersGetByIdLimitAllowlistRaw?;
    # Maximum number of requests per minute for performing a search while unauthenticated. Default: 10. To disable throttling, set to 0
    @jsondata:Name {value: "search_rate_limit_unauthenticated"}
    string? searchRateLimitUnauthenticated?;
    # If `delete_inactive_projects` is `true`, the minimum repository size for projects to be checked for inactivity. Default is `0`
    @jsondata:Name {value: "inactive_projects_min_size_mb"}
