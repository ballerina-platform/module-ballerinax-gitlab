# Request payload for the user
public type CreateUserRequest record {
    # Admin note for this user
    string? note?;
    # Flag indicating the user has a private profile
    @jsondata:Name {value: "private_profile"}
    boolean? privateProfile?;
    # The commit email, _private for private commit email
    @jsondata:Name {value: "commit_email"}
    string? commitEmail?;
    # The GitLab theme for the user
    @jsondata:Name {value: "theme_id"}
    int? themeId?;
    # The number of projects a user can create
    @jsondata:Name {value: "projects_limit"}
    int? projectsLimit?;
    # The biography of the user
    string? bio?;
    # Flag indicating the user is an administrator
    boolean? admin?;
    # The LinkedIn username
    string? linkedin?;
    # Flag indicating the user can create groups
    @jsondata:Name {value: "can_create_group"}
    boolean? canCreateGroup?;
    # The password of the new user
    string? password?;
    # The Twitter username
    string? twitter?;
    # The color scheme for the file viewer
    @jsondata:Name {value: "color_scheme_id"}
    int? colorSchemeId?;
    # The external provider
    string? provider?;
    # Flag indicating a random password will be set
    @jsondata:Name {value: "force_random_password"}
    boolean? forceRandomPassword?;
    # The email of the user
    string? email;
    # The external authentication provider UID
    @jsondata:Name {value: "extern_uid"}
    string? externUid?;
    # The GitHub username
    string? github?;
    # Compute minutes quota for this user
    @jsondata:Name {value: "shared_runners_minutes_limit"}
    int? sharedRunnersMinutesLimit?;
    # Flag indicating auditor status of the user
    boolean? auditor?;
    # Avatar image for user
    record {byte[] fileContent; string fileName;}? avatar?;
    # Flag indicating the user sees only one file diff per page
    @jsondata:Name {value: "view_diffs_file_by_file"}
    boolean? viewDiffsFileByFile?;
    # Flag indicating the user is an external user
    boolean? 'external?;
    # The Discord user ID
    string? discord?;
    # The website of the user
    @jsondata:Name {value: "website_url"}
    string? websiteUrl?;
    # ID for group where SAML has been configured
    @jsondata:Name {value: "group_id_for_saml"}
    int? groupIdForSaml?;
    # (admin-only) Extra compute minutes quota for this user
    @jsondata:Name {value: "extra_shared_runners_minutes_limit"}
    int? extraSharedRunnersMinutesLimit?;
    # The organization of the user. Empty string or nil clears the field
    string? organization?;
    # Flag indicating that advanced editor is enabled
    @jsondata:Name {value: "policy_advanced_editor"}
    boolean? policyAdvancedEditor?;
    # Flag indicating the user will be sent a password reset token
    @jsondata:Name {value: "reset_password"}
    boolean? resetPassword?;
    # The name of the user
    string? name;
    # The location of the user
    string? location?;
    # The pronouns of the user
    string? pronouns?;
    # The public email of the user
    @jsondata:Name {value: "public_email"}
    string? publicEmail?;
    # Flag indicating the account is confirmed
    @jsondata:Name {value: "skip_confirmation"}
    boolean? skipConfirmation?;
