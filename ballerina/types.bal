};

# Represents an award emoji
public type AwardEmoji record {
    # Time the award emoji was last updated
    @jsondata:Name {value: "updated_at"}
    string updatedAt?;
    # Awardable type of the award emoji
    @jsondata:Name {value: "awardable_type"}
    string awardableType?;
    # Name of the award emoji
    string name?;
    # Time the award emoji was created
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    # ID of the awardable
    @jsondata:Name {value: "awardable_id"}
    int awardableId?;
    # ID of the award emoji
    int id?;
    # Represents an user basic
