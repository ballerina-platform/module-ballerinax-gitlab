# Request payload for the epic
public type UpdateEpicRequest record {
    # Deprecated: use due_date_fixed instead
    @jsondata:Name {value: "end_date"}
    string? endDate?;
    # The color of an epic
    string? color?;
    # The description of an epic
    string? description?;
    # The title of an epic
    string? title?;
    # The due date of an epic
    @jsondata:Name {value: "due_date_fixed"}
    string? dueDateFixed?;
    # Comma-separated label names for an issue
    string[]? labels?;
    # Indicates due date should be sourced from due_date_fixed field not the issue milestones
    @jsondata:Name {value: "due_date_is_fixed"}
    boolean? dueDateIsFixed?;
    # Indicates start date should be sourced from start_date_fixed field not the issue milestones
    @jsondata:Name {value: "start_date_is_fixed"}
    boolean? startDateIsFixed?;
    # Comma-separated label names to remove from an issue
    @jsondata:Name {value: "remove_labels"}
    string[]? removeLabels?;
    # Date time when the epic was updated. Available only for admins and project owners
    @jsondata:Name {value: "updated_at"}
    string? updatedAt?;
    # The ID of a parent epic
    @jsondata:Name {value: "parent_id"}
    int? parentId?;
    # Comma-separated label names to add to an issue
    @jsondata:Name {value: "add_labels"}
    string[]? addLabels?;
    # The start date of an epic
    @jsondata:Name {value: "start_date_fixed"}
    string? startDateFixed?;
    # State event for an epic
    @jsondata:Name {value: "state_event"}
    "reopen"|"close"? stateEvent?;
    # Indicates if the epic is confidential
    boolean? confidential?;
    # Deprecated: use start_date_fixed instead
    @jsondata:Name {value: "start_date"}
    string? startDate?;
};

