};

# Represents the Queries record for the operation: downloadJobArtifactFileByRef
public type DownloadJobArtifactFileByRefQueries record {
    # Search across recent successful pipelines instead of just the latest one
    @http:Query {name: "search_recent_successful_pipelines"}
    boolean searchRecentSuccessfulPipelines = false;
    # To be used with triggers for multi-project pipelines, available only on Premium and Ultimate tiers
    @http:Query {name: "job_token"}
