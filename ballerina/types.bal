# Request payload for the runner
public type CreateCurrentUserRunnerRequest record {
    # Specifies if the runner should ignore new jobs (defaults to false)
    boolean? paused?;
    # The expiration time for the runner authentication token (ISO 8601 format). Must be between 5 minutes and 15 days in the future, and cannot exceed instance/group/project limits
    @jsondata:Name {value: "token_expires_at"}
    string? tokenExpiresAt?;
    # Specifies the scope of the runner
    @jsondata:Name {value: "runner_type"}
    "instance_type"|"group_type"|"project_type" runnerType;
    # Description of the runner
    string? description?;
    # The access level of the runner
    @jsondata:Name {value: "access_level"}
    "not_protected"|"ref_protected"? accessLevel?;
    # Maximum timeout that limits the amount of time (in seconds) that runners can run jobs
    @jsondata:Name {value: "maximum_timeout"}
    int? maximumTimeout?;
    # The ID of the group that the runner is created in
    @jsondata:Name {value: "group_id"}
    int? groupId;
    # The ID of the project that the runner is created in
    @jsondata:Name {value: "project_id"}
    int? projectId;
    # Free-form maintenance notes for the runner (1024 characters)
    @jsondata:Name {value: "maintenance_note"}
    string? maintenanceNote?;
    # A list of runner tags
    @jsondata:Name {value: "tag_list"}
    string[]? tagList?;
    # Specifies if the runner should be locked for the current project
    boolean locked = false;
    # Specifies if the runner should handle untagged jobs
    @jsondata:Name {value: "run_untagged"}
    boolean runUntagged = true;
    # The deadline for token rotation (ISO 8601 format). Must be specified with token_expires_at and be <= token_expires_at
    @jsondata:Name {value: "token_rotation_deadline"}
    string? tokenRotationDeadline?;
};

