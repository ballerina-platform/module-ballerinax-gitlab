    UserBasic[] assignees?;
    # Title of the issue
    string title?;
    # The type of the issue
    "ISSUE"|"INCIDENT"|"TEST_CASE"|"REQUIREMENT"|"TASK"|"TICKET" 'type?;
    # Closed by of the issue
    @jsondata:Name {value: "closed_by"}
    UserBasic closedBy?;
    # Whether the issue has tasks
    @jsondata:Name {value: "has_tasks"}
    boolean hasTasks?;
    # Whether the issue is subscribed
    boolean subscribed?;
    # Service desk reply to of the issue
    @jsondata:Name {value: "service_desk_reply_to"}
    string serviceDeskReplyTo?;
    # Time the issue was last updated
    @jsondata:Name {value: "updated_at"}
    string updatedAt?;
    # ID of the project
    @jsondata:Name {value: "project_id"}
    int projectId?;
    # Whether the issue is imported
    boolean imported?;
    # Epic IID of the issue
    @jsondata:Name {value: "epic_iid"}
    string epicIid?;
    # Time stats of the issue
    @jsondata:Name {value: "time_stats"}
    IssuableTimeStats timeStats?;
    # Represents an iteration
    Iteration iteration?;
    # ID of the issue
    int id?;
    # State of the issue
    string state?;
    # Health status of the issue
    @jsondata:Name {value: "health_status"}
    string healthStatus?;
    # Start date of the issue
    @jsondata:Name {value: "start_date"}
    string startDate?;
    # Confidential flag of the issue
    boolean confidential?;
    # The severity of the issue
    "UNKNOWN"|"LOW"|"MEDIUM"|"HIGH"|"CRITICAL" severity?;
    # Task status of the issue
    @jsondata:Name {value: "task_status"}
    string taskStatus?;
    # Time the issue was closed
    @jsondata:Name {value: "closed_at"}
    string closedAt?;
    # Represents an user basic
    UserBasic author?;
    # Due date of the issue
    @jsondata:Name {value: "due_date"}
    string dueDate?;
    # Issue type of the issue
    @jsondata:Name {value: "issue_type"}
    string issueType?;
    # Imported from of the issue
    @jsondata:Name {value: "imported_from"}
    string importedFrom?;
    # Weight of the issue
    int weight?;
    # Represents an epic base
    EpicBase epic?;
    # Downvotes of the issue
    int downvotes?;
    # Number of blocking issues
    @jsondata:Name {value: "blocking_issues_count"}
    int blockingIssuesCount?;
    # List of labels
    string[] labels?;
    # ID of the moved to
    @jsondata:Name {value: "moved_to_id"}
    int movedToId?;
    # Represents a milestone
    Milestone milestone?;
    # URL of the issue in the GitLab web interface
    @jsondata:Name {value: "web_url"}
    string webUrl?;
    # Number of user notes
    @jsondata:Name {value: "user_notes_count"}
    int userNotesCount?;
    # Represents an user basic
    UserBasic assignee?;
    # Task completion status of the issue
    @jsondata:Name {value: "task_completion_status"}
    TaskCompletionStatus taskCompletionStatus?;
};

