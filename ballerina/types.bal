# Request payload for the note
public type CreateNoteRequest record {
    # Internal note flag
    boolean internal = false;
    # The creation date of the note
    @jsondata:Name {value: "created_at"}
    string? createdAt?;
    # The SHA of the head commit
    @jsondata:Name {value: "merge_request_diff_head_sha"}
    string? mergeRequestDiffHeadSha?;
    # The content of a note
    string? body;
    # [Deprecated in 15.5] Renamed to internal
    boolean? confidential?;
};

# Request payload for the merge request pipeline
public type CreateMergeRequestPipelineRequest record {
    # Indicates if the merge request pipeline creation should be performed asynchronously. If set to `true`, the pipeline will be created outside of the API request and the endpoint will return an empty response with a `202` status code. When the response is `202`, the creation can still fail outside of this request
    boolean async = false;
};

# Determine if developers can push to default branch
public type DefaultBranchProtectionDefaults record {
    # Allow developers to initial push
    @jsondata:Name {value: "developer_can_initial_push"}
    boolean? developerCanInitialPush?;
    # An array of access levels allowed to push
    @jsondata:Name {value: "allowed_to_push"}
    BranchProtectionAllowedToPush[]? allowedToPush?;
    # An array of access levels allowed to merge
    @jsondata:Name {value: "allowed_to_merge"}
    BranchProtectionAllowedToPush[]? allowedToMerge?;
    # Allow force push for all users with push access
    @jsondata:Name {value: "allow_force_push"}
    boolean? allowForcePush?;
    # Require approval from code owners
    @jsondata:Name {value: "code_owner_approval_required"}
    boolean? codeOwnerApprovalRequired?;
};

# Represents the Queries record for the operation: listTopics
public type ListTopicsQueries record {
