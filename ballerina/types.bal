# Request payload for the issue
public type ReorderIssueRequest record {
    # The ID of the issue we want to be after
    @jsondata:Name {value: "move_after_id"}
    int? moveAfterId?;
    # The ID of the issue we want to be before
    @jsondata:Name {value: "move_before_id"}
    int? moveBeforeId?;
};

# Represents a resource weight event
public type ResourceWeightEvent record {
    # ID of the issue
    @jsondata:Name {value: "issue_id"}
    int issueId?;
    # Time the resource weight event was created
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    # Weight of the resource weight event
    int weight?;
    # ID of the resource weight event
    int id?;
    # Represents an user basic
    UserBasic user?;
};

# Represents a CI runtime environment key
public type CiRuntimeEnvironmentKey record {
    # Runtime environment key of the CI runtime environment key
    @jsondata:Name {value: "runtime_environment_key"}
    string runtimeEnvironmentKey?;
};

# Represents a CI pipeline with metadata
public type CiPipelineWithMetadata record {
    # Coverage of the CI pipeline with metadata
    float coverage?;
    # Before SHA of the CI pipeline with metadata
    @jsondata:Name {value: "before_sha"}
    string beforeSha?;
    # Detailed status of the CI pipeline with metadata
    @jsondata:Name {value: "detailed_status"}
    DetailedStatus detailedStatus?;
    # Time the CI pipeline with metadata was finished
    @jsondata:Name {value: "finished_at"}
    string finishedAt?;
    # Internal ID of the CI pipeline with metadata, unique within its project or group
    int iid?;
    # Time the CI pipeline with metadata was created
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    # Source of the CI pipeline with metadata
    string 'source?;
    # SHA of the CI pipeline with metadata
    string sha?;
    # Time spent enqueued in seconds
    @jsondata:Name {value: "queued_duration"}
    int queuedDuration?;
    # YAML errors of the CI pipeline with metadata
    @jsondata:Name {value: "yaml_errors"}
    string yamlErrors?;
    # Time spent running in seconds
    int duration?;
    # Whether the CI pipeline with metadata is archived
    boolean archived?;
    # Ref of the CI pipeline with metadata
    string ref?;
    # Time the CI pipeline with metadata was last updated
    @jsondata:Name {value: "updated_at"}
    string updatedAt?;
    # URL of the CI pipeline with metadata in the GitLab web interface
    @jsondata:Name {value: "web_url"}
    string webUrl?;
    # ID of the project
    @jsondata:Name {value: "project_id"}
    int projectId?;
    # Time the CI pipeline with metadata was committed
    @jsondata:Name {value: "committed_at"}
    string committedAt?;
    # Name of the CI pipeline with metadata
    string name?;
    # Time the CI pipeline with metadata was started
    @jsondata:Name {value: "started_at"}
    string startedAt?;
    # ID of the CI pipeline with metadata
    int id?;
    # Tag flag of the CI pipeline with metadata
    boolean tag?;
    # Represents an user basic
    UserBasic user?;
    # Status of the CI pipeline with metadata
    string status?;
};

# Request payload for the from remote archive
public type ImportProjectFromRemoteArchiveRequest record {
    # The new project path and name
    string? path;
