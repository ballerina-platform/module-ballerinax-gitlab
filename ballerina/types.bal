    @jsondata:Name {value: "project_import_limit"}
    string? projectImportLimit?;
    # Enable encryption for Terraform state files
    @jsondata:Name {value: "terraform_state_encryption_enabled"}
    boolean? terraformStateEncryptionEnabled?;
    # The maximum size in bytes of a single CI/CD configuration file. Default: `2097152`
    @jsondata:Name {value: "max_yaml_size_bytes"}
    string? maxYamlSizeBytes?;
    # Zoekt force reindexing percentage for the application settings
    @jsondata:Name {value: "zoekt_force_reindexing_percentage"}
    string? zoektForceReindexingPercentage?;
    # Every week GitLab will report license usage back to GitLab, Inc
    @jsondata:Name {value: "usage_ping_enabled"}
    boolean? usagePingEnabled?;
    # Maximum number of requests per minute per runner token for requests to the `PATCH /jobs/:id/trace` runner jobs API endpoint. Default: 2000. To disable throttling, set to 0. [Introduced](https://gitlab.com/gitlab-org/gitlab/-/issues/462537) in GitLab 18.5
    @jsondata:Name {value: "runner_jobs_patch_trace_api_limit"}
    string? runnerJobsPatchTraceApiLimit?;
    # Indicates whether GitLab Duo remote flows are enabled for the instance
    @jsondata:Name {value: "duo_remote_flows_enabled"}
    boolean? duoRemoteFlowsEnabled?;
    # Maximum number of possible retries for Elasticsearch search requests. Premium and Ultimate only
    @jsondata:Name {value: "elasticsearch_retry_on_failure"}
    string? elasticsearchRetryOnFailure?;
    # Observability backend SSL verification enabled for the application settings
    @jsondata:Name {value: "observability_backend_ssl_verification_enabled"}
    string? observabilityBackendSslVerificationEnabled?;
    # Flag indicating if the Gravatar service is enabled
    @jsondata:Name {value: "gravatar_enabled"}
    boolean? gravatarEnabled?;
    # Indicates whether GitLab Duo features are enabled for the group
    @jsondata:Name {value: "duo_features_enabled"}
    boolean? duoFeaturesEnabled?;
    # Domain denylist raw for the application settings
    @jsondata:Name {value: "domain_denylist_raw"}
    string? domainDenylistRaw?;
    # Github Importer maximum number of simultaneous import jobs
    @jsondata:Name {value: "concurrent_github_import_jobs_limit"}
    int? concurrentGithubImportJobsLimit?;
    # The AWS region the elasticsearch domain is configured
    @jsondata:Name {value: "elasticsearch_aws_region"}
    string? elasticsearchAwsRegion?;
    # Number of Git pushes after which 'git gc' is run
    @jsondata:Name {value: "housekeeping_gc_period"}
