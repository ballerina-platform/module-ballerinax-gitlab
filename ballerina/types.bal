# Represents the Queries record for the operation: listMlflowArtifacts
public type ListMlflowArtifactsQueries record {
    # Path to the artifact, model version id, optionally followed by path. E.g. 15/MLmodel
    string? path?;
};

# Represents a project repository storage
public type ProjectRepositoryStorage record {
    # ID of the project
    @jsondata:Name {value: "project_id"}
    int projectId?;
    # Repository storage of the project repository storage
    @jsondata:Name {value: "repository_storage"}
    string repositoryStorage?;
    # Time the project repository storage was created
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    # Disk path for the project repository storage
    @jsondata:Name {value: "disk_path"}
    string diskPath?;
};

# Represents create feature flag scopes
public type CreateFeatureFlagScopes record {
    # The environment scope of the scope
    @jsondata:Name {value: "environment_scope"}
    string? environmentScope;
};

# Request payload for the usage data event
public type UsageDataEventRequest record {
    # The event name that should be tracked
    string? event;
};

# Request payload for the nu get package
public type UploadNuGetPackageRequest record {
    # The package file to be published (generated by Multipart middleware)
    record {byte[] fileContent; string fileName;}? package;
};

# Request payload for the mock monitoring integration
public type MockMonitoringIntegrationRequest record {
    # Indicates whether to inherit the default settings. Defaults to `false`
    @jsondata:Name {value: "use_inherited_settings"}
    boolean? useInheritedSettings?;
};

# Represents approvals
public type Approvals record {
    # Time the approvals was approved
    @jsondata:Name {value: "approved_at"}
    string approvedAt?;
    # Represents an user basic
    UserBasic user?;
};

# Represents a cluster group
public type ClusterGroup record {
    # Provider type of the cluster group
    @jsondata:Name {value: "provider_type"}
    string providerType?;
    # Environment scope of the cluster group
    @jsondata:Name {value: "environment_scope"}
    string environmentScope?;
    # Time the cluster group was created
