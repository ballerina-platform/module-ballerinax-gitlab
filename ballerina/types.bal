};

# Represents a projects with access and catalog setting
public type ProjectsWithAccessAndCatalogSetting record {
    # SSH URL to repo of the projects with access and catalog setting
    @jsondata:Name {value: "ssh_url_to_repo"}
    string sshUrlToRepo?;
