    # The type of the issue
    "ISSUE"|"INCIDENT"|"TEST_CASE"|"REQUIREMENT"|"TASK"|"TICKET" 'type?;
    # Closed by of the vulnerability related issue
    @jsondata:Name {value: "closed_by"}
    UserBasic closedBy?;
    # Time the vulnerability related issue was last updated
    @jsondata:Name {value: "updated_at"}
    string updatedAt?;
    # ID of the project
    @jsondata:Name {value: "project_id"}
    int projectId?;
    # Time stats of the vulnerability related issue
    @jsondata:Name {value: "time_stats"}
    IssuableTimeStats timeStats?;
    # Vulnerability link type of the vulnerability related issue
    @jsondata:Name {value: "vulnerability_link_type"}
    string vulnerabilityLinkType?;
    # ID of the vulnerability related issue
    int id?;
    # State of the vulnerability related issue
    string state?;
    # Start date of the vulnerability related issue
    @jsondata:Name {value: "start_date"}
    string startDate?;
    # Confidential flag of the vulnerability related issue
    boolean confidential?;
    # Time the vulnerability related issue was closed
    @jsondata:Name {value: "closed_at"}
    string closedAt?;
    # Represents an user basic
    UserBasic author?;
    # Due date of the vulnerability related issue
    @jsondata:Name {value: "due_date"}
    string dueDate?;
    # Issue type of the vulnerability related issue
    @jsondata:Name {value: "issue_type"}
    string issueType?;
    # Weight of the vulnerability related issue
    int weight?;
    # Downvotes of the vulnerability related issue
    int downvotes?;
    # Number of blocking issues
    @jsondata:Name {value: "blocking_issues_count"}
    int blockingIssuesCount?;
    # List of labels
    string[] labels?;
    # Represents a milestone
    Milestone milestone?;
    # URL of the vulnerability related issue in the GitLab web interface
    @jsondata:Name {value: "web_url"}
    string webUrl?;
    # Number of user notes
    @jsondata:Name {value: "user_notes_count"}
    int userNotesCount?;
    # Represents an user basic
    UserBasic assignee?;
    # ID of the vulnerability link
    @jsondata:Name {value: "vulnerability_link_id"}
    int vulnerabilityLinkId?;
    # Task completion status of the vulnerability related issue
    @jsondata:Name {value: "task_completion_status"}
    TaskCompletionStatus taskCompletionStatus?;
};

