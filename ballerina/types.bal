# Request payload for the release
public type CreateReleaseRequest record {
    # If a tag specified in `tag_name` doesn't exist, the release is created from `ref` and tagged with `tag_name`. It can be a commit SHA, another tag name, or a branch name
    string? ref?;
    # Object that contains assets for the release
    CreateReleaseAssets? assets?;
    # The tag where the release is created from
    @jsondata:Name {value: "tag_name"}
    string? tagName;
    # The release name
    string? name?;
    # The description of the release. You can use Markdown
    string? description?;
    # Message to use if creating a new annotated tag
    @jsondata:Name {value: "tag_message"}
    string? tagMessage?;
    # Date and time for the release. Defaults to the current time. Expected in ISO 8601 format (`2019-03-15T08:00:00Z`). Only provide this field if creating an upcoming or historical release
    @jsondata:Name {value: "released_at"}
    string? releasedAt?;
    # The title of each milestone the release is associated with. GitLab Premium customers can specify group milestones. Cannot be combined with `milestone_ids` parameter. Mutually exclusive with `milestone_ids`
    string[]? milestones?;
    # The ID of each milestone the release is associated with. GitLab Premium customers can specify group milestones. Cannot be combined with `milestones` parameter. Mutually exclusive with `milestones`
    @jsondata:Name {value: "milestone_ids"}
    string|int? milestoneIds?;
    # If true, the release will be published to the CI catalog. This parameter is for internal use only and will be removed in a future release. If the feature flag ci_release_cli_catalog_publish_option is disabled, this parameter will be ignored and the release will published to the CI catalog as it was before this parameter was introduced
    @jsondata:Name {value: "legacy_catalog_publish"}
    boolean? legacyCatalogPublish?;
};

