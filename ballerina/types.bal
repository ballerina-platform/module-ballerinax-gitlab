# Request payload for the group
public type UpdateGroupRequest record {
    # Only allow to merge if all threads are resolved
    @jsondata:Name {value: "only_allow_merge_if_all_discussions_are_resolved"}
    boolean? onlyAllowMergeIfAllDiscussionsAreResolved?;
    # Allow users to request member access
    @jsondata:Name {value: "request_access_enabled"}
    boolean? requestAccessEnabled?;
    # Enable Customer Relations Management for this group
    @jsondata:Name {value: "crm_enabled"}
    boolean? crmEnabled?;
    # List of allowed email domains for group
    @jsondata:Name {value: "allowed_email_domains_list"}
    string? allowedEmailDomainsList?;
    # Disable a group from getting mentioned
    @jsondata:Name {value: "mentions_disabled"}
    boolean? mentionsDisabled?;
    # The path of the group
    string? path?;
    # The ID of a project to use for custom templates in this group
    @jsondata:Name {value: "file_template_project_id"}
    int? fileTemplateProjectId?;
    # Enable GitLab Duo remote flows for this group
    @jsondata:Name {value: "duo_remote_flows_availability"}
    boolean? duoRemoteFlowsAvailability?;
    # Enable experiment features for this group
    @jsondata:Name {value: "experiment_features_enabled"}
    boolean? experimentFeaturesEnabled?;
    # Enable Amazon Q auto review for merge request
    @jsondata:Name {value: "amazon_q_auto_review_enabled"}
    boolean? amazonQAutoReviewEnabled?;
    # Time period during which a user can download a maximum amount of projects before they are banned
    @jsondata:Name {value: "unique_project_download_limit_interval_in_seconds"}
    int? uniqueProjectDownloadLimitIntervalInSeconds?;
    # Determine if developers can create projects in the group
    @jsondata:Name {value: "project_creation_level"}
    "noone"|"owner"|"maintainer"|"developer"|"administrator"? projectCreationLevel?;
    # Wiki access level. One of `disabled`, `private` or `enabled`
    @jsondata:Name {value: "wiki_access_level"}
    "disabled"|"private"|"enabled"? wikiAccessLevel?;
    # Enable email notifications
    @jsondata:Name {value: "emails_enabled"}
    boolean? emailsEnabled?;
    # Indicates whether AI audit events are stored for the group
    @jsondata:Name {value: "ai_audit_events_storage_enabled"}
    boolean? aiAuditEventsStorageEnabled?;
    # Allow to merge if pipeline is skipped
    @jsondata:Name {value: "allow_merge_on_skipped_pipeline"}
    boolean? allowMergeOnSkippedPipeline?;
    # Enable/disable LFS for the projects in this group
    @jsondata:Name {value: "lfs_enabled"}
    boolean? lfsEnabled?;
    # AI settings attributes for the group
    @jsondata:Name {value: "ai_settings_attributes"}
    CreateGroupAiSettingsAttributes? aiSettingsAttributes?;
    # Default branch protection defaults for the group
    @jsondata:Name {value: "default_branch_protection_defaults"}
    DefaultBranchProtectionDefaults? defaultBranchProtectionDefaults?;
    # The visibility of the group
    "private"|"internal"|"public"? visibility?;
    # (admin-only) compute minutes quota for this group
    @jsondata:Name {value: "shared_runners_minutes_limit"}
    int? sharedRunnersMinutesLimit?;
    # Whether each foundational agent has been enabled or disabled
    @jsondata:Name {value: "foundational_agents_statuses"}
    CreateGroupFoundationalAgentsStatuses[]? foundationalAgentsStatuses?;
    # AI entity access rules for controlling Duo feature access
    @jsondata:Name {value: "duo_namespace_access_rules"}
    ApplicationSettingsDuoNamespaceAccessRules[]? duoNamespaceAccessRules?;
    # Ban users from the group when they exceed maximum number of unique projects download in the specified time period
    @jsondata:Name {value: "auto_ban_user_on_excessive_projects_download"}
    boolean? autoBanUserOnExcessiveProjectsDownload?;
    # [Experimental] Indicates whether GitLab Duo Core features are enabled for the group
    @jsondata:Name {value: "duo_core_features_enabled"}
    boolean? duoCoreFeaturesEnabled?;
    # Require all users in this group to setup Two-factor authentication
    @jsondata:Name {value: "require_two_factor_authentication"}
    boolean? requireTwoFactorAuthentication?;
    # Include the code diff preview in merge request notification emails
    @jsondata:Name {value: "show_diff_preview_in_email"}
    boolean? showDiffPreviewInEmail?;
    # Enable GitLab Duo external agents for this group
    @jsondata:Name {value: "duo_external_agents_availability"}
    boolean? duoExternalAgentsAvailability?;
    # Enable GitLab Duo custom agents for this group
    @jsondata:Name {value: "duo_custom_agents_availability"}
    boolean? duoCustomAgentsAvailability?;
    # Indicates if math rendering limits are used for this group
    @jsondata:Name {value: "math_rendering_limits_enabled"}
    boolean? mathRenderingLimitsEnabled?;
    # Prevent adding new members to projects within this group
    @jsondata:Name {value: "membership_lock"}
    boolean? membershipLock?;
    # Prevent sharing groups within this namespace with any groups outside the namespace. Only available on top-level groups
    @jsondata:Name {value: "prevent_sharing_groups_outside_hierarchy"}
    boolean? preventSharingGroupsOutsideHierarchy?;
    # Allowed to create subgroups
    @jsondata:Name {value: "subgroup_creation_level"}
    "owner"|"maintainer"? subgroupCreationLevel?;
    # Default to Auto DevOps pipeline for all projects within this group
    @jsondata:Name {value: "auto_devops_enabled"}
    boolean? autoDevopsEnabled?;
    # Indicates whether AI audit events storage is enforced for all subgroups and projects
    @jsondata:Name {value: "lock_ai_audit_events_storage_enabled"}
    boolean? lockAiAuditEventsStorageEnabled?;
    # (admin-only) Extra compute minutes quota for this group
    @jsondata:Name {value: "extra_shared_runners_minutes_limit"}
    int? extraSharedRunnersMinutesLimit?;
    # Enable GitLab foundational Duo flows for this group
    @jsondata:Name {value: "duo_foundational_flows_availability"}
    boolean? duoFoundationalFlowsAvailability?;
    # List of usernames excluded from the unique project download limit
    @jsondata:Name {value: "unique_project_download_limit_allowlist"}
    string[]? uniqueProjectDownloadLimitAllowlist?;
    # Indicates whether GitLab Duo features are enabled for the group
    @jsondata:Name {value: "duo_features_enabled"}
    boolean? duoFeaturesEnabled?;
    # The name of the group
    string? name?;
    # Enable/disable shared runners for the group and its subgroups and projects
    @jsondata:Name {value: "shared_runners_setting"}
    "disabled_and_unoverridable"|"disabled_and_overridable"|"enabled"? sharedRunnersSetting?;
    # Allow only the selected protocols to be used for Git access
    @jsondata:Name {value: "enabled_git_access_protocol"}
    "ssh"|"http"|"all"? enabledGitAccessProtocol?;
    # Duo auto mode availability. One of `default_on`, `default_off` or `never_on`
    @jsondata:Name {value: "duo_auto_mode_availability"}
    "default_on"|"default_off"|"never_on"? duoAutoModeAvailability?;
    # The default branch of group's projects
    @jsondata:Name {value: "default_branch"}
    string? defaultBranch?;
    # Determine if developers can push to default branch
    @jsondata:Name {value: "default_branch_protection"}
    0|3|1|2|4? defaultBranchProtection?;
    # Enable model prompt cache for this group
    @jsondata:Name {value: "model_prompt_cache_enabled"}
    boolean? modelPromptCacheEnabled?;
    # Enable automatic reviews by GitLab Duo on merge requests
    @jsondata:Name {value: "auto_duo_code_review_enabled"}
    boolean? autoDuoCodeReviewEnabled?;
    # Enable built-in project templates for project creation
    @jsondata:Name {value: "built_in_project_templates_enabled"}
    boolean? builtInProjectTemplatesEnabled?;
    # A valid access level
    @jsondata:Name {value: "ldap_access"}
    int? ldapAccess?;
    # The description of the group
    string? description?;
    # Prevent sharing a project with another group within this group
    @jsondata:Name {value: "share_with_group_lock"}
    boolean? shareWithGroupLock?;
    # Tool approval for session availability. One of `default_on`, `default_off` or `never_on`
    @jsondata:Name {value: "tool_approval_for_session_availability"}
    "default_on"|"default_off"|"never_on"? toolApprovalForSessionAvailability?;
    # List of user ids who will be emailed when Git abuse rate limit is exceeded
    @jsondata:Name {value: "unique_project_download_limit_alertlist"}
    int[]? uniqueProjectDownloadLimitAlertlist?;
    # Indicates if the GitLab Duo features enabled setting is enforced for all subgroups
    @jsondata:Name {value: "lock_duo_features_enabled"}
    boolean? lockDuoFeaturesEnabled?;
    # Send access token expiry notifications to all inherited members of the group
    @jsondata:Name {value: "resource_access_token_notify_inherited"}
    boolean? resourceAccessTokenNotifyInherited?;
    # LDAP Common Name
    @jsondata:Name {value: "ldap_cn"}
    string? ldapCn?;
    # List of IP addresses which need to be restricted for group
    @jsondata:Name {value: "ip_restriction_ranges"}
    string? ipRestrictionRanges?;
    # References of enabled foundational flows
    @jsondata:Name {value: "enabled_foundational_flows"}
    string[]? enabledFoundationalFlows?;
    # OAuth provider required for step-up authentication. Pass empty string to disable
    @jsondata:Name {value: "step_up_auth_required_oauth_provider"}
    string? stepUpAuthRequiredOauthProvider?;
    # Indicates if math rendering limits are locked for all descendent groups
    @jsondata:Name {value: "lock_math_rendering_limits_enabled"}
    boolean? lockMathRenderingLimitsEnabled?;
    # Allow creation of personal snippets for enterprise users of this group
    @jsondata:Name {value: "allow_personal_snippets"}
    boolean? allowPersonalSnippets?;
    # Duo availability. One of `default_on`, `default_off`, `never_on` or `always_on`
    @jsondata:Name {value: "duo_availability"}
    "always_on"|"default_on"|"default_off"|"never_on"? duoAvailability?;
    # Set the maximum file size for each job's artifacts
    @jsondata:Name {value: "max_artifacts_size"}
    int? maxArtifactsSize?;
    # _(Deprecated)_ Disable email notifications. Use: emails_enabled
    @jsondata:Name {value: "emails_disabled"}
    boolean? emailsDisabled?;
    # Time before Two-factor authentication is enforced
    @jsondata:Name {value: "two_factor_grace_period"}
    int? twoFactorGracePeriod?;
    # Enforce the built-in project templates setting for all subgroups
    @jsondata:Name {value: "lock_built_in_project_templates_enabled"}
    boolean? lockBuiltInProjectTemplatesEnabled?;
    # Avatar image for the group
    record {byte[] fileContent; string fileName;}? avatar?;
    # The ID of a project to use as the Duo Code Review custom instructions template for this group
    @jsondata:Name {value: "duo_template_project_id"}
    int? duoTemplateProjectId?;
    # Enable web based commit signing for this group
    @jsondata:Name {value: "web_based_commit_signing_enabled"}
    boolean? webBasedCommitSigningEnabled?;
    # Only allow to merge if builds succeed
    @jsondata:Name {value: "only_allow_merge_if_pipeline_succeeds"}
    boolean? onlyAllowMergeIfPipelineSucceeds?;
    # When true, records explicit namespace consent for DAP-based Code Review routing
    @jsondata:Name {value: "create_code_review_flow_consent"}
    boolean? createCodeReviewFlowConsent?;
    # Maximum number of unique projects a user can download in the specified time period before they are banned
    @jsondata:Name {value: "unique_project_download_limit"}
    int? uniqueProjectDownloadLimit?;
    # Enable GitLab Duo custom flows for this group
    @jsondata:Name {value: "duo_custom_flows_availability"}
    boolean? duoCustomFlowsAvailability?;
    # Prevent subgroups from overriding the access token expiry notification setting
    @jsondata:Name {value: "lock_resource_access_token_notify_inherited"}
    boolean? lockResourceAccessTokenNotifyInherited?;
    # Prevent forking projects inside this group to external namespaces
    @jsondata:Name {value: "prevent_forking_outside_group"}
    boolean? preventForkingOutsideGroup?;
    # To enforce token expiration for Service accounts users for group
    @jsondata:Name {value: "service_access_tokens_expiration_enforced"}
    boolean? serviceAccessTokensExpirationEnforced?;
};

