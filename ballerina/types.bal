# Request payload for the issue
public type CreateIssueRequest record {
    # The severity of the issue. Only applies to incidents. Accepts: unknown, low, medium, high, critical
    "unknown"|"low"|"medium"|"high"|"critical"? severity?;
    #  Boolean parameter indicating if the issue's discussion is locked
    @jsondata:Name {value: "discussion_locked"}
    boolean? discussionLocked?;
    # The internal ID of a project issue. Available only for admins and project owners
    int? iid?;
    # The ID of a milestone to assign issue. Mutually exclusive with `milestone`
    @jsondata:Name {value: "milestone_id"}
    int? milestoneId?;
    # Date string in the format YEAR-MONTH-DAY
    @jsondata:Name {value: "due_date"}
    string? dueDate?;
    # The type of the issue. Accepts: issue, incident, test_case, requirement, task, ticket
    @jsondata:Name {value: "issue_type"}
    "issue"|"incident"|"test_case"|"requirement"|"task"|"ticket"? issueType?;
    # Date time when the issue was created. Available only for admins and project owners
    @jsondata:Name {value: "created_at"}
    string? createdAt?;
    # The description of an issue
    string? description?;
    # The weight of the issue
    int? weight?;
    # The ID of a discussion to resolve, also pass `merge_request_to_resolve_discussions_of`
    @jsondata:Name {value: "discussion_to_resolve"}
    string? discussionToResolve?;
    # The title of an issue
    string? title;
    # Comma-separated list of label names
    string[]? labels?;
    # Comma-separated list of label names
    @jsondata:Name {value: "remove_labels"}
    string[]? removeLabels?;
    # The IID of a merge request for which to resolve discussions
    @jsondata:Name {value: "merge_request_to_resolve_discussions_of"}
    int? mergeRequestToResolveDiscussionsOf?;
    # The title of a project or ancestor-group milestone to assign the issue to. Mutually exclusive with `milestone_id`
    string? milestone?;
    # The IID of an epic to associate the issue with (deprecated). Mutually exclusive with `epic_id`
    @jsondata:Name {value: "epic_iid"}
    int? epicIid?;
    # Comma-separated list of label names
    @jsondata:Name {value: "add_labels"}
    string[]? addLabels?;
    # The array of user IDs to assign issue
    @jsondata:Name {value: "assignee_ids"}
    int[]? assigneeIds?;
    # [Deprecated] The ID of a user to assign issue
    @jsondata:Name {value: "assignee_id"}
    int? assigneeId?;
    # Date string in the format YEAR-MONTH-DAY
    @jsondata:Name {value: "start_date"}
    string? startDate?;
    # Boolean parameter if the issue should be confidential
    boolean? confidential?;
    # The ID of an epic to associate the issue with. Mutually exclusive with `epic_iid`
    @jsondata:Name {value: "epic_id"}
    int? epicId?;
};

