    # The Microsoft Teams webhook (for example, `https://outlook.office.com/webhook/...`)
    string? webhook;
    # Work item events flag of the microsoft teams integration
    @jsondata:Name {value: "work_item_events"}
    boolean? workItemEvents?;
    # Trigger event when a pipeline status changes
    @jsondata:Name {value: "pipeline_events"}
    boolean? pipelineEvents?;
    # Trigger event when a work item is created, updated, or closed
    @jsondata:Name {value: "issues_events"}
    boolean? issuesEvents?;
    # Trigger event when a merge request is created, updated, or merged
    @jsondata:Name {value: "merge_requests_events"}
    boolean? mergeRequestsEvents?;
    # Trigger event for new comments
    @jsondata:Name {value: "note_events"}
    boolean? noteEvents?;
    # Trigger event for pushes to the repository
    @jsondata:Name {value: "push_events"}
    boolean? pushEvents?;
    # Trigger event for new comments on confidential work items
    @jsondata:Name {value: "confidential_note_events"}
    boolean? confidentialNoteEvents?;
    # Trigger event for new tags pushed to the repository
    @jsondata:Name {value: "tag_push_events"}
    boolean? tagPushEvents?;
    # Branches to send notifications for. Valid options are `all`, `default`, `protected`, and `default_and_protected`. The default value is `default`
    @jsondata:Name {value: "branches_to_be_notified"}
    string? branchesToBeNotified?;
    # Trigger event when a confidential work item is created, updated, or closed
    @jsondata:Name {value: "confidential_issues_events"}
    boolean? confidentialIssuesEvents?;
    # Send notifications only when the pipeline status changes
    @jsondata:Name {value: "notify_only_when_pipeline_status_changes"}
    boolean? notifyOnlyWhenPipelineStatusChanges?;
    # Trigger event when a wiki page is created or updated
    @jsondata:Name {value: "wiki_page_events"}
    boolean? wikiPageEvents?;
};

# Represents the Queries record for the operation: listProjectPackages
public type ListProjectPackagesQueries record {
    # Number of items per page
    @http:Query {name: "per_page"}
    int perPage = 20;
    # Return packages with this version
    @http:Query {name: "package_version"}
    string? packageVersion?;
    # Return packages with this name
    @http:Query {name: "package_name"}
    string? packageName?;
    # Return packages ordered by `created_at`, `name`, `version` or `type` fields
    @http:Query {name: "order_by"}
    "created_at"|"name"|"version"|"type" orderBy = "created_at";
    # Current page number
    int page = 1;
    # Return packages sorted in `asc` or `desc` order
    "asc"|"desc" sort = "asc";
    # Returns packages without a version
    @http:Query {name: "include_versionless"}
    boolean? includeVersionless?;
    # Return packages of a certain type
    @http:Query {name: "package_type"}
    "maven"|"npm"|"conan"|"nuget"|"pypi"|"composer"|"generic"|"golang"|"debian"|"rubygems"|"helm"|"terraform_module"|"rpm"|"ml_model"|"cargo"? packageType?;
    # Return packages with specified status
    "default"|"hidden"|"processing"|"error"|"pending_destruction"|"deprecated"? status?;
};

# Request payload for the feature
public type SetFeatureRequest record {
    # A caller_id identifying a code path, for example `GET /api/v4/projects/:id` or `ProjectsController#show`. Use comma to separate multiple endpoint paths. Mutually exclusive with `key`
    string? endpoint?;
    # An organization ID or path, for example `1` or `default`, or comma-separated multiple organization IDs or paths. Mutually exclusive with `key`
    string? organization?;
    # A GitLab group or user namespace's path, for example `john-doe`, or comma-separated multiple namespace paths. Introduced in GitLab 15.0. Mutually exclusive with `key`
    string? namespace?;
    # A projects path, for example `gitlab-org/gitlab-foss`, or comma-separated multiple project paths. Mutually exclusive with `key`
    string? project?;
    # Skip feature flag validation checks, such as a YAML definition
    boolean? force?;
    # A repository path, for example `gitlab-org/gitlab-test.git`, `gitlab-org/gitlab-test.wiki.git`, `snippets/21.git`, to name a few. Use comma to separate multiple repository paths. Mutually exclusive with `key`
    string? repository?;
    # A runner ID, or comma-separated list of runner IDs. Mutually exclusive with `key`
    string? runner?;
    # `true` or `false` to enable/disable, or an integer for percentage of time
    string|int? value;
    # A GitLab username or comma-separated multiple usernames. Mutually exclusive with `key`
    string? user?;
    # `percentage_of_actors` or `percentage_of_time` (default). Mutually exclusive with `feature_group`, `user`, `group`, `namespace`, `project`, `organization`, `repository`, `runner`, `endpoint`
    string? 'key?;
    # A Feature group name. Mutually exclusive with `key`
    @jsondata:Name {value: "feature_group"}
    string? featureGroup?;
    # A GitLab group's path, for example `gitlab-org`, or comma-separated multiple group paths. Mutually exclusive with `key`
    string? group?;
};

