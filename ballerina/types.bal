# Represents the Queries record for the operation: getCurrentUserIssuesStatistics
public type GetCurrentUserIssuesStatisticsQueries record {
    # Return issues which are not assigned to the user with the given ID. Mutually exclusive with `not[assignee_username]`
    @http:Query {name: "not[assignee_id]"}
    int? notAssigneeId?;
    # Return issues created after the specified time
    @http:Query {name: "created_after"}
    string? createdAfter?;
    # Return issues assigned to milestones with the specified timebox value ("Any", "None", "Upcoming" or "Started"). Mutually exclusive with `milestone`
    @http:Query {name: "milestone_id"}
    "Any"|"None"|"Upcoming"|"Started"? milestoneId?;
    # Return issues reacted by the authenticated user by the given emoji
    @http:Query {name: "my_reaction_emoji"}
    string? myReactionEmoji?;
    # Return issues assigned to milestones without the specified timebox value ("Any", "None", "Upcoming" or "Started"). Mutually exclusive with `not[milestone]`
    @http:Query {name: "not[milestone_id]"}
    "Any"|"None"|"Upcoming"|"Started"? notMilestoneId?;
    # Return issues which are not assigned to the iteration with the given title. Mutually exclusive with `not[iteration_id]`
    @http:Query {name: "not[iteration_title]"}
    string? notIterationTitle?;
    # Search issues for text present in the title, description, or any combination of these
    string? search?;
    # Filters by the specified parameters
    record {}? not?;
    # Return issues which are not assigned to the user with the given username. Mutually exclusive with `not[assignee_id]`
    @http:Query {name: "not[assignee_username]"}
    string[]? notAssigneeUsername?;
    # Return issues for the given scope: `created_by_me`, `assigned_to_me` or `all`
    "created_by_me"|"assigned_to_me"|"all" scope = "created_by_me";
    # The health status of the issue. Must be one of: on_track, needs_attention, at_risk, none, any
    @http:Query {name: "health_status"}
    "on_track"|"needs_attention"|"at_risk"|"none"|"any"? healthStatus?;
    # The IID array of issues
    int[]? iids?;
    # Return issues which are assigned to the user with the given ID. Mutually exclusive with `assignee_username`
    @http:Query {name: "assignee_id"}
    IdOrKeyword assigneeId?;
    # Filter confidential or public issues
    boolean? confidential?;
    # Return issues updated before the specified time
    @http:Query {name: "updated_before"}
    string? updatedBefore?;
    # `title`, `description`, or a string joining them with comma
    string? 'in?;
    # The weight of the issue
    IdOrKeyword weight?;
    # Return issues which are not assigned to the iteration with the given ID. Mutually exclusive with `not[iteration_title]`
    @http:Query {name: "not[iteration_id]"}
    IdOrKeyword notIterationId?;
    # Comma-separated list of label names
    string[]? labels?;
    # Return issues which are not authored by the user with the given username. Mutually exclusive with `not[author_id]`
    @http:Query {name: "not[author_username]"}
    string? notAuthorUsername?;
    # Return issues which are assigned to the iteration with the given ID. Mutually exclusive with `iteration_title`
    @http:Query {name: "iteration_id"}
    IdOrKeyword iterationId?;
    # Comma-separated list of label names
    @http:Query {name: "not[labels]"}
    string[]? notLabels?;
    # Milestone title. Mutually exclusive with `not[milestone_id]`
    @http:Query {name: "not[milestone]"}
    string? notMilestone?;
    # Milestone title. Mutually exclusive with `milestone_id`
    string? milestone?;
    # Return issues created before the specified time
    @http:Query {name: "created_before"}
    string? createdBefore?;
    # Return issues updated after the specified time
    @http:Query {name: "updated_after"}
    string? updatedAfter?;
    # The IID array of issues
    @http:Query {name: "not[iids]"}
    int[]? notIids?;
    # Return issues which are not authored by the user with the given ID. Mutually exclusive with `not[author_username]`
    @http:Query {name: "not[author_id]"}
    int? notAuthorId?;
    # Return issues which are assigned to the iteration with the given title. Mutually exclusive with `iteration_id`
    @http:Query {name: "iteration_title"}
    string? iterationTitle?;
    # Return issues which are authored by the user with the given ID. Mutually exclusive with `author_username`
    @http:Query {name: "author_id"}
    int? authorId?;
    # Return issues without the specified weight
    @http:Query {name: "not[weight]"}
    int? notWeight?;
    # Return issues which are authored by the user with the given username. Mutually exclusive with `author_id`
    @http:Query {name: "author_username"}
    string? authorUsername?;
    # Return issues which are assigned to the user with the given username. Mutually exclusive with `assignee_id`
    @http:Query {name: "assignee_username"}
    string[]? assigneeUsername?;
    # The ID of an epic associated with the issues
    @http:Query {name: "epic_id"}
    IdOrKeyword epicId?;
};

