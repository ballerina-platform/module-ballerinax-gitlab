    # Global search block anonymous searches enabled for the application settings
    @jsondata:Name {value: "global_search_block_anonymous_searches_enabled"}
    string? globalSearchBlockAnonymousSearchesEnabled?;
    # Application sign in restrictions
    @jsondata:Name {value: "sign_in_restrictions"}
    string? signInRestrictions?;
    # The threshold in bytes at which Sidekiq jobs are compressed before being stored in Redis. Default: 100,000 bytes (100 KB)
    @jsondata:Name {value: "sidekiq_job_limiter_compression_threshold_bytes"}
    string? sidekiqJobLimiterCompressionThresholdBytes?;
    # Protected paths for get request raw for the application settings
    @jsondata:Name {value: "protected_paths_for_get_request_raw"}
    string? protectedPathsForGetRequestRaw?;
    # Maximum number of requests per minute for performing a search while authenticated. Default: 30. To disable throttling, set to 0
    @jsondata:Name {value: "search_rate_limit"}
