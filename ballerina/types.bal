# Represents an impersonation token
public type ImpersonationToken record {
    # Impersonation of the impersonation token
    string impersonation?;
    # Time the impersonation token was created
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    # Description of the impersonation token
    string description?;
    # Active flag of the impersonation token
    boolean active?;
    # Granular flag of the impersonation token
    boolean granular?;
    # Whether the impersonation token is revoked
    boolean revoked?;
    # List of granular scopes
    @jsondata:Name {value: "granular_scopes"}
    PersonalAccessTokenGranularScope[] granularScopes?;
    # The five most recent unique IP addresses that have authenticated with this token. When the limit is reached, the oldest IP address is removed. The list updates once per minute per token
    @jsondata:Name {value: "last_used_ips"}
    string[] lastUsedIps?;
    # Time the last was used
    @jsondata:Name {value: "last_used_at"}
    string lastUsedAt?;
    # Time for expires (the impersonation token)
    @jsondata:Name {value: "expires_at"}
    string expiresAt?;
    # ID of the user
    @jsondata:Name {value: "user_id"}
    int userId?;
    # Name of the impersonation token
    string name?;
    # ID of the impersonation token
    int id?;
    # List of scopes
    anydata[] scopes?;
};

