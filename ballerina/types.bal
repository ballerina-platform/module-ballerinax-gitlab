# AI-related settings
public type CreateGroupAiSettingsAttributes record {
    # Enable MCP support for Duo Agent Platform
    @jsondata:Name {value: "duo_workflow_mcp_enabled"}
    boolean? duoWorkflowMcpEnabled?;
    # The minimum access level required to execute Duo Agent Platform features in CI/CD. This field is behind a feature flag
    @jsondata:Name {value: "minimum_access_level_execute_async"}
    30|40|50? minimumAccessLevelExecuteAsync?;
    # The minimum access level required to enable Duo Agent Platform. This field is behind a feature flag
    @jsondata:Name {value: "minimum_access_level_enable_on_projects"}
    30|40|50? minimumAccessLevelEnableOnProjects?;
    # Whether to allow projects to extend the network access domain allowlist
    @jsondata:Name {value: "allow_project_extension"}
    boolean? allowProjectExtension?;
    # Whether to include recommended domains in the network access allowlist
    @jsondata:Name {value: "include_recommended_allowed"}
    boolean? includeRecommendedAllowed?;
    # Whether new foundational agents are enabled by default
    @jsondata:Name {value: "foundational_agents_default_enabled"}
    boolean? foundationalAgentsDefaultEnabled?;
    # Prompt injection protection level. One of `no_checks`, `log_only` or `interrupt`
    @jsondata:Name {value: "prompt_injection_protection_level"}
    "no_checks"|"log_only"|"interrupt"? promptInjectionProtectionLevel?;
    # Allow web search in GitLab Duo Chat for this top-level group
    @jsondata:Name {value: "web_search_enabled"}
    boolean? webSearchEnabled?;
    # Whether to allow all Unix sockets for network access
    @jsondata:Name {value: "allow_all_unix_sockets"}
    boolean? allowAllUnixSockets?;
    # Enable AI usage data collection for this namespace
    @jsondata:Name {value: "ai_usage_data_collection_enabled"}
    boolean? aiUsageDataCollectionEnabled?;
    # The minimum access level required to manage Duo Agent Platform. This field is behind a feature flag
    @jsondata:Name {value: "minimum_access_level_manage"}
    30|40|50? minimumAccessLevelManage?;
    # Whether Duo Agent Platform features are enabled
    @jsondata:Name {value: "duo_agent_platform_enabled"}
    boolean? duoAgentPlatformEnabled?;
    # Confine the AI Catalog to items within this top-level group hierarchy
    @jsondata:Name {value: "ai_catalog_restricted_to_group_hierarchy"}
    boolean? aiCatalogRestrictedToGroupHierarchy?;
    # The minimum access level required to execute Duo Agent Platform. This field is behind a feature flag
    @jsondata:Name {value: "minimum_access_level_execute"}
    10|15|20|30|40|50? minimumAccessLevelExecute?;
};

