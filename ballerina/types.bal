    # Error of the bulk imports export batch status
    string 'error?;
    # Status of the bulk imports export batch status
    "started"|"finished"|"failed" status?;
};

# Represents set suggested reviewers suggestions
public type SetSuggestedReviewersSuggestions record {
    # Model rationale for the recommendation (maximum 2048 characters)
    string? reason?;
    # ID of the approval rule the user was suggested for
    @jsondata:Name {value: "approval_rule_id"}
    int? approvalRuleId?;
    # ID of the recommended user
    @jsondata:Name {value: "user_id"}
    int? userId;
    # Type of the approval rule the user was suggested for
    @jsondata:Name {value: "approval_rule_type"}
    "merge_request_rule"|"project_rule" approvalRuleType;
};

