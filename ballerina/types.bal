    @jsondata:Name {value: "squash_option"}
    "never"|"always"|"default_on"|"default_off"? squashOption?;
    # Allow job retries for rollback deployments
    @jsondata:Name {value: "ci_forward_deployment_rollback_allowed"}
    boolean? ciForwardDeploymentRollbackAllowed?;
    # URL from which the project is imported
    @jsondata:Name {value: "import_url"}
    string? importUrl?;
    # Flag indication if jobs are enabled
    @jsondata:Name {value: "jobs_enabled"}
