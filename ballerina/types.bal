# Request payload for the webhook
public type UpdateProjectWebhookRequest record {
    # Trigger hook on project access token expiry events
    @jsondata:Name {value: "resource_access_token_events"}
    boolean? resourceAccessTokenEvents?;
    # Trigger hook on emoji events
    @jsondata:Name {value: "emoji_events"}
    boolean? emojiEvents?;
    # Trigger hook on issues events
    @jsondata:Name {value: "issues_events"}
    boolean? issuesEvents?;
    # Description of the hook
    string? description?;
    # HMAC signing token used to compute the webhook-signature header. Must be in whsec_<base64> format encoding a 32-byte key. Not returned in the response
    @jsondata:Name {value: "signing_token"}
    string? signingToken?;
    # Filter push events by branch. Possible values are `wildcard` (default), `regex`, and `all_branches`
    @jsondata:Name {value: "branch_filter_strategy"}
    "wildcard"|"regex"|"all_branches"? branchFilterStrategy?;
    # Trigger hook on push events
    @jsondata:Name {value: "push_events"}
    boolean? pushEvents?;
    # Trigger hook on tag push events
    @jsondata:Name {value: "tag_push_events"}
    boolean? tagPushEvents?;
    # Trigger hook on milestone events
    @jsondata:Name {value: "milestone_events"}
    boolean? milestoneEvents?;
    # Trigger hook on specified branch only
    @jsondata:Name {value: "push_events_branch_filter"}
    string? pushEventsBranchFilter?;
    # Trigger hook on wiki events
    @jsondata:Name {value: "wiki_page_events"}
    boolean? wikiPageEvents?;
    # Trigger hook on job events
    @jsondata:Name {value: "job_events"}
    boolean? jobEvents?;
    # Do SSL verification when triggering the hook
    @jsondata:Name {value: "enable_ssl_verification"}
    boolean? enableSslVerification?;
    # Allow Duo Agent Platform flows to send lifecycle and progress events to this webhook. A flow must reference this webhook's ID as callback_hook_id when it starts
    @jsondata:Name {value: "duo_flow_callback_enabled"}
    boolean? duoFlowCallbackEnabled?;
    # Trigger hook on pipeline events
    @jsondata:Name {value: "pipeline_events"}
    boolean? pipelineEvents?;
    # Trigger hook on vulnerability events
    @jsondata:Name {value: "vulnerability_events"}
    boolean? vulnerabilityEvents?;
    # URL variables for interpolation
    @jsondata:Name {value: "url_variables"}
    CreateGroupHookUrlVariables[]? urlVariables?;
    # Trigger hook on feature flag events
    @jsondata:Name {value: "feature_flag_events"}
    boolean? featureFlagEvents?;
    # Trigger hook on deploy token expiry events
    @jsondata:Name {value: "resource_deploy_token_events"}
    boolean? resourceDeployTokenEvents?;
    # Trigger hook on merge request events
    @jsondata:Name {value: "merge_requests_events"}
    boolean? mergeRequestsEvents?;
    # Trigger hook on note (comment) events
    @jsondata:Name {value: "note_events"}
    boolean? noteEvents?;
    # Trigger hook on deployment events
    @jsondata:Name {value: "deployment_events"}
    boolean? deploymentEvents?;
    # The URL to send the request to
    string? url?;
    # Secret token to validate received payloads; this will not be returned in the response
    string? token?;
    # Trigger hook on confidential note (comment) events
    @jsondata:Name {value: "confidential_note_events"}
    boolean? confidentialNoteEvents?;
    # Trigger hook on confidential issues events
    @jsondata:Name {value: "confidential_issues_events"}
    boolean? confidentialIssuesEvents?;
    # Custom template for the request payload
    @jsondata:Name {value: "custom_webhook_template"}
    string? customWebhookTemplate?;
    # Name of the hook
    string? name?;
    # Trigger hook on release events
    @jsondata:Name {value: "releases_events"}
    boolean? releasesEvents?;
    # Custom headers
    @jsondata:Name {value: "custom_headers"}
    CreateGroupHookCustomHeaders[]? customHeaders?;
};

