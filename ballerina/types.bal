    @jsondata:Name {value: "foundational_agents_statuses"}
    string? foundationalAgentsStatuses?;
    # A method call is only tracked when it takes longer to complete than the given amount of milliseconds
    @jsondata:Name {value: "metrics_method_call_threshold"}
    int? metricsMethodCallThreshold?;
    # Flag indicating if password authentication is enabled for the web interface. Mutually exclusive with `password_authentication_enabled`, `signin_enabled`
    @jsondata:Name {value: "password_authentication_enabled_for_web"}
    boolean? passwordAuthenticationEnabledForWeb?;
    # Ban users from the application when they exceed maximum number of unique projects download in the specified time period
    @jsondata:Name {value: "auto_ban_user_on_excessive_projects_download"}
    boolean? autoBanUserOnExcessiveProjectsDownload?;
