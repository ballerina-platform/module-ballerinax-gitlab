# Request payload for application settings
public type UpdateApplicationSettingsRequest record {
    # The Faraday adapter used by the Elasticsearch Ruby Client. Defaults to `typhoeus`. Possible values are `typhoeus` and `net_http`. [Introduced](https://gitlab.com/gitlab-org/gitlab/-/issues/550805) in GitLab 18.5. Premium and Ultimate only
    @jsondata:Name {value: "elasticsearch_client_adapter"}
    string? elasticsearchClientAdapter?;
    # The client secret of the GitLab for Slack app. Used for authenticating OAuth requests from the app
    @jsondata:Name {value: "slack_app_secret"}
    string? slackAppSecret?;
    # Background operations max jobs for the application settings
    @jsondata:Name {value: "background_operations_max_jobs"}
    string? backgroundOperationsMaxJobs?;
    # Restrictions on the complexity of uploaded RSA keys. A value of -1 disables all RSA keys
    @jsondata:Name {value: "rsa_key_restriction"}
    0|1024|2048|3072|4096|-1? rsaKeyRestriction?;
    # Maximum number of requests per minute per job token for requests to `/jobs/*` requests to the runner jobs API endpoints. Default: 200. To disable throttling, set to 0. [Introduced](https://gitlab.com/gitlab-org/gitlab/-/issues/462537) in GitLab 18.5
    @jsondata:Name {value: "runner_jobs_endpoints_api_limit"}
    string? runnerJobsEndpointsApiLimit?;
    # The URL of the external Spam Check service endpoint
    @jsondata:Name {value: "spam_check_endpoint_url"}
    string? spamCheckEndpointUrl?;
    # Number of days before security scan data is considered stale (7-90)
    @jsondata:Name {value: "security_scan_stale_after_days"}
    int? securityScanStaleAfterDays?;
    # Disable invite members functionality for group
    @jsondata:Name {value: "disable_invite_members"}
    string? disableInviteMembers?;
    # Zoekt cache response for the application settings
    @jsondata:Name {value: "zoekt_cache_response"}
    string? zoektCacheResponse?;
    # Default preferred language for users who are not logged in
    @jsondata:Name {value: "default_preferred_language"}
    string? defaultPreferredLanguage?;
    # List of trusted domains or IP addresses to which local requests are allowed when local requests for webhooks and integrations are disabled
    @jsondata:Name {value: "outbound_local_requests_whitelist"}
    string[]? outboundLocalRequestsWhitelist?;
    # Maximum allowed size in MiB for Gzip-compressed HTTP responses from outbound requests after decompression. 0 for unlimited
