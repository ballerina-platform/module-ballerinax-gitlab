    @jsondata:Name {value: "access_level"}
    "not_protected"|"ref_protected"? accessLevel?;
    # Specifies if the runner should ignore new jobs. Mutually exclusive with `active`
    boolean? paused?;
    # Maximum timeout that limits the amount of time (in seconds) that runners can run jobs
    @jsondata:Name {value: "maximum_timeout"}
    int? maximumTimeout?;
    # Free-form maintenance notes for the runner (1024 characters)
    @jsondata:Name {value: "maintenance_note"}
    string? maintenanceNote?;
    # The list of tags for a runner
    @jsondata:Name {value: "tag_list"}
    string[]? tagList?;
    # The description of the runner
    string? description?;
    # Deprecated: Use `paused` instead. Flag indicating whether the runner is allowed to receive jobs. Mutually exclusive with `paused`
    boolean? active?;
    # Specifies if the runner can execute untagged jobs
    @jsondata:Name {value: "run_untagged"}
    boolean? runUntagged?;
    # Specifies if the runner is locked
    boolean? locked?;
};

