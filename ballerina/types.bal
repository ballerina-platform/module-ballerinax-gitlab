# Request payload for the workflow checkpoint
public type CreateWorkflowCheckpointRequest record {
    # Checkpoint content
    record {}? checkpoint?;
    # The parent ts
    @jsondata:Name {value: "parent_ts"}
    string? parentTs?;
    # Checkpoint metadata
    record {}? metadata;
    # Thread grouping hint for blob reconstruction
    @jsondata:Name {value: "current_thread"}
    int currentThread = 0;
    # The thread ts
    @jsondata:Name {value: "thread_ts"}
    string? threadTs;
    # LangGraph checkpoint namespace this checkpoint belongs to. Omitted (or blank) for the flow's own top-level checkpoint lineage; set to LangGraph's namespace string for one nested subgraph invocation, e.g. a delegated subagent dispatched by DelegationNode
    @jsondata:Name {value: "checkpoint_ns"}
    string? checkpointNs?;
    # Live channel membership of the checkpoint
    @jsondata:Name {value: "channel_keys"}
    string[]? channelKeys?;
    # Checkpoint content zlib compressed and base64 encoded
    @jsondata:Name {value: "compressed_checkpoint"}
    string? compressedCheckpoint?;
    # JSON string of the model metadata
    @jsondata:Name {value: "model_metadata_json"}
    string? modelMetadataJson?;
    # Per-channel blobs for incremental checkpoint storage
    @jsondata:Name {value: "channel_blobs"}
    CreateWorkflowCheckpointChannelBlobs[]? channelBlobs?;
    # JSON string of the flow metadata
    @jsondata:Name {value: "flow_metadata_json"}
    string? flowMetadataJson?;
};

