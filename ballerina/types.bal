# Request payload for the approval config
public type SetProjectApprovalConfigRequest record {
    # Should the approval count be reset on a new push
    @jsondata:Name {value: "reset_approvals_on_push"}
    boolean? resetApprovalsOnPush?;
    # Should approvers authenticate via password before adding approval
    @jsondata:Name {value: "require_password_to_approve"}
    boolean? requirePasswordToApprove?;
    # Reset approvals from Code Owners if their files changed
    @jsondata:Name {value: "selective_code_owner_removals"}
    boolean? selectiveCodeOwnerRemovals?;
    # Should merge request authors be able to self approve merge requests; `true` means authors cannot self approve
    @jsondata:Name {value: "merge_requests_author_approval"}
    boolean? mergeRequestsAuthorApproval?;
    # Should approvers authenticate via password or SAML before adding approval
    @jsondata:Name {value: "require_reauthentication_to_approve"}
    boolean? requireReauthenticationToApprove?;
    # Should MRs be able to override approvers and approval count
    @jsondata:Name {value: "disable_overriding_approvers_per_merge_request"}
    boolean? disableOverridingApproversPerMergeRequest?;
    # Should committers be able to self approve merge requests
    @jsondata:Name {value: "merge_requests_disable_committers_approval"}
    boolean? mergeRequestsDisableCommittersApproval?;
    # The amount of approvals required before an MR can be merged
    @jsondata:Name {value: "approvals_before_merge"}
    int? approvalsBeforeMerge?;
};

