# Represents the Queries record for the operation: listProjectMergeRequests
public type ListProjectMergeRequestsQueries record {
    # `<Negated>` Returns merge requests assigned to the given user `id`. `None` returns unassigned merge requests. `Any` returns merge requests with an assignee. Mutually exclusive with `not[assignee_username]`
    @http:Query {name: "not[assignee_id]"}
    IdOrKeyword notAssigneeId?;
    # Returns merge requests deployed after the given date/time. Expected in ISO 8601 format
    @http:Query {name: "deployed_after"}
    string? deployedAfter?;
    # Returns merge requests created on or after the given time. Expected in ISO 8601 format
    @http:Query {name: "created_after"}
    string? createdAfter?;
    # Returns merge requests which have been merged by the user with the given user `id`. Mutually exclusive with `merge_user_username`
    @http:Query {name: "merge_user_id"}
    int? mergeUserId?;
    # Returns merge requests reacted by the authenticated user by the given `emoji`. `None` returns issues not given a reaction. `Any` returns issues given at least one reaction
    @http:Query {name: "my_reaction_emoji"}
    string? myReactionEmoji?;
    # Returns merge requests merged on or after the given time. Expected in ISO 8601 format
    @http:Query {name: "merged_after"}
    string? mergedAfter?;
    # If simple, returns the `iid`, URL, title, description, and basic state of merge request
    "simple"? view?;
    # Filter merge requests against their `draft` status. `true` to return only draft merge requests, `false` to return non-draft merge requests. Mutually exclusive with `wip`
    boolean? draft?;
    # Returns `all` merge requests or just those that are `opened`, `closed`, `locked`, or `merged`
    "opened"|"closed"|"locked"|"merged"|"all" state = "all";
    # `<Negated>` Returns merge requests which have the user as a reviewer with the given user `id`. `None` returns merge requests with no reviewers. `Any` returns merge requests with any reviewer. Mutually exclusive with `not[reviewer_username]`
    @http:Query {name: "not[reviewer_id]"}
    int? notReviewerId?;
    # Returns the request having the given `iid`
    int[]? iids?;
    # Return merge requests which have been approved by the specified users with the given
    #             usernames. Mutually exclusive with `approved_by_ids`
    @http:Query {name: "approved_by_usernames"}
    ListOrKeyword approvedByUsernames?;
    # Number of items per page
    @http:Query {name: "per_page"}
    int perPage = 20;
    # Returns merge requests deployed before the given date/time. Expected in ISO 8601 format
    @http:Query {name: "deployed_before"}
    string? deployedBefore?;
    # Modify the scope of the search attribute. `title`, `description`, or a string joining them with comma
    string? 'in?;
    # Returns merge requests with the given target branch
    @http:Query {name: "target_branch"}
    string? targetBranch?;
    # Returns merge requests sorted in `asc` or `desc` order
    "asc"|"desc" sort = "desc";
    # Returns merge requests matching a comma-separated list of labels. `None` lists all merge requests with no labels. `Any` lists all merge requests with at least one label. Predefined names are case-insensitive
    string[]? labels?;
    # `<Negated>` Returns merge requests created by the given `username`. Mutually exclusive with `not[author_id]`
    @http:Query {name: "not[author_username]"}
    string? notAuthorUsername?;
    # `<Negated>` Returns merge requests matching a comma-separated list of labels. `None` lists all merge requests with no labels. `Any` lists all merge requests with at least one label. Predefined names are case-insensitive
    @http:Query {name: "not[labels]"}
    string[]? notLabels?;
    # `<Negated>` Returns merge requests for a specific milestone. `None` returns merge requests with no milestone. `Any` returns merge requests that have an assigned milestone
    @http:Query {name: "not[milestone]"}
    string? notMilestone?;
    # Returns merge requests created on or before the given time. Expected in ISO 8601 format
    @http:Query {name: "created_before"}
    string? createdBefore?;
    # `<Negated>` Returns merge requests created by the given user `id`. Combine with `scope=all` or `scope=assigned_to_me`. Mutually exclusive with `not[author_username]`
    @http:Query {name: "not[author_id]"}
    int? notAuthorId?;
    # Return merge requests which have specified the users with the given IDs as an individual approver
    @http:Query {name: "approver_ids"}
    ListOrKeyword approverIds?;
    # Current page number
    int page = 1;
    # Returns merge requests created by the given user `id`. Combine with `scope=all` or `scope=assigned_to_me`. Mutually exclusive with `author_username`
    @http:Query {name: "author_id"}
    int? authorId?;
    # If `true`, this projection requests (but does not guarantee) that the `merge_status` field be recalculated asynchronously. Introduced in GitLab 13.0
    @http:Query {name: "with_merge_status_recheck"}
    boolean withMergeStatusRecheck = false;
    # Return merge requests which have been approved by the specified users with the given IDs. Mutually exclusive with `approved_by_usernames`
    @http:Query {name: "approved_by_ids"}
    ListOrKeyword approvedByIds?;
    # Returns merge requests with the given source branch
    @http:Query {name: "source_branch"}
    string? sourceBranch?;
    # Returns merge requests merged on or before the given time. Expected in ISO 8601 format
    @http:Query {name: "merged_before"}
    string? mergedBefore?;
    # Search merge requests against their `title` and `description`
    string? search?;
    # Returns merge requests that do not match the parameters supplied
    record {}? not?;
    # `<Negated>` Returns merge requests created by the given `username`. Mutually exclusive with `not[assignee_id]`
    @http:Query {name: "not[assignee_username]"}
    string[]? notAssigneeUsername?;
    # Returns merge requests for the given scope: `created_by_me`, `assigned_to_me`, `reviews_for_me` or `all`
    "created-by-me"|"assigned-to-me"|"created_by_me"|"assigned_to_me"|"reviews_for_me"|"all"? scope?;
    # Returns merge requests assigned to the given user `id`. `None` returns unassigned merge requests. `Any` returns merge requests with an assignee. Mutually exclusive with `assignee_username`
    @http:Query {name: "assignee_id"}
    IdOrKeyword assigneeId?;
    # Returns merge requests which have the user as a reviewer with the given `username`. `None` returns merge requests with no reviewers. `Any` returns merge requests with any reviewer. Introduced in GitLab 13.8. Mutually exclusive with `reviewer_id`
    @http:Query {name: "reviewer_username"}
    string? reviewerUsername?;
    # If `true`, response returns more details for each label in labels field: `:name`,`:color`, `:description`, `:description_html`, `:text_color`
    @http:Query {name: "with_labels_details"}
    boolean withLabelsDetails = false;
    # Deprecated. Use `draft` instead. Filter merge requests against their `wip` status. `yes` to return only draft merge requests, `no` to return non-draft merge requests. Mutually exclusive with `draft`
    "yes"|"no"? wip?;
    # Returns merge requests updated on or before the given time. Expected in ISO 8601 format
    @http:Query {name: "updated_before"}
    string? updatedBefore?;
    # Returns merge requests with the given source project id
    @http:Query {name: "source_project_id"}
    int? sourceProjectId?;
    # `<Negated>` Returns merge requests reacted by the authenticated user by the given `emoji`. `None` returns issues not given a reaction. `Any` returns issues given at least one reaction
    @http:Query {name: "not[my_reaction_emoji]"}
    string? notMyReactionEmoji?;
    # Returns merge requests deployed to the given environment
    string? environment?;
    # Returns merge requests for a specific milestone. `None` returns merge requests with no milestone. `Any` returns merge requests that have an assigned milestone
    string? milestone?;
    # `<Negated>` Returns merge requests which have the user as a reviewer with the given `username`. `None` returns merge requests with no reviewers. `Any` returns merge requests with any reviewer. Introduced in GitLab 13.8. Mutually exclusive with `not[reviewer_id]`
    @http:Query {name: "not[reviewer_username]"}
    string? notReviewerUsername?;
    # Returns merge requests which have the user as a reviewer with the given user `id`. `None` returns merge requests with no reviewers. `Any` returns merge requests with any reviewer. Mutually exclusive with `reviewer_username`
    @http:Query {name: "reviewer_id"}
    IdOrKeyword reviewerId?;
    # Returns merge requests updated on or after the given time. Expected in ISO 8601 format
    @http:Query {name: "updated_after"}
    string? updatedAfter?;
    # Returns merge requests ordered by `created_at`, `label_priority`, `milestone_due`, `popularity`, `priority`, `title`, `updated_at` or `merged_at` fields. Introduced in GitLab 14.8
    @http:Query {name: "order_by"}
    "created_at"|"label_priority"|"milestone_due"|"popularity"|"priority"|"title"|"updated_at"|"merged_at" orderBy = "created_at";
    # Returns merge requests which have been merged by the user with the given `username`. Mutually exclusive with `merge_user_id`
    @http:Query {name: "merge_user_username"}
    string? mergeUserUsername?;
    # Returns merge requests created by the given `username`. Mutually exclusive with `author_id`
    @http:Query {name: "author_username"}
    string? authorUsername?;
    # Returns merge requests created by the given `username`. Mutually exclusive with `assignee_id`
    @http:Query {name: "assignee_username"}
    string[]? assigneeUsername?;
};

