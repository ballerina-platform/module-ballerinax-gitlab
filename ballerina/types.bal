};

# Represents the Queries record for the operation: listTodos
public type ListTodosQueries record {
    # Number of items per page
    @http:Query {name: "per_page"}
    int perPage = 20;
    # The ID of a project
    @http:Query {name: "project_id"}
    int? projectId?;
    # The ID of a group
    @http:Query {name: "group_id"}
    int? groupId?;
    # The action to be filtered
    "assigned"|"review_requested"|"mentioned"|"build_failed"|"marked"|"approval_required"|"unmergeable"|"directly_addressed"|"member_access_requested"|"review_submitted"|"ssh_key_expired"|"ssh_key_expiring_soon"|"transfer_failed"|"merge_train_removed"|"okr_checkin_requested"|"added_approver"|"duo_pro_access_granted"|"duo_enterprise_access_granted"|"duo_core_access_granted"|"duo_workflow_input_required"? action?;
    # Current page number
    int page = 1;
    # The state of the to-do item
    "pending"|"done"? state?;
    # The ID of an author
    @http:Query {name: "author_id"}
    int? authorId?;
    # The type of to-do item
    "Commit"|"Issue"|"WorkItem"|"MergeRequest"|"DesignManagement::Design"|"AlertManagement::Alert"|"Namespace"|"Project"|"Key"|"WikiPage::Meta"|"Epic"|"Vulnerability"|"User"|"ComplianceManagement::Projects::ComplianceViolation"|"Ai::DuoWorkflows::Workflow"? 'type?;
};

# Request payload for the google play integration
public type GooglePlayIntegrationRequest record {
    # File name of the Google Play service account key
    @jsondata:Name {value: "service_account_key_file_name"}
    string? serviceAccountKeyFileName;
    # Indicates whether to inherit the default settings. Defaults to `false`
    @jsondata:Name {value: "use_inherited_settings"}
    boolean? useInheritedSettings?;
    # Google Play service account key
    @jsondata:Name {value: "service_account_key"}
    string? serviceAccountKey;
    # Set variables on protected branches and tags only
    @jsondata:Name {value: "google_play_protected_refs"}
    boolean? googlePlayProtectedRefs?;
    # Package name of the app in Google Play
    @jsondata:Name {value: "package_name"}
    string? packageName;
};

