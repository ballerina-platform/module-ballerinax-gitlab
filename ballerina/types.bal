    @jsondata:Name {value: "resource_group_default_process_mode"}
    "unordered"|"oldest_first"|"newest_first"|"newest_ready_first"? resourceGroupDefaultProcessMode?;
    # Allow users to request member access
    @jsondata:Name {value: "request_access_enabled"}
    boolean? requestAccessEnabled?;
    # Enforce auth check on uploads
    @jsondata:Name {value: "enforce_auth_checks_on_uploads"}
    boolean? enforceAuthChecksOnUploads?;
