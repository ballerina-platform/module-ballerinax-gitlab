    # Enable PlantUML diagram proxy. Default is `false`
    @jsondata:Name {value: "plantuml_diagram_proxy_enabled"}
    string? plantumlDiagramProxyEnabled?;
    # Deny all requests except allowed for the application settings
    @jsondata:Name {value: "deny_all_requests_except_allowed"}
    string? denyAllRequestsExceptAllowed?;
    # Error tracking API URL for the application settings
    @jsondata:Name {value: "error_tracking_api_url"}
    string? errorTrackingApiUrl?;
    # Secret detection service auth token for the application settings
    @jsondata:Name {value: "secret_detection_service_auth_token"}
    string? secretDetectionServiceAuthToken?;
    # Restrictions on the complexity of uploaded DSA keys. A value of -1 disables all DSA keys
    @jsondata:Name {value: "dsa_key_restriction"}
    0|1024|2048|3072|-1? dsaKeyRestriction?;
    # The Kroki server URL
    @jsondata:Name {value: "kroki_url"}
    string? krokiUrl?;
    # Maximum size of repository and wiki files that are indexed by Elasticsearch. Premium and Ultimate only
    @jsondata:Name {value: "elasticsearch_indexed_file_size_limit_kb"}
    string? elasticsearchIndexedFileSizeLimitKb?;
    # The time window, in seconds, before new CI partitions are created and the system switches to the next set of partitions. Must be between 1 month and 6 months. Default is 1 month (`2592000`). Write-only. Not returned in GET responses. Deprecated in favor of `ci_partitions_in_seconds_limit_human_readable` and is scheduled for removal in API v5
    @jsondata:Name {value: "ci_partitions_in_seconds_limit"}
    string? ciPartitionsInSecondsLimit?;
    # The maximum number of personal projects
    @jsondata:Name {value: "default_projects_limit"}
    int? defaultProjectsLimit?;
    # Enable Sourcegraph
    @jsondata:Name {value: "sourcegraph_enabled"}
    boolean? sourcegraphEnabled?;
    # Generate private key at http://www.google.com/recaptcha
    @jsondata:Name {value: "recaptcha_private_key"}
    string? recaptchaPrivateKey?;
    # Resource access token notify inherited for the application settings
    @jsondata:Name {value: "resource_access_token_notify_inherited"}
    string? resourceAccessTokenNotifyInherited?;
    # The default project visibility
    @jsondata:Name {value: "default_project_visibility"}
    "private"|"internal"|"public"? defaultProjectVisibility?;
    # Allows a user to create top-level-groups. Default is `true`
    @jsondata:Name {value: "top_level_group_creation_enabled"}
    string? topLevelGroupCreationEnabled?;
    # Shared runners text 
    @jsondata:Name {value: "shared_runners_text"}
    string? sharedRunnersText?;
    # Maximum number of requests per minute per user per group to the group audit events API
    @jsondata:Name {value: "group_audit_events_api_limit"}
    int? groupAuditEventsApiLimit?;
    # Maximum requests per period per user
    @jsondata:Name {value: "throttle_authenticated_web_requests_per_period"}
    string? throttleAuthenticatedWebRequestsPerPeriod?;
    # The signing secret of the GitLab for Slack app. Used for authenticating API requests from the app
    @jsondata:Name {value: "slack_app_signing_secret"}
    string? slackAppSigningSecret?;
    # Maximum size in bytes of the Terraform state file. Set this to 0 for unlimited file size
    @jsondata:Name {value: "max_terraform_state_size_bytes"}
    int? maxTerraformStateSizeBytes?;
    # Rate limit for authenticated requests to users autocomplete endpoint
    @jsondata:Name {value: "autocomplete_users_unauthenticated_limit"}
    int? autocompleteUsersUnauthenticatedLimit?;
    # Throttle incident management notification per period for the application settings
    @jsondata:Name {value: "throttle_incident_management_notification_per_period"}
    string? throttleIncidentManagementNotificationPerPeriod?;
    # Disable Merge request author ability to approve request
    @jsondata:Name {value: "prevent_merge_requests_author_approval"}
    boolean? preventMergeRequestsAuthorApproval?;
    # Maximum number of active merge request approval policies per security policy project. Default: 5. Maximum: 20
    @jsondata:Name {value: "security_approval_policies_limit"}
    string? securityApprovalPoliciesLimit?;
    # Do not display offers from third parties in GitLab
    @jsondata:Name {value: "hide_third_party_offers"}
    string? hideThirdPartyOffers?;
    # Enabling this permits automatic allocation of purchased storage in a namespace. Relevant only to EE distributions
    @jsondata:Name {value: "automatic_purchased_storage_allocation"}
    string? automaticPurchasedStorageAllocation?;
    # Disable Merge request committer ability to approve request
    @jsondata:Name {value: "prevent_merge_requests_committers_approval"}
    boolean? preventMergeRequestsCommittersApproval?;
    # Secret access key for the EKS integration IAM user
    @jsondata:Name {value: "eks_secret_access_key"}
    string? eksSecretAccessKey?;
    # Custom text displayed on the help page
    @jsondata:Name {value: "help_page_text"}
    string? helpPageText?;
    # (**If enabled, requires**: `terms`) Enforce application ToS to all users
    @jsondata:Name {value: "enforce_terms"}
    string? enforceTerms?;
    # URL of the GitLab instance used as a proxy for the GitLab for Jira Cloud app
    @jsondata:Name {value: "jira_connect_proxy_url"}
    string? jiraConnectProxyUrl?;
    # Allow top level group owners to create service accounts for the application settings
    @jsondata:Name {value: "allow_top_level_group_owners_to_create_service_accounts"}
    string? allowTopLevelGroupOwnersToCreateServiceAccounts?;
    # The time window before new CI partitions are created and the system switches to the next set of partitions. Must be between `1 month` and `6 months`. Defaults to `1 month`
    @jsondata:Name {value: "ci_partitions_in_seconds_limit_human_readable"}
    string? ciPartitionsInSecondsLimitHumanReadable?;
    # Search max shard size gb for the application settings
    @jsondata:Name {value: "search_max_shard_size_gb"}
    string? searchMaxShardSizeGb?;
    # Maximum time (in minutes) between updates that a mirror can have when scheduled to synchronize. Premium and Ultimate only
    @jsondata:Name {value: "mirror_max_delay"}
    string? mirrorMaxDelay?;
    # When `false`, only integrations in `allowed_integrations` are allowed on the instance. Ultimate only
    @jsondata:Name {value: "allow_all_integrations"}
    string? allowAllIntegrations?;
    # When rate limiting is enabled via the `throttle_*` settings, send this plain text response when a rate limit is exceeded. 'Retry later' is sent if this is blank
    @jsondata:Name {value: "rate_limiting_response_text"}
    string? rateLimitingResponseText?;
    # Enabling this makes only licensed EE features available to projects if the project namespace's plan includes the feature or if the project is public. Premium and Ultimate only
    @jsondata:Name {value: "check_namespace_plan"}
    string? checkNamespacePlan?;
    # Enable Jenkins migration banner
    @jsondata:Name {value: "show_migrate_from_jenkins_banner"}
    boolean? showMigrateFromJenkinsBanner?;
    # Disable certain OAuth sign-in sources
    @jsondata:Name {value: "disabled_oauth_sign_in_sources"}
    string[]? disabledOauthSignInSources?;
    # Turn on incremental logging for job logs
    @jsondata:Name {value: "ci_job_live_trace_enabled"}
    boolean? ciJobLiveTraceEnabled?;
    # To enforce token expiration for Service accounts users
    @jsondata:Name {value: "service_access_tokens_expiration_enforced"}
    boolean? serviceAccessTokensExpirationEnforced?;
    # Disable display of RSS/Atom and Calendar `feed_tokens`
    @jsondata:Name {value: "disable_feed_token"}
    boolean? disableFeedToken?;
};

# Request payload for the user
public type UpdateUserRequest record {
    # Admin note for this user
    string? note?;
    # Flag indicating the user has a private profile
    @jsondata:Name {value: "private_profile"}
    boolean? privateProfile?;
    # The commit email, _private for private commit email
    @jsondata:Name {value: "commit_email"}
    string? commitEmail?;
    # The GitLab theme for the user
    @jsondata:Name {value: "theme_id"}
    int? themeId?;
    # The number of projects a user can create
    @jsondata:Name {value: "projects_limit"}
    int? projectsLimit?;
    # The biography of the user
    string? bio?;
    # Flag indicating the user is an administrator
    boolean? admin?;
    # The LinkedIn username
    string? linkedin?;
    # Flag indicating the user can create groups
    @jsondata:Name {value: "can_create_group"}
    boolean? canCreateGroup?;
    # The password of the new user
    string? password?;
    # The Twitter username
    string? twitter?;
    # The color scheme for the file viewer
    @jsondata:Name {value: "color_scheme_id"}
    int? colorSchemeId?;
    # The external provider
    string? provider?;
    # The email of the user
    string? email?;
    # The external authentication provider UID
    @jsondata:Name {value: "extern_uid"}
    string? externUid?;
    # The GitHub username
    string? github?;
    # Compute minutes quota for this user
    @jsondata:Name {value: "shared_runners_minutes_limit"}
    int? sharedRunnersMinutesLimit?;
    # Flag indicating the account skips the confirmation by email
    @jsondata:Name {value: "skip_reconfirmation"}
    boolean? skipReconfirmation?;
    # Flag indicating auditor status of the user
    boolean? auditor?;
    # Avatar image for user
    record {byte[] fileContent; string fileName;}? avatar?;
    # Flag indicating the user sees only one file diff per page
    @jsondata:Name {value: "view_diffs_file_by_file"}
    boolean? viewDiffsFileByFile?;
    # Flag indicating the user is an external user
    boolean? 'external?;
    # The Discord user ID
    string? discord?;
    # The website of the user
    @jsondata:Name {value: "website_url"}
    string? websiteUrl?;
    # ID for group where SAML has been configured
    @jsondata:Name {value: "group_id_for_saml"}
    int? groupIdForSaml?;
    # (admin-only) Extra compute minutes quota for this user
    @jsondata:Name {value: "extra_shared_runners_minutes_limit"}
    int? extraSharedRunnersMinutesLimit?;
    # The organization of the user. Empty string or nil clears the field
    string? organization?;
    # Flag indicating that advanced editor is enabled
    @jsondata:Name {value: "policy_advanced_editor"}
    boolean? policyAdvancedEditor?;
    # The name of the user
    string? name?;
    # The location of the user
    string? location?;
    # The pronouns of the user
    string? pronouns?;
    # The public email of the user
    @jsondata:Name {value: "public_email"}
    string? publicEmail?;
    # The username of the user
    string? username?;
};

# Represents a CI pipeline
public type CiPipeline record {
    # Coverage of the CI pipeline
    float coverage?;
    # Before SHA of the CI pipeline
    @jsondata:Name {value: "before_sha"}
    string beforeSha?;
    # Detailed status of the CI pipeline
    @jsondata:Name {value: "detailed_status"}
    DetailedStatus detailedStatus?;
    # Time the CI pipeline was finished
    @jsondata:Name {value: "finished_at"}
    string finishedAt?;
    # Internal ID of the CI pipeline, unique within its project or group
    int iid?;
    # Time the CI pipeline was created
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    # Source of the CI pipeline
    string 'source?;
    # SHA of the CI pipeline
    string sha?;
    # Time spent enqueued in seconds
    @jsondata:Name {value: "queued_duration"}
    int queuedDuration?;
    # YAML errors of the CI pipeline
    @jsondata:Name {value: "yaml_errors"}
    string yamlErrors?;
    # Time spent running in seconds
    int duration?;
    # Whether the CI pipeline is archived
    boolean archived?;
    # Ref of the CI pipeline
    string ref?;
    # Time the CI pipeline was last updated
    @jsondata:Name {value: "updated_at"}
    string updatedAt?;
    # URL of the CI pipeline in the GitLab web interface
    @jsondata:Name {value: "web_url"}
    string webUrl?;
    # ID of the project
    @jsondata:Name {value: "project_id"}
    int projectId?;
    # Time the CI pipeline was committed
    @jsondata:Name {value: "committed_at"}
    string committedAt?;
    # Time the CI pipeline was started
    @jsondata:Name {value: "started_at"}
    string startedAt?;
    # ID of the CI pipeline
    int id?;
    # Tag flag of the CI pipeline
    boolean tag?;
    # Represents an user basic
    UserBasic user?;
    # Status of the CI pipeline
    string status?;
};

