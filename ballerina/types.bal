    "active"|"inactive"? state?;
    # Sort tokens
    string? sort?;
    # Current page number
    int page = 1;
    # Filter tokens where revoked state matches parameter
    boolean? revoked?;
    # Filter tokens which expire before given datetime
    @http:Query {name: "expires_before"}
    string? expiresBefore?;
};

