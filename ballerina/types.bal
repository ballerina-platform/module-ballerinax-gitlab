# Represents an issue basic
public type IssueBasic record {
    # Discussion locked flag of the issue
    @jsondata:Name {value: "discussion_locked"}
    boolean discussionLocked?;
    # Upvotes of the issue
    int upvotes?;
    # Internal ID of the issue, unique within its project or group
    int iid?;
    # Number of merge requests
