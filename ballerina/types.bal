# Request payload for the flow
public type CreateFlowRequest record {
    # IID of the MergeRequest noteable that the workflow is associated with
    @jsondata:Name {value: "merge_request_id"}
    int? mergeRequestId?;
    # ID of a webhook with GitLab Duo flow callbacks enabled. When provided, GitLab POSTs flow lifecycle events to that webhook so the client does not have to poll. The hook must belong to the project or namespace the flow runs in, or to one of its ancestor groups
    @jsondata:Name {value: "callback_hook_id"}
    int? callbackHookId?;
    # Container image to use for running the workflow in CI pipeline
    string? image?;
    # An opaque string echoed back in every callback payload, useful for correlating callbacks to the triggering request
    @jsondata:Name {value: "client_reference"}
    string? clientReference?;
    # Goal of the workflow
    string? goal?;
    # The actions the agent can perform without asking for approval
    @jsondata:Name {value: "pre_approved_agent_privileges"}
    int[]? preApprovedAgentPrivileges?;
    # IID of the Issue noteable that the workflow is associated with
    @jsondata:Name {value: "issue_id"}
    int? issueId?;
    # The actions the agent is allowed to perform
    @jsondata:Name {value: "agent_privileges"}
    int[]? agentPrivileges?;
    # workflow type based on its capability
    @jsondata:Name {value: "workflow_definition"}
    string? workflowDefinition?;
    # Additional Context required by the Flow, in JSON format. Contains an array of context details, where each detail is a Hash with a minimum of "Category" and "Content" keys
    @jsondata:Name {value: "additional_context"}
    CreateWorkflowPersistenceAdditionalContext[]? additionalContext?;
    # Where the session was triggered from
    "merge_request_code_conflict"|"merge_request_dependency_bump"|"merge_request_fix_pipeline"|"merge_request_resolve_discussion"|"work_item_to_merge_request"|"fix_pipeline"|"convert_platform_ci_pipeline"|"duo_cli_interactive"|"duo_cli_run"|"duo_cli_acp"|"ide_extension"? 'source?;
    # Optional parameter to start workflow in a CI pipeline.This feature is currently in an experimental state
    @jsondata:Name {value: "start_workflow"}
    boolean? startWorkflow?;
    # Source branch for the CI pipeline. Uses default branch when not specified
    @jsondata:Name {value: "source_branch"}
    string? sourceBranch?;
    # Environment for the workflow
    "ide"|"web"|"chat_partial"|"chat"|"ambient"|"external"? environment?;
    # The ID or path of the workflow namespace
    @jsondata:Name {value: "namespace_id"}
    string? namespaceId?;
    # When this is enabled Duo Agent Platform may stop to ask the user questions before proceeding. When it is disabled Duo Agent Platform will always just run through the workflow without ever asking for user input. Defaults to true
    @jsondata:Name {value: "allow_agent_to_request_user"}
    boolean? allowAgentToRequestUser?;
    # The ID or path of the workflow project
    @jsondata:Name {value: "project_id"}
    string? projectId?;
    # The ID of AI Catalog ItemVersion that sourced flow config used by the workflow
    @jsondata:Name {value: "ai_catalog_item_version_id"}
    int? aiCatalogItemVersionId?;
    # The ID of AI Catalog ItemConsumer that configures which catalog item to execute
    @jsondata:Name {value: "ai_catalog_item_consumer_id"}
    int? aiCatalogItemConsumerId?;
};

