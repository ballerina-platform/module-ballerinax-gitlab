# Represents the Queries record for the operation: validateExistingCiConfig
public type ValidateExistingCiConfigQueries record {
    # Branch or tag used as context when executing a dry run. Defaults to the default branch of the project. Only used when dry_run is true. Mutually exclusive with `ref`
    @http:Query {name: "dry_run_ref"}
    string? dryRunRef?;
    # Deprecated: Use dry_run_ref instead. Mutually exclusive with `dry_run_ref`
    string? ref?;
    # If the list of jobs that would exist in a static check or pipeline
    #         simulation should be included in the response. This is false by default
    @http:Query {name: "include_jobs"}
    boolean? includeJobs?;
    # Run pipeline creation simulation, or only do static check. This is false by default
    @http:Query {name: "dry_run"}
    boolean dryRun = false;
    # Deprecated: Use content_ref instead. Mutually exclusive with `content_ref`
    string? sha?;
    # The CI/CD configuration content is taken from this commit SHA, branch or tag. Defaults to the HEAD of the project's default branch. Mutually exclusive with `sha`
    @http:Query {name: "content_ref"}
    string? contentRef?;
};

# Represents the Queries record for the operation: listProjectPipelines
public type ListProjectPipelinesQueries record {
    # Return pipelines updated before the specified datetime. Format: ISO 8601 YYYY-MM-DDTHH:MM:SSZ
    @http:Query {name: "updated_before"}
    string? updatedBefore?;
    # Number of items per page
    @http:Query {name: "per_page"}
    int perPage = 20;
    # Return pipelines created after the specified datetime. Format: ISO 8601 YYYY-MM-DDTHH:MM:SSZ
    @http:Query {name: "created_after"}
    string? createdAfter?;
    # Sort pipelines
    "asc"|"desc" sort = "desc";
    # The source of pipelines
    "unknown"|"push"|"web"|"trigger"|"schedule"|"api"|"external"|"pipeline"|"chat"|"webide"|"merge_request_event"|"external_pull_request_event"|"parent_pipeline"|"ondemand_dast_scan"|"ondemand_dast_validation"|"security_orchestration_policy"|"container_registry_push"|"duo_workflow"|"pipeline_execution_policy_schedule"|"dependency_management_security_update"? 'source?;
    # The sha of pipelines
    string? sha?;
    # Returns pipelines with invalid configurations
    @http:Query {name: "yaml_errors"}
    boolean? yamlErrors?;
    # The ref of pipelines
    string? ref?;
    # Return pipelines created before the specified datetime. Format: ISO 8601 YYYY-MM-DDTHH:MM:SSZ
    @http:Query {name: "created_before"}
    string? createdBefore?;
    # The scope of pipelines
    "running"|"pending"|"finished"|"branches"|"tags"? scope?;
    # Return pipelines updated after the specified datetime. Format: ISO 8601 YYYY-MM-DDTHH:MM:SSZ
    @http:Query {name: "updated_after"}
    string? updatedAfter?;
    # Filter pipelines by name
    string? name?;
    # Order pipelines
    @http:Query {name: "order_by"}
    "id"|"status"|"ref"|"updated_at"|"user_id" orderBy = "id";
    # Current page number
    int page = 1;
    # The status of pipelines
    "created"|"waiting_for_resource"|"preparing"|"waiting_for_callback"|"pending"|"running"|"success"|"failed"|"canceling"|"canceled"|"skipped"|"manual"|"scheduled"? status?;
    # The username of the user who triggered pipelines
    string? username?;
};

