    # Only mirror branches with names that match this regex. Mutually exclusive with `only_mirror_protected_branches`
    @jsondata:Name {value: "mirror_branch_regex"}
    string? mirrorBranchRegex?;
};

# Represents the Queries record for the operation: listEpics
public type ListEpicsQueries record {
    # Return epics updated before the specified time
    @http:Query {name: "updated_before"}
    string? updatedBefore?;
    # Number of items per page
    @http:Query {name: "per_page"}
    int perPage = 20;
    # Return epics created after the specified time
    @http:Query {name: "created_after"}
    string? createdAfter?;
    # Include epics from descendant groups
    @http:Query {name: "include_descendant_groups"}
    boolean includeDescendantGroups = true;
    # Return epics sorted in `asc` or `desc` order
    "asc"|"desc" sort = "desc";
    # Return epics reacted by the authenticated user by the given emoji
    @http:Query {name: "my_reaction_emoji"}
    string? myReactionEmoji?;
    # Comma-separated list of label names
    string[]? labels?;
    # Return epics which are not authored by the given username. Mutually exclusive with `not[author_id]`
    @http:Query {name: "not[author_username]"}
    string? notAuthorUsername?;
    # Search epics for text present in the title or description
    string? search?;
    # Object that contains filters
    record {}? not?;
    # Comma-separated list of label names
    @http:Query {name: "not[labels]"}
    string[]? notLabels?;
    # Return epics created before the specified time
    @http:Query {name: "created_before"}
    string? createdBefore?;
    # Return epics updated after the specified time
    @http:Query {name: "updated_after"}
    string? updatedAfter?;
    # Include epics from ancestor groups
    @http:Query {name: "include_ancestor_groups"}
    boolean includeAncestorGroups = false;
    # Return epics ordered by `created_at`, `updated_at` or `title` fields
    @http:Query {name: "order_by"}
    "created_at"|"updated_at"|"title" orderBy = "created_at";
    # Return epics which are not authored by the user with the given ID. Mutually exclusive with `not[author_username]`
    @http:Query {name: "not[author_id]"}
    int? notAuthorId?;
    # Return opened, closed, or all epics
    "opened"|"closed"|"all" state = "all";
    # Current page number
    int page = 1;
    # Return epics which are authored by the user with the given ID. Mutually exclusive with `author_username`
    @http:Query {name: "author_id"}
    int? authorId?;
    # Return epics which are authored by the given username. Mutually exclusive with `author_id`
    @http:Query {name: "author_username"}
    string? authorUsername?;
    # Return titles of labels and other details
    @http:Query {name: "with_labels_details"}
    boolean withLabelsDetails = false;
    # Return epics with given confidentiality
    boolean? confidential?;
};

