# Request payload for the for user
public type CreateProjectForUserRequest record {
    # Enable GitLab Duo Secret Detection false positive detection for this project
    @jsondata:Name {value: "duo_secret_detection_fp_enabled"}
    boolean? duoSecretDetectionFpEnabled?;
    # Only allow to merge if all threads are resolved
    @jsondata:Name {value: "only_allow_merge_if_all_discussions_are_resolved"}
    boolean? onlyAllowMergeIfAllDiscussionsAreResolved?;
    # The process mode of the resource group
    @jsondata:Name {value: "resource_group_default_process_mode"}
    "unordered"|"oldest_first"|"newest_first"|"newest_ready_first"? resourceGroupDefaultProcessMode?;
    # Allow users to request member access
    @jsondata:Name {value: "request_access_enabled"}
    boolean? requestAccessEnabled?;
    # Enforce auth check on uploads
    @jsondata:Name {value: "enforce_auth_checks_on_uploads"}
    boolean? enforceAuthChecksOnUploads?;
    # Security and compliance access level. One of `disabled`, `private` or `enabled`
    @jsondata:Name {value: "security_and_compliance_access_level"}
    "disabled"|"private"|"enabled"? securityAndComplianceAccessLevel?;
    # Build timeout
    @jsondata:Name {value: "build_timeout"}
    int? buildTimeout?;
    # The description for the regex the Merge Request must adhere to
    @jsondata:Name {value: "merge_request_title_regex_description"}
    string? mergeRequestTitleRegexDescription?;
    # Infrastructure access level. One of `disabled`, `private` or `enabled`
    @jsondata:Name {value: "infrastructure_access_level"}
    "disabled"|"private"|"enabled"? infrastructureAccessLevel?;
    # Project ID of template from which to create project. Mutually exclusive with `import_url`, `template_name`
    @jsondata:Name {value: "template_project_id"}
    int? templateProjectId?;
    # The path of the repository
    string? path?;
    # [Deprecated] Pull mirroring triggers builds
    @jsondata:Name {value: "mirror_trigger_builds"}
    boolean? mirrorTriggerBuilds?;
    # Monitor access level. One of `disabled`, `private` or `enabled`
    @jsondata:Name {value: "monitor_access_level"}
    "disabled"|"private"|"enabled"? monitorAccessLevel?;
    # Repository access level. One of `disabled`, `private` or `enabled`
    @jsondata:Name {value: "repository_access_level"}
    "disabled"|"private"|"enabled"? repositoryAccessLevel?;
    # Wiki access level. One of `disabled`, `private` or `enabled`
    @jsondata:Name {value: "wiki_access_level"}
    "disabled"|"private"|"enabled"? wikiAccessLevel?;
    # Enable email notifications
    @jsondata:Name {value: "emails_enabled"}
    boolean? emailsEnabled?;
    # Flag indication if shared runners are enabled for that project
    @jsondata:Name {value: "shared_runners_enabled"}
    boolean? sharedRunnersEnabled?;
    # Feature flags access level. One of `disabled`, `private` or `enabled`
    @jsondata:Name {value: "feature_flags_access_level"}
    "disabled"|"private"|"enabled"? featureFlagsAccessLevel?;
    # Merge requests access level. One of `disabled`, `private` or `enabled`
    @jsondata:Name {value: "merge_requests_access_level"}
    "disabled"|"private"|"enabled"? mergeRequestsAccessLevel?;
    # Flag indication if group runners are enabled for that project
    @jsondata:Name {value: "group_runners_enabled"}
    boolean? groupRunnersEnabled?;
    # Allow to merge if pipeline is skipped
    @jsondata:Name {value: "allow_merge_on_skipped_pipeline"}
    boolean? allowMergeOnSkippedPipeline?;
    # Flag indication if Git LFS is enabled for that project
    @jsondata:Name {value: "lfs_enabled"}
    boolean? lfsEnabled?;
    # Enable GitLab Duo SAST vulnerability resolution workflow for this project
    @jsondata:Name {value: "duo_sast_vr_workflow_enabled"}
    boolean? duoSastVrWorkflowEnabled?;
    # The visibility of the project
    "private"|"internal"|"public"? visibility?;
    # Deprecated: Use public_jobs instead
    @jsondata:Name {value: "public_builds"}
    boolean? publicBuilds?;
    # Show default award emojis
    @jsondata:Name {value: "show_default_award_emojis"}
    boolean? showDefaultAwardEmojis?;
    # Requirements feature access level. One of `disabled`, `private` or `enabled`
    @jsondata:Name {value: "requirements_access_level"}
    "disabled"|"private"|"enabled"? requirementsAccessLevel?;
    # Builds access level. One of `disabled`, `private` or `enabled`
    @jsondata:Name {value: "builds_access_level"}
    "disabled"|"private"|"enabled"? buildsAccessLevel?;
    # Automatically resolve merge request diff threads on lines changed with a push
    @jsondata:Name {value: "resolve_outdated_diff_discussions"}
    boolean? resolveOutdatedDiffDiscussions?;
    # Flag indication if merge requests are enabled
    @jsondata:Name {value: "merge_requests_enabled"}
    boolean? mergeRequestsEnabled?;
    # Forks access level. One of `disabled`, `private` or `enabled`
    @jsondata:Name {value: "forking_access_level"}
    "disabled"|"private"|"enabled"? forkingAccessLevel?;
    # Include the code diff preview in merge request notification emails
    @jsondata:Name {value: "show_diff_preview_in_email"}
    boolean? showDiffPreviewInEmail?;
    # Controls visibility of the package registry. One of `disabled`, `private`, `enabled` or `public`. `private` will make the package registry accessible only to project members (reporter role and above). `enabled` will make the package registry accessible to everyone who has access to the project. `public` will make the package registry accessible to everyone. `disabled` will disable the package registry
    @jsondata:Name {value: "package_registry_access_level"}
    "disabled"|"private"|"enabled"|"public"? packageRegistryAccessLevel?;
    # Enable GitLab Duo SAST false positive detection for this project
    @jsondata:Name {value: "duo_sast_fp_detection_enabled"}
    boolean? duoSastFpDetectionEnabled?;
    # Template used to create merge commit message
    @jsondata:Name {value: "merge_commit_template"}
    string? mergeCommitTemplate?;
    # The commit message used to apply merge request suggestions
    @jsondata:Name {value: "suggestion_commit_message"}
    string? suggestionCommitMessage?;
    # Merge requests of this forked project targets itself by default
    @jsondata:Name {value: "mr_default_target_self"}
    boolean? mrDefaultTargetSelf?;
    # Pages access level. One of `disabled`, `private`, `enabled` or `public`
    @jsondata:Name {value: "pages_access_level"}
    "disabled"|"private"|"enabled"|"public"? pagesAccessLevel?;
    # Controls visibility of the container registry. One of `disabled`, `private` or `enabled`. `private` will make the container registry accessible only to project members (reporter role and above). `enabled` will make the container registry accessible to everyone who has access to the project. `disabled` will disable the container registry
    @jsondata:Name {value: "container_registry_access_level"}
    "disabled"|"private"|"enabled"? containerRegistryAccessLevel?;
    # Flag indication if Auto DevOps is enabled
    @jsondata:Name {value: "auto_devops_enabled"}
    boolean? autoDevopsEnabled?;
    # Enable GitLab Duo remote flows for this project
    @jsondata:Name {value: "duo_remote_flows_enabled"}
    boolean? duoRemoteFlowsEnabled?;
    # Namespace ID for the new project. Default to the user namespace
    @jsondata:Name {value: "namespace_id"}
    int? namespaceId?;
    # Disable or enable the service desk
    @jsondata:Name {value: "service_desk_enabled"}
    boolean? serviceDeskEnabled?;
    # The name of the project
    string? name;
    # The classification label for the project
    @jsondata:Name {value: "external_authorization_classification_label"}
    string? externalAuthorizationClassificationLabel?;
    # The default branch of the project
    @jsondata:Name {value: "default_branch"}
    string? defaultBranch?;
    # Auto Deploy strategy
    @jsondata:Name {value: "auto_devops_deploy_strategy"}
