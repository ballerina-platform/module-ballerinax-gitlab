# Request payload for the project
public type UpdateProjectRequest record {
    # Only allow to merge if all threads are resolved
    @jsondata:Name {value: "only_allow_merge_if_all_discussions_are_resolved"}
    boolean? onlyAllowMergeIfAllDiscussionsAreResolved?;
    # The process mode of the resource group
    @jsondata:Name {value: "resource_group_default_process_mode"}
    "unordered"|"oldest_first"|"newest_first"|"newest_ready_first"? resourceGroupDefaultProcessMode?;
    # Enforce auth check on uploads
    @jsondata:Name {value: "enforce_auth_checks_on_uploads"}
    boolean? enforceAuthChecksOnUploads?;
    # Security and compliance access level. One of `disabled`, `private` or `enabled`
    @jsondata:Name {value: "security_and_compliance_access_level"}
    "disabled"|"private"|"enabled"? securityAndComplianceAccessLevel?;
    # The description for the regex the Merge Request must adhere to
    @jsondata:Name {value: "merge_request_title_regex_description"}
    string? mergeRequestTitleRegexDescription?;
    # The path of the repository
    string? path?;
    # Monitor access level. One of `disabled`, `private` or `enabled`
    @jsondata:Name {value: "monitor_access_level"}
    "disabled"|"private"|"enabled"? monitorAccessLevel?;
    # Enable merged results pipelines
    @jsondata:Name {value: "merge_pipelines_enabled"}
    boolean? mergePipelinesEnabled?;
    # Repository access level. One of `disabled`, `private` or `enabled`
    @jsondata:Name {value: "repository_access_level"}
    "disabled"|"private"|"enabled"? repositoryAccessLevel?;
    # Wiki access level. One of `disabled`, `private` or `enabled`
    @jsondata:Name {value: "wiki_access_level"}
    "disabled"|"private"|"enabled"? wikiAccessLevel?;
    # Flag indication if shared runners are enabled for that project
    @jsondata:Name {value: "shared_runners_enabled"}
    boolean? sharedRunnersEnabled?;
    # Require all security policy pipelines to succeed before merge requests can be merged
    @jsondata:Name {value: "security_policy_pipeline_must_succeed"}
    boolean? securityPolicyPipelineMustSucceed?;
    # Allow pushing to this project's repository by authenticating with a CI/CD job token generated in this project
    @jsondata:Name {value: "ci_push_repository_for_job_token_allowed"}
    boolean? ciPushRepositoryForJobTokenAllowed?;
    # Feature flags access level. One of `disabled`, `private` or `enabled`
    @jsondata:Name {value: "feature_flags_access_level"}
    "disabled"|"private"|"enabled"? featureFlagsAccessLevel?;
    # Merge requests access level. One of `disabled`, `private` or `enabled`
    @jsondata:Name {value: "merge_requests_access_level"}
    "disabled"|"private"|"enabled"? mergeRequestsAccessLevel?;
    # Enable merge trains
    @jsondata:Name {value: "merge_trains_enabled"}
    boolean? mergeTrainsEnabled?;
    # Flag indication if group runners are enabled for that project
    @jsondata:Name {value: "group_runners_enabled"}
    boolean? groupRunnersEnabled?;
    # Allow to merge if pipeline is skipped
    @jsondata:Name {value: "allow_merge_on_skipped_pipeline"}
    boolean? allowMergeOnSkippedPipeline?;
    # Flag indication if Git LFS is enabled for that project
    @jsondata:Name {value: "lfs_enabled"}
    boolean? lfsEnabled?;
    # Overall approvals required when no rule is present
    @jsondata:Name {value: "fallback_approvals_required"}
    int? fallbackApprovalsRequired?;
    # Deprecated: Use public_jobs instead
    @jsondata:Name {value: "public_builds"}
    boolean? publicBuilds?;
    # Enable or disable separated caches based on branch protection
    @jsondata:Name {value: "ci_separated_caches"}
    boolean? ciSeparatedCaches?;
    # Builds access level. One of `disabled`, `private` or `enabled`
    @jsondata:Name {value: "builds_access_level"}
    "disabled"|"private"|"enabled"? buildsAccessLevel?;
    # Automatically resolve merge request diff threads on lines changed with a push
    @jsondata:Name {value: "resolve_outdated_diff_discussions"}
    boolean? resolveOutdatedDiffDiscussions?;
    # Include the code diff preview in merge request notification emails
    @jsondata:Name {value: "show_diff_preview_in_email"}
    boolean? showDiffPreviewInEmail?;
    # Controls visibility of the package registry. One of `disabled`, `private`, `enabled` or `public`. `private` will make the package registry accessible only to project members (reporter role and above). `enabled` will make the package registry accessible to everyone who has access to the project. `public` will make the package registry accessible to everyone. `disabled` will disable the package registry
    @jsondata:Name {value: "package_registry_access_level"}
    "disabled"|"private"|"enabled"|"public"? packageRegistryAccessLevel?;
    # Enable GitLab Duo SAST false positive detection for this project
    @jsondata:Name {value: "duo_sast_fp_detection_enabled"}
    boolean? duoSastFpDetectionEnabled?;
