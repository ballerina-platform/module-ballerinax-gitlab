    string? search?;
    # Name of tag to start the pagination from
    @http:Query {name: "page_token"}
    string? pageToken?;
    # Return tags ordered by `name`, `updated`, `version` fields
    @http:Query {name: "order_by"}
    "name"|"updated"|"version" orderBy = "updated";
    # Return tags sorted in updated by `asc` or `desc` order
    "asc"|"desc" sort = "desc";
    # Current page number
    int page = 1;
};

