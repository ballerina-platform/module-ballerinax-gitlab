# Request payload for push rules
public type GroupPushRulesRequest record {
    # All commit author emails must match this
    @jsondata:Name {value: "author_email_regex"}
    string? authorEmailRegex?;
    # GitLab will reject any files that are likely to contain secrets
    @jsondata:Name {value: "prevent_secrets"}
    boolean? preventSecrets?;
    # Restrict commits by author (email) to existing GitLab users
    @jsondata:Name {value: "member_check"}
    boolean? memberCheck?;
    # Maximum file size (MB)
    @jsondata:Name {value: "max_file_size"}
    int? maxFileSize?;
    # Deny deleting a tag
    @jsondata:Name {value: "deny_delete_tag"}
    boolean? denyDeleteTag?;
    # No commit message is allowed to match this
    @jsondata:Name {value: "commit_message_negative_regex"}
    string? commitMessageNegativeRegex?;
    # Reject commit when it’s not DCO certified
    @jsondata:Name {value: "reject_non_dco_commits"}
    boolean? rejectNonDcoCommits?;
    # All branches names must match this
    @jsondata:Name {value: "branch_name_regex"}
    string? branchNameRegex?;
    # All committed filenames must not match this
    @jsondata:Name {value: "file_name_regex"}
    string? fileNameRegex?;
    # Users can only push commits to this repository if the commit author name is consistent with their GitLab account name
    @jsondata:Name {value: "commit_committer_name_check"}
    boolean? commitCommitterNameCheck?;
    # Users can only push commits to this repository if the committer email is one of their own verified emails
    @jsondata:Name {value: "commit_committer_check"}
    boolean? commitCommitterCheck?;
    # Reject commit when it’s not signed
    @jsondata:Name {value: "reject_unsigned_commits"}
    boolean? rejectUnsignedCommits?;
    # All commit messages must match this
    @jsondata:Name {value: "commit_message_regex"}
    string? commitMessageRegex?;
};

