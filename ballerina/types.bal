    "specific"|"shared"|"instance_type"|"group_type"|"project_type"|"active"|"paused"|"online"|"offline"|"never_contacted"|"stale"? scope?;
    # Current page number
    int page = 1;
    # The type of runners to return
    "instance_type"|"group_type"|"project_type"? 'type?;
    # The version prefix of runners to return
    @http:Query {name: "version_prefix"}
    string? versionPrefix?;
    # The status of runners to return
    "active"|"paused"|"online"|"offline"|"never_contacted"|"stale"? status?;
};

