    boolean? dismissable?;
    # The theme for the message
    "indigo"|"light-indigo"|"blue"|"light-blue"|"green"|"light-green"|"red"|"light-red"|"dark"|"light"? theme?;
    # Ending time
    @jsondata:Name {value: "ends_at"}
    string? endsAt?;
    # Message to display
    string? message?;
    # Target path
    @jsondata:Name {value: "target_path"}
    string? targetPath?;
    # Foreground color (Deprecated. Use "theme" instead.)
    string? font?;
    # Target user roles
    @jsondata:Name {value: "target_access_levels"}
    (10|15|20|30|40|50)[]? targetAccessLevels?;
    # Broadcast Type
    @jsondata:Name {value: "broadcast_type"}
    "banner"|"notification"? broadcastType?;
};

# Request payload for the issue
public type MoveIssueRequest record {
    # The ID of the new project
    @jsondata:Name {value: "to_project_id"}
    int? toProjectId;
};

# Request payload for the git hub project import
public type CancelGitHubProjectImportRequest record {
    # ID of importing project to be canceled
    @jsondata:Name {value: "project_id"}
    int? projectId;
};

# Request payload for the runner auth token by token
public type ResetRunnerAuthTokenByTokenRequest record {
    # The current authentication token of the runner
    string? token;
};

# Request payload for the Geo node
public type CreateGeoNodeRequest record {
    # Control the maximum concurrency of repository verification for this node
    @jsondata:Name {value: "verification_max_capacity"}
    int verificationMaxCapacity = 10;
    # Limit syncing to only specific groups, or shards. Valid values: `"namespaces"`, `"shards"`, or `null`
    @jsondata:Name {value: "selective_sync_type"}
    string? selectiveSyncType?;
    # The interval (in days) in which the repository verification is valid. Once expired, it will be reverified. This has no effect when set on a secondary node
    @jsondata:Name {value: "minimum_reverification_interval"}
    int? minimumReverificationInterval?;
    # Control the maximum concurrency of LFS/attachment backfill for this secondary node
    @jsondata:Name {value: "files_max_capacity"}
    int filesMaxCapacity = 10;
    # The IDs of organizations that should be synced, if `selective_sync_type` == `organizations`
    @jsondata:Name {value: "selective_sync_organization_ids"}
    int[]? selectiveSyncOrganizationIds?;
    # Flag indicating if the secondary Geo node will replicate blobs in Object Storage
    @jsondata:Name {value: "sync_object_storage"}
    boolean syncObjectStorage = false;
    # The URL defined on the primary node that secondary nodes should use to contact it. Returns `url` if not set
    @jsondata:Name {value: "internal_url"}
    string? internalUrl?;
    # Specifying whether this node will be enabled
    boolean enabled = true;
    # The user-facing URL for the Geo node
    string? url;
    # Control the maximum concurrency of repository backfill for this secondary node
    @jsondata:Name {value: "repos_max_capacity"}
    int reposMaxCapacity = 10;
    # The minimum time (in minutes) between self-heal re-verification triggers for the same resource. Both the primary and each secondary use their own value: secondaries use it to throttle re-reporting the same resource, and the primary uses it to throttle re-verifying an already-verified resource
    @jsondata:Name {value: "checksum_mismatch_self_heal_cooldown_minutes"}
    int? checksumMismatchSelfHealCooldownMinutes?;
    # The repository storages whose projects should be synced, if `selective_sync_type` == `shards`
    @jsondata:Name {value: "selective_sync_shards"}
    string[]? selectiveSyncShards?;
    # The number of consecutive checksum mismatches on a secondary before it reports the resource to the primary for self-heal re-verification. Read from the secondary node; has no effect when set on the primary
    @jsondata:Name {value: "checksum_mismatch_report_threshold"}
    int? checksumMismatchReportThreshold?;
    # The unique identifier for the Geo node. Must match `geo_node_name` if it is set in `gitlab.rb`, otherwise it must match `external_url`
    string? name;
    # The IDs of groups that should be synced, if `selective_sync_type` == `namespaces`
    @jsondata:Name {value: "selective_sync_namespace_ids"}
    int[]? selectiveSyncNamespaceIds?;
    # Specifying whether this node will be primary
    boolean primary = false;
    # Control the maximum concurrency of container repository sync for this node
    @jsondata:Name {value: "container_repositories_max_capacity"}
    int containerRepositoriesMaxCapacity = 2;
};

# Represents the Queries record for the operation: listGroupPendingInvitations
public type ListGroupPendingInvitationsQueries record {
    # Number of items per page
    @http:Query {name: "per_page"}
    int perPage = 20;
    # A query string to search for members
    string? query?;
    # Current page number
    int page = 1;
};

