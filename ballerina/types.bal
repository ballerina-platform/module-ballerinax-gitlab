# Represents the Queries record for the operation: listProjectDeployments
public type ListProjectDeploymentsQueries record {
    # Return deployments updated before the specified date. Expected in ISO 8601 format (`2019-03-15T08:00:00Z`)
    @http:Query {name: "updated_before"}
    string? updatedBefore?;
    # Number of items per page
    @http:Query {name: "per_page"}
    int perPage = 20;
    # The name of the environment to filter deployments by
    string? environment?;
    # Return deployments finished before the specified date. Expected in ISO 8601 format (`2019-03-15T08:00:00Z`)
    @http:Query {name: "finished_before"}
    string? finishedBefore?;
    # Return deployments updated after the specified date. Expected in ISO 8601 format (`2019-03-15T08:00:00Z`)
    @http:Query {name: "updated_after"}
    string? updatedAfter?;
    # Return deployments ordered by either one of `id`, `iid`, `created_at`, `updated_at` or `ref` fields. Default is `id`
    @http:Query {name: "order_by"}
    "id"|"iid"|"created_at"|"updated_at"|"finished_at" orderBy = "id";
    # Current page number
    int page = 1;
    # Return deployments sorted in `asc` or `desc` order. Default is `asc`
    "asc"|"desc" sort = "asc";
    # Return deployments finished after the specified date. Expected in ISO 8601 format (`2019-03-15T08:00:00Z`)
    @http:Query {name: "finished_after"}
    string? finishedAfter?;
    # The status to filter deployments by. One of `created`, `running`, `success`, `failed`, `canceled`, or `blocked`
    "created"|"running"|"success"|"failed"|"canceled"|"skipped"|"blocked"? status?;
};

# Represents report Geo verification failures failures
public type ReportGeoVerificationFailuresFailures record {
    # The model record ID
    @jsondata:Name {value: "replicable_id"}
    int? replicableId;
    # The number of consecutive verification failures
