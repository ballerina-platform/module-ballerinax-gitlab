    # Name of the plan to update
    @jsondata:Name {value: "plan_name"}
    "default"|"free"|"bronze"|"silver"|"premium"|"gold"|"ultimate"|"ultimate_trial"|"ultimate_trial_paid_customer"|"premium_trial"|"opensource" planName;
    # Maximum number of outbound Service Desk emails per hour, per top-level namespace. 0 for unlimited
